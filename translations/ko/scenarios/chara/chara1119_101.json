adbd2adf89ad929cf04db9063f2c536467151b56dc8c77e1bec0","t":"그, 그래……? 바위만큼 단단하진 않을 텐데."},"112:1":{"lh":"706bb861","m":0,"g":"e4d2aa5fe1ca7ae525127951ae3a6a1f415f3a56e09d42ff23f7edf9d9e140e3","t":"그런데 이 바보 조수야, 너 엄청나게 단련했구나? 설마…… 므후후, 리리안을 힘으로 덮치려고 그러는 게냐? 너한테 소꿉친구가 있었지 않나."},"114:0":{"lh":"a8bf8b27","m":0,"g":"58cb20718be4608d3270cfc68a992332a6a99f325ac600bd39a90da9c45aa532","t":"바……! 아, 아니라니까! 그냥 코하루들에게 마냥 기대지 않으려고 조금 단련하는 것뿐이고……"},"116:0":{"lh":"2adfa0d3","m":0,"g":"d14a5e0276e7317cb9d9c2c34c0d6611f02254887c1a3f61ae7ef4615e934eb0","t":"또 무거운 장비 같은 걸 나르다 보니 자연스럽게…… 절대 여자애한테 뭘 어쩌려는 게 아니라고!"},"118:1":{"lh":"140c74bb","m":0,"g":"d63954b3c719605a3b8bc0330b604f36d35e43d3512f22628e06028273a3d9da","t":"그, 그런가. 뭐, 네가 남을 덮칠 것 같지도 않고 말이지. 그런데 정말 단단하군……"},"120:0":{"lh":"ca873a47","m":0,"g":"83ae67935379944ca1d5a4899efa3a6add5245ce28892d5c1b9a1d31708c9e12","t":"어, 어이, 그렇게 만지지 마. 간지럽다니까."},"122:1":{"lh":"2746b63c","m":0,"g":"7bd313ff5398ccf762cc1ab946b7403a3c87a3fd31bdcde87d029513d1c7e5f0","t":"지금 힘 안 주고 있는 거지? 한번 힘줘 봐라."},"124:0":{"lh":"683b638b","m":0,"g":"fffc15963564e3474e94c9ae4fc0348a13544b5af99b6c0f9f56f58a9e917686","t":"아아, 뭐 상관없는데…… 흐읍……!"},"126:1":{"lh":"633250dc","m":0,"g":"60efd7ccbb26c07fc1097e9093e8c37e7793d4b501814b1c0f120693fd170328","t":"오오오오—! 단단해! 이, 이건 대단하군……!"},"128:0":{"lh":"696730c7","m":0,"g":"e89e3edb97aa934cc255f41000085ac240eecc3aa53b45078cf9183b4d763d16","t":"그, 그래? 아직 그렇게 힘준 것도 아닌데…… 온 힘을 주면…… 으으읏!"},"130:1":{"lh":"3e93b8eb","m":0,"g":"438263f8c9ffecc34b440e7b3b3776ba0f439446edff871af6107d1088af5cfb","t":"으앗!? 어, 어쩜 이렇게 단단하지……! 대단해, 대단하구나, 너……!"},"132:0":{"lh":"82d50ce1","m":0,"g":"456c05020df96494625b5e9b75398a4a7119dad9f79fc70ac5681327523cb9a8","t":"그렇게 말해주니 기분은 나쁘지 않네…… 야한 목적인 줄 알았다니 억울하긴 했지만."},"134:1":{"lh":"e55c2083","m":0,"g":"d3e0e0b04f7b2557b53d35fd8db5f3ae687eb5f0b02e152f0d3f11385efa1282","t":"사람이 단련하면 이렇게 되는 거구나…… 이 몸도 단련해 볼까? 너와 비교하면 이 몸은 너무 가늘잖아? 완전 종잇장이다."},"136:0":{"lh":"fb4766bd","m":0,"g":"ecd6c6cfc91a0fc1657b65d4e4f0d57bd6f434e10eba3