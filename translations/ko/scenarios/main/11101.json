{"script":"11101","fragments":{"13:1":{"lh":"81eeb1ba","m":0,"g":"b402ff61260dd18d6070c2a0b5e2d8d16e858af4fd35eb2d817d9cbe037c573a","t":"……착륙을 마쳤습니다."},"15:0":{"lh":"b7ee035","m":0,"g":"11b3861baeee2945ce2ab7e00dae40a9ec1d06d89ee33db3723a73a56a314fe5","t":"도착한 건가……"},"27:0":{"lh":"140e8e7a","m":0,"g":"ea99ce19e37082b5f5d8d44c4b36d1f704723c41f8355e59725524f0e5057619","t":"루미나, 괜찮아?"},"29:1":{"lh":"724eb25c","m":0,"g":"b45867e0ae2974c7f904722d222cd06c22f0ae8331ea2c548c34e288d37c5698","t":"응……"},"31:0":{"lh":"c9e0b0e8","m":0,"g":"a214da910da70d78f021ba8abde8014e6c38f410e89fa9060ee4e5bc59c714f2","t":"루미나가 여왕이 되기 위한 대관식이 예정되어 있다는 걸 알게 된 지 며칠."},"33:0":{"lh":"292ba5c4","m":0,"g":"66b7fcee5006f2b846eced038bf65288b385c60afe5572a83a5491c63ce26702","t":"그 후 대관식에 관해 연락을 보냈지만, 상대는 얼버무릴 뿐이라 새로운 정보는 얻지 못한 모양이다."},"35:0":{"lh":"908fe5b9","m":0,"g":"a26c61803eea9d776dbb53dca0174a07a97507382b5c08957e65f52d6acccdfe","t":"이미 차기 여왕은 루미나라고 공식 발표된 모양이지만……"},"37:0":{"lh":"be71dd49","m":0,"g":"94e3a40a875a3e4a043abb965e925041d6b0f8626de4896c3d58c7f3c8e2c119","t":"고사하겠다고 했었지……"},"39:1":{"lh":"bb92c9bb","m":0,"g":"6084e68b7447e75f66063fdf6883f43520d8500cfd28b89e6b5530f7fa4529a6","t":"응…… 어머님이 무슨 생각을 하시는지는 모르겠지만…… 나는 여왕이 되기에는 아직 충분한 지지도 얻지 못했고, 힘도 갖추지 못했어. 게다가……"},"41:1":{"lh":"ec7a09bc","m":0,"g":"b8cd5334d1aab3a72ad2c82bb1bf8bd3c69154bfd95ac472d9217e8c59a5598e","t":"그레아 언니에 관한 일도…… 여러 가지를 해결해야 해…… 그러려면 우선, 어머님과 이야기하고 협상해 볼 거야. 고사하는 건 그 수단 중 하나……려나."},"49:1":{"lh":"a3064ace","m":0,"g":"affd278fe8f584d206b50613d417f462f861040534a85e9d6f6adc6e9aa83093","t":"무리하지는 마……?"},"51:1":{"lh":"a7fa2359","m":0,"g":"4bbce8c4217dc58094cb092c5acf907366216bc0667c4a318ada240abb000c54","t":"무슨 일이 있으면 저를 불러 주십시오. 살생하지 않겠다고 맹세했습니다만, 그 외에는 무엇이든 하겠습니다."},"53:1":{"lh":"1222b76d","m":0,"g":"6f6b56d56a4fc895b8faa0d289132d4bf8201ff3c9d0e992b3285ef48f892d23","t":"응, 고마워…… 시즈쿠도 그렇게까지 하지 않아도 되지만, 고마워……"},"55:1":{"lh":"13c929ec","m":0,"g":"1d299f63dfa72df0a61820e6a5295f88355f1d93ecb5bb78ee59a5c3f4a861e4","t":"그럼 슬슬 가시죠, 루미나 님."},"57:1":{"lh":"48e016ab","m":1,"g":"f21a4a5d1a8dec662e7116c16c947cb71dca7c4a024695cfa545fa71e48c9227","t":"응…… {PLAYER_NAME} 군과 코하루는 여기서 기다려 줘. 나중에 부를 것 같으니까……"},"59:0":{"lh":"bb1c48b1","m":0,"g":"432b3e332ae031bbbe9956ff8a153e5be5b2510d08715cc507883cb8cfc1f954","t":"어? 같이 안 가는 거야? 이것저것, 예절 연습도 했는데……"},"61:1":{"lh":"2d769a27","m":0,"g":"5d5c75c988134412ec52394e23cc20a6628a3a05482eb004535cefd045a134eb","t":"그건 혹시 같은 곳을 걸을 기회가 생길 때를 대비한 훈련입니다. 당신들은 법률상 저희의 소유물이니, 나중에 오십시오."},"63:1":{"lh":"8bfb56bc","m":0,"g":"4f291110fa75aa22fb4de968810b7d86eab78d2a3b265c8e4282ad501cdbfb59","t":"소유물이라니……"},"74:0":{"lh":"2d66d222","m":0,"g":"f5052a3f1c5c499a385924a58650a6a3c5478611ec434029aea3892967d49167","t":"시즈쿠가 문을 열고 루미나가 밖으로 나갔다. 그 순간, 바깥에서 강렬한 빛이 쏟아져 들어왔다."},"96:0":{"lh":"c88dd5f1","m":0,"g":"571f64e54fef1ce0729abea387ca86c382592b4902ec312d77a06c7fe3fa3f28","t":"지금 막 루미나 님께서 우주선에서 내리셔서 귀환하셨습니다!"},"103:0":{"lh":"334c9676","m":0,"g":"03bd49797509a00514bc7409398fca32a3d0a19d27985fa930fcfbce69a5aa07","t":"몸이 약해 건강 상태 등이 우려됐습니다만, 발걸음은 힘차고 안정적입니다. 이쪽을 향해 미소를 지으며 손을 흔들어, 걱정할 필요가 없음을 보여 주고 계십니다."},"110:0":{"lh":"9d2a4656","m":0,"g":"974a40a184c1a0e722e0ceabfddf424608b12c8bc55584fa1587efa09a8563be","t":"먼 별의 시찰을 마치고 지금, 루미나 님께서 귀환하셨습니다! 워프 장치의 오작동이라는 설도 있었지만, 이를 부정하는 정황이 많아……"},"122:1":{"lh":"965de0bf","m":0,"g":"dc0ac962cf1ec64e1ff82f2e3a57a233055768247c23611fc3a10ff2e14e9dd7","t":"굉장한 광경이네…… 저 사람들 아마 정보상들이지?"},"124:0":{"lh":"f269350","m":0,"g":"bd3800f1b69ab602fb2bfb98a10c793b94320906901419acb6d3c580d4490a11","t":"아마도……"},"126:0":{"lh":"8dcd1160","m":0,"g":"973cd3bcb0087ca612d0cb4056a559a5b485c7ad22eef752b671e3e5a3f64b8c","t":"지금까지는 왕녀라 해도 말 붙이기 편하고 거리감도 없다고 생각했다. 하지만 눈앞에서 여실히 확인하게 된 이 광경은……"},"128:0":{"lh":"12722f1f","m":0,"g":"a261ddaaf911eff1a7950f0d04f1d25e85158271ea91be9c877808c51270ae14","t":"（사는 세계가, 이렇게나 다르다니……）"},"141:0":{"lh":"c2b08159","m":0,"g":"e9885283ed1ec6513bd1461efc2d83a6dd5fd351df5518d6318933b2dbd89391","t":"그로부터 얼마 후. 갑자기 문이 열리더니, 시즈쿠와 어딘가 비슷한 옷차림을 한 리리안이 우주선으로 들어오자마자 다소 무례하게 물었다."},"143:0":{"lh":"d08c8803","m":1,"g":"191a24598ca8f77428cbf43cacbc7736e7abc804ca53981cded94d54313fee7d","t":"……코하루와 {PLAYER_NAME}이라는 자들은?"},"145:0":{"lh":"b5674cab","m":0,"g":"517b851a939659b3cd4e9300fd8c8e1b4be3dd5831378bdac12fc0cb83f09a7b","t":"저…… 저희입니다."},"147:0":{"lh":"b999c13","m":0,"g":"b163672aa7f46e382ed84b2751d2c01524736285f7d312e3a849e3a2b3f79bdf","t":"루미나 님께서 기다리고 계십니다. 이쪽으로."},"149:1":{"lh":"c2c09567","m":0,"g":"fc9e5de9e02162e6684a3a10cf3faa2058705f9125fd878918e7c92a7c52c0b7","t":"앗, 네, 네!"},"151:0":{"lh":"b1c4cf89","m":0,"g":"de2868cc6e9dd8a8ab636b7da769f84c08a0484063b6409c2035caa86dca06c1","t":"아, 하지만 우주선을 잠그지 않아도……"},"157:1":{"lh":"5e76ea06","m":0,"g":"9083678ff3789004592c993b85d1e5d8f342c414d88a42b3ac53cc4b51d18e94","t":"제가 있으면 문제없습니다. 조심히 다녀오십시오."},"159:0":{"lh":"62d8e857","m":0,"g":"e62aac6f73025c210a63443ef3b5c1d7a559977fb92a3cab738ae396035ce696","t":"그, 그런가…… 알았어."},"172:0":{"lh":"6f8a5b4d","m":0,"g":"a76f69a95b840bb4c34c313e3555bf62e92741731ac305fba6fe2a42c37d4894","t":"부르러 온 시종의 뒤를 따라 걸었다. ……하지만 여러 일이 있었던 뒤라 연습한 대로 행동할 수는 없었다."},"175:0":{"lh":"5a927b3b","m":0,"g":"4758792d2920096a473679f28f43b4cd427c5acec416b36803fba7d021d4b3ff","t":"코하루도 같은 심정인 듯, 불안한 기색으로 이따금 주위를 둘러보고 있다."},"177:0":{"lh":"79d583b2","m":0,"g":"7c5614c9979a9a11386d860386fb1f331bba153228e7eab9490b8c5e74cb4b78","t":"（여기가 루미나가 태어난 별…… 역시 굉장한 기술이 발달한 별인가 보네）"},"179:0":{"lh":"3cb37696","m":0,"g":"3845211caa4c926000b9dd5a67a7cfc10b98899fc6aa6a39f9b734a875d30c15","t":"폴라리스 대장님, 루미나 님이 소유한 외계인들을 데려왔습니다."},"185:1":{"lh":"137c00b5","m":0,"g":"f78e4c1fff619c6b5965bf7117f9b4f51aea2bf3e9adace72358265dab53f548","t":"수고했어요! 신병은 이쪽에서 인계받을게요!"},"188:0":{"lh":"9399f930","m":0,"g":"589f2b91c922f39cab921d8577008982f6bdba83cd2fef243161f9c134a148d3","t":"그 말을 듣자, 이곳까지 데려온 시종은 어디론가 걸어갔다."},"190:0":{"lh":"ecdd66a1","m":0,"g":"7a4387050f789dddabe0df09e6ddc5d33b9c9dc8332c5915dd7f33da76aa6973","t":"신병이라니…… 마치 범죄자 취급이잖아."},"192:1":{"lh":"35f8cbe7","m":0,"g":"370e338d25420ba7ca07d5ed8217bad2f72b784510e49b2d6572e91cb56a8136","t":"죄송해요―, 이쪽도 일이니까 어쩔 수 없어서……"},"194:1":{"lh":"db635253","m":0,"g":"85b0c8b789b84e73dd9c6b0ec4b435637ebe694dce440c0e1bd2fc1f1ee76dfe","t":"그래도 먼 길을 오신 걸 환영합니다! 끝과 시작의 별은 누구든 환영해요!"},"196:1":{"lh":"25e9455b","m":0,"g":"288ec517094cf63dd1bc2558b04f650fd69e07d56690f0326a379d56e808c064","t":"대, 대장이라니…… 상당히 높은 분인 거지?"},"198:0":{"lh":"c818f0c0","m":0,"g":"8484b5dd17ef761a27b08f7ed06a01a063f76bbf87713764ee1b6e5427e52c3d","t":"（리리안…… 같아서 참고는 안 되지만. 그렇게 높은 사람처럼 보이진 않는데）"},"200:1":{"lh":"86e157b3","m":0,"g":"8466cfec62b12206a300caf0bc17c5a0fddc01b65fc1e1fa641a3c6cc2b354d0","t":"뭐…… 그렇죠―. 왕성을 섬기는 호위대의 대장, 폴라리스입니다! 잘 부탁드려요."},"202:0":{"lh":"47a34392","m":0,"g":"7518c8792beae622b8d57562d34c763fa2d9d892040766f6dcc30773cc2ba14b","t":"호위대! ……그럼 혹시, 시즈쿠의 상사……?"},"204:1":{"lh":"2dcefb51","m":0,"g":"d7025894a8364a651b54e8747bd7f95b421e62e4a53a00a675604638b4e2944d","t":"아―, 그 부분은 좀 복잡하긴 한데요…… 그런 셈이려나요?"},"206:1":{"lh":"f9b06a27","m":0,"g":"75c931e5a9f17eda8c2b4f83747138b260dffeb5633416c63386429361e760fa","t":"우선 왕성으로 가시죠!"},"214:0":{"lh":"77136130","m":0,"g":"79d48477c1b012a7db87e83079b60719050762bce07a5fbf5cdbca91216d7b2b","t":"코하루와 서로 얼굴을 마주 보며 폴라리스의 뒤를 따라, 유난히 큰 건물로 향했다."},"216:0":{"lh":"9f1af51c","m":0,"g":"5d7f878bd16e29971d81139c690d82be7c604266996f805536d348e36076311c","t":"（빨리 루미나와 시즈쿠를 만나지 않으면, 여러모로 불안하네……）"},"218:1":{"lh":"1006baa4","m":0,"g":"a046b3030a99d89ceef2a3fa748797e7f6af1ea71e0725033bd1c53462e6dfde","t":"（그러게……）"},"229:0":{"lh":"daa02a26","m":0,"g":"7fa8f12fbe699c4a3cc14ffe52ccee25ae5644d12d465111b4d1325ab515feb2","t":"왕……성?"},"231:0":{"lh":"bd9f4174","m":0,"g":"7a2c2c5f133902bfa3ebb727bec49846ff66f69f76298a2df190896a5726d388","t":"상상했던 건…… 돌벽돌을 쌓아 올린 듯한 모습이었는데 실제로는 전혀 달랐고, 지금까지 봐 온 우주선과 거의 똑같은 내부에 나도 모르게 말이 튀어나왔다."},"239:1":{"lh":"4d5809c2","m":0,"g":"ccd3fbca86fa2c6b606342e52146923ce373f0790b5d080cbd201aaece93de28","t":"이 소재로 건물을 지으면 엄청 튼튼하거든요～! 왕성이 우주선을 닮은 게 아니라, 우주선이 왕성을 닮은 거예요! 여기가 먼저였으니까요!"},"243:1":{"lh":"fbe96098","m":0,"g":"0b6765b04af0e15d6e5b728b4da70fd46a925d8aefe0a689828960c4eb1f9c05","t":"그럼 죄송하지만…… 왕성 안에서는 이것을 착용해 주셔야 합니다."},"256:0":{"lh":"6d1bd97e","m":0,"g":"5806557b716b8145628b003918c6557269e584f1c8f4ccb5c06b230b698bc541","t":"뭣……"},"258:0":{"lh":"df6f514c","m":0,"g":"0c3a33b9097935b2a884860af010274d4a82a64c8c10143332961b255b807aa5","t":"폴라리스가 어떤 기계를 조작하자, 우리의 손과 손 사이에 빛나는 사슬 같은 것이 이어졌다."},"260:1":{"lh":"5eca5841","m":0,"g":"b12a9a000cca237bc76e2c2844f5eacfe8eca5d32ab170ab97f5d77a78c14097","t":"왜!? 이러면 진짜 범죄자 같잖아!"},"262:1":{"lh":"8a0d414b","m":0,"g":"b6984839630e5e157590ecb9bd967fb8e69713c2b3994cc61daa6484d319e733","t":"안전을 위해서예요…… 만약을 대비해, 왕성에 들어오는 외부인은 이 수갑을 차도록 정해져 있거든요."},"264:0":{"lh":"4f114cbe","m":0,"g":"e3887ec33a59cb5c7099ad167454e23103bcf06a2eccbd155030b7c1035577d9","t":"화, 확실히 필요할지도 모르지만…… 응?"},"266:1":{"lh":"1be85bbd","m":0,"g":"3ae563d401510c89e64ef36e736fa333ed63c370ef668eb12d0e60ea4630db61","t":"무슨 일인가요?"},"268:0":{"lh":"46172ef2","m":0,"g":"fe4a754541a24bf0cdcfe4d3f6c108637302d75a3224f79a2bc34a2f512e2cd4","t":"어, 아니……"},"270:0":{"lh":"25b2f57f","m":0,"g":"7ea2cb8f6e2ed3a523cd22aa77c4fae6b9b0b6ba589213ffca27f909c7d544c9","t":"그 녀석들은 구속할 필요 없어!"},"276:1":{"lh":"3401f7c","m":0,"g":"ff59358a0d8511e4af1360d012cc95d413cebc33da4aec6113609c22faba9ccd","t":"그림 님……"},"278:0":{"lh":"3d4e716b","m":0,"g":"60013eef63c7e5df613d4ac7672d51880031772c74aeab44abfe1092ff60c9b8","t":"어, 그림!?"},"280:0":{"lh":"2fe3e75","m":0,"g":"773952f22ed92deba9bc175e315e0a0dca5f275f9a3ee72eed5e88308fc8d6e0","t":"왜 여기 있냐고 할 뻔했지만, 그림은 왕녀다. 본래라면 여기에 있는 편이 더 자연스러웠다."},"282:1":{"lh":"1ec3dbb","m":0,"g":"aa28e05bb0b0675c05d65574dd1cae8cf8d49efe167b74d2878a6f1af1ac3743","t":"아직 가승인이긴 하지만, 그 둘은 타 행성 방문권도 갖고 있어."},"284:1":{"lh":"17b18bf4","m":0,"g":"120cd9c5d25eed455ef6959e25dbeca564f84120a17ce4bf99571beac0e03e30","t":"아, 그랬던 거군요."},"286:0":{"lh":"d7670d7e","m":0,"g":"a97a55d46aa6bf762f9b937c6f7269f34dec364311da0be48df6141c9a32447c","t":"（타 행성 방문권……）"},"297:1":{"lh":"bf683209","m":0,"g":"b2ded1de48c5318d41fc1fa22670f7e5aa2d4ba91fb0546d1feb911d4f257f8c","t":"이것저것 진정되고 나면, 오빠한테는 다른 별과도 교류할 수 있는 자격시험 같은 것도 치르게 해야 하니까……"},"310:0":{"lh":"c8f82419","m":0,"g":"dd762cab5b71ab30c1c57950e975fdeae2a014ec14e7afadf31abe4463c036ef","t":"（전에 코즈믹 원더랜드에서 말했던 그건가……? 딱히 시험 같은 건 본 적 없는데…… 혹시 허풍인가）"},"312:1":{"lh":"864bab89","m":0,"g":"80c3221be3a2a6c0a5afc1b1542257b59e50a35679be84871cd4184ed1b7fa79","t":"그림 쨩의 명령이야. 당장 이 두 사람을 풀어 줘."},"314:1":{"lh":"51d7a9b2","m":0,"g":"d32af80d46b60d0aaad102186a184445a7531dc6990a4b53cbec871e3a09dded","t":"……그림 님의 명령이라면 어쩔 수 없겠네요."},"316:0":{"lh":"527dfe49","m":0,"g":"9cc201b3cfcf395bcfb98539b2a337f67e274e4bc77b29248125fc1667d1559d","t":"폴라리스는 그렇게 말하며, 어딘가 쓴웃음을 지은 채 우리의 수갑을 풀어 주었다."},"318:1":{"lh":"14ab6d46","m":0,"g":"e523233e1f664c197c29e2b8b9c57be7b579ac133de54ba66ce640dec841ed2a","t":"그럼, 저는 이만. 끝과 시작의 별, 마음껏 즐기다 가세요!"},"324:1":{"lh":"fa5a958","m":0,"g":"e0ee2a78ac81a36bf4334bab7a52841105ff73a03ac1f712120ca1b2a825b3d4","t":"아…… 고마워? 근데 이래도 괜찮아?"},"326:1":{"lh":"6b468524","m":0,"g":"d6c4b77d3cb49a66d9c0258d2638418bf39100792ae8bdafaf55e6e5a4fb4f60","t":"뭐, 그렇지~. 그림 쨩이 거짓말 좀 하는 건 일상다반사니까. 들켜도 그렇게 심하게 혼나진 않거든. ……그런데"},"328:1":{"lh":"11b9c7d8","m":0,"g":"44bb664802277dc1ad1ef67d557994607a762625c75847b5314bb07f09c228a7","t":"결국 왔구나…… 루미나 언니네."},"332:1":{"lh":"772bb1e3","m":0,"g":"b5570accea4db6bac16feff0b1c05e94a0334f79e77b096ec44e8c3ca88914a0","t":"돌아오지 말고…… 그대로 달아나는 것도 방법이라고 생각했는데."},"334:0":{"lh":"c4cc391c","m":0,"g":"d47ab0852c88707cfcabd6c1e3ebe51a939ea05033ea29d667753ab338a923a0","t":"그건……"},"336:0":{"lh":"530681b2","m":1,"g":"4aa002bf436b57ebb127ff768eca80f457788103671ef80b52b614510792c7d1","t":"{PLAYER_NAME} 군!"},"361:0":{"lh":"be7adf7a","m":0,"g":"e505497e69d5a1559dfd6518fd496607f0966bf4caf890024ea40b3b08eb5bd6","t":"괜찮았어? ……이것저것"},"363:1":{"lh":"671354a1","m":0,"g":"d4202909759917f97b866a862c3d7dddc1fd0bdd57aa1aedea301c225b7da4b9","t":"응, 괜찮아. 대관식이 끝나면 언제든 루나링을 꺼낼 수 있어."},"365:1":{"lh":"4af6ea30","m":0,"g":"74886e042f7cb66da36e80c3fd3b909d71b8f91fe7f32a8d63bd4a1ff9f7e82b","t":"저기…… 얘기는 잘된 거야?"},"367:1":{"lh":"e3472818","m":0,"g":"721f3c0d6626aec69b31a9648654e3ac384ce87135ee93c3147757c40ee3b2d1","t":"응, 여러 일이 있긴 했는데……"},"369:1":{"lh":"133e89a8","m":0,"g":"61ef3377de97a7b4b4ec15c9c112cdb262fd1cc460b58d19203bd89603e1beef","t":"나, 여왕이 되기로 했어. 그게 가장 좋다는 걸 알았으니까."},"371:0":{"lh":"e37e881c","m":0,"g":"d1f36b7d5c6fe550cdc33f0492bb8f1726a2a554909a56ceb692c494a12642be","t":"어?"}}}