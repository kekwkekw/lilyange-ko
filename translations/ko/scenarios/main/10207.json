:"401104e2","m":1,"g":"ea5d32e00fba7b6838539507773144c09dfbf25d0a377b506284e70d65ff06da","t":"（이자들이라니…… 나랑, {PLAYER_NAME}?）"},"147:0":{"lh":"2bb42db","m":0,"g":"c7b8c91f9ecbda2cee90857346471490a4604edcc2bc4d0909e989f8d4bc02df","t":"넷, 알겠습니다. 즉시 제물로 바칠 준비를 하겠습니다"},"149:1":{"lh":"79820d6d","m":0,"g":"d2f60cc5cfeac7f77af2bd64bd1cbe0bc8b2a5d67426acb6da881172d3d45a32","t":"의식은 서둘러서는 안 된다. 감옥에 가두기만 해라"},"151:0":{"lh":"d54efd5e","m":0,"g":"dd64f4a5b653f7f2d0a46a7face8239f04bafad1cb2dabfd4404ed16d78ec5a4","t":"넷!"},"157:0":{"lh":"7a035d9b","m":0,"g":"457c1f3c81013f41155b3b20704e5148edcd8d690d54675c479557560eb053a1","t":"보바 마을의 전사들은 토레 마을 주민들을 다른 천막으로 데려갔다."},"159:1":{"lh":"2e747725","m":0,"g":"d96fbc29a2020a5d6e1c1b8e502690e6afb7955e2b2df21db943f0efcd5b043d","t":"들어가라"},"165:0":{"lh":"e9cffc72","m":0,"g":"91c514f333da0bf99ddde8ad81975c4d8e624c8295e8a515ae3f082ab8ce93c4","t":"그렇게 말하고 라기오라는 천막 안으로 들어갔다."},"181:0":{"lh":"678d8075","m":0,"g":"25bf5de6bd14ac5620f52b39717aff90cae5a1a820b459839f2e79f1d09785f4","t":"천막 안에서 라기오라와 코하루, 그리고 나까지 셋만 남았다. 뭔가 묻고 싶은 게 있다고 했는데……"},"183:1":{"lh":"7939542b","m":0,"g":"a94b94d879fdd2faeca0db3f95c03f5a87085e28fd9be1cefe79647a201b7ca8","t":"（설마 갑자기 목이 잘리거나 하진 않겠지……）"},"185:0":{"lh":"9a3a0fe4","m":0,"g":"443ead76ad05413a3409b6439fb68b4d6d66de8db51ff4782de2fe44fe7f3bc9","t":"（자꾸 무서운 소리 하지 마!）"},"187:1":{"lh":"d8e887e6","m":0,"g":"91f683a158c4aa00bd4822ba602516f278c7031891c625619f6a69660c769c90","t":"（최, 최악의 상황을 상정해 두는 건 중요하잖아!）"},"189:1":{"lh":"f556b8af","m":1,"g":"0eaf4b090f98e8433192d036407e182b02bc8af74610977eee254b39d4326f62","t":"（그리고…… 이런 상황이 되고 나니 설득력은 없겠지만, 무슨 일이 있어도 {PLAYER_NAME}만은 내가 지킬 테니까!）"},"191:0":{"lh":"ba91baba","m":0,"g":"7390b9bd38140c7bf8fee5e7a56b00a1026aef5cdf790ae20b3947ac236186ef","t":"（보통 그런 대사는 내가 할 차례 아니냐……）"},"193:1":{"lh":"5c2d1be8","m":0,"g":"63a3d3b89b3c99dd9a7e86de5abcf5420a2c5a371dc1c42cd3a72b9e281ab974","t":"……갔나."},"196:1":{"lh":"66fe02b6","m":0,"g":"3fb116676eb7c6d804a6e1fc5cb62c9764d8fc73b8746ff507d3a0c12a216d3b","t":"네, 네엣?"},"198:0":{"lh":"2ea4c9e","m":0,"g":"e799deffecba531b2d5ed00a65849d285adf047da5ce8420ec3d9f14e24e1203","t":"바깥쪽을 살피던 라기오라가 이쪽으로 돌아섰다. 아무래도 천막 근처의 사람들을 경계하고 있었던 모양이다."},"200:1":{"lh":"596195e9","m":0,"g":"ff5324c6594570641170c0611b2433c35e29fa3f82a1d324fafc88335f4c034c","t":"그래서, 네놈들에게 묻고 싶은 것이 있는데……"},"202:1":{"lh":"b44913e4","m":0,"g":"7c1fac7ece05c635834b827d11c0445de4b0b26b9eeb57baf6e083712fb9f289","t":"……네."},"210:1":{"lh":"b9eee04","m":0,"g":"35047d85c6ca98fe868233bb2f3566b3a07f97e0216700e452fe8ce4c4569fa0","t":"너희, 어딘가 먼 바깥에서 왔지? 부탁이야, 나를 좀 도와주지 않을래……?"},"214:0":{"lh":"92dc9738","m":0,"g":"69af9b8182d2a2f33ca7672ba395edffcb6fc43cfba622a5ddf66c2e768b9194","t":"……어?"},"216:0":{"lh":"57b6482b","m":0,"g":"277ea27862529ca17e261a8778a644a4d74560ed89d239c6c95781395b733f21","t":"라기오라가 바닥에 앉아 편한 자세를 취했다. 우리에게도 앉으라고 권했지만, 갑작스러운 태도 변화에 코하루와 서로 얼굴을 마주 보고 말았다."},"218:1":{"lh":"23c767ea","m":0,"g":"bbfd068db6499322987e9cd2108b5225421fe8486cf8b87c95155cdfd33619aa","t":"……아, 저기……혀, 협력……?"},"220:1":{"lh":"4364435a","m":0,"g":"ead8ea4376bcf4da8454b96531a6580b02e63b5760962d4b57da4db293fb1f14","t":"그래. ……사실 요즘 제물을 모으려는 움직임 말인데, 이 몸……아니, 내 힘으로는 감당이 안 돼."},"222:1":{"lh":"7546eb87","m":0,"g":"e6ed177cd0f10edf1125609565099c90cee5bd5103b3553bf8a92864997862a4","t":"（……말투가 꽤나 편해졌네……）"},"224:0":{"lh":"6e02192c","m":0,"g":"ef2dc28c1c8eaf197b3933ee6b1375931c8e9be9a786e3da5d2028539f14cb1c","t":"（이쪽이 진짜 라기오라……라는 건가? 아니면 이것도 작전……?）"},"226:1":{"lh":"93809093","m":0,"g":"a9ae60cf24417d27bc909ed6d1148d2598e0d86d9aa8c916aacc447420becd07","t":"애초에 요즘 들어 이 일대의 날씨가 이상하게 변하기 시작했고, 그걸 잠재우겠다며 소란을 피우기 시작한 일부 마을 사람들이……"},"240:0":{"lh":"2a42640","m":0,"g":"e9fdf16a72f8b6b161e386ceeb6ab4fd2849852a908c1d03f3f18386c3aed435","t":"라기오라!"},"242:1":{"lh":"c56572f5","m":0,"g":"7a840c55d71b2b20abd4659bfc36d65f8babd8d5de41c54556bb45a81ff8fa96","t":"무슨 일이냐, 시샤."},"244:0":{"lh":"db99511a","m":0,"g":"366dec5fba1d02d5120ba1b8c60ab9d231cb04bbea1d5d611833d196ca4525fc","t":"라기오라는 방금 전까지 구부정하던 등을 순식간에 꼿꼿이 펴고, 시샤라고 불린 리리안에게 차가운 시선을 보냈다."},"246:1":{"lh":"6ceaedf4","m":0,"g":"655a0af7456f5b4f7341d9143d6c56686650a3203acb8c3584a20113b6112765","t":"짐승, 엄청 큰 놈, 나왔다! 나, 가도 돼!?"},"248:1":{"lh":"958e9f8f","m":0,"g":"37fc72546161794203f136b674049c85a69a38ec904be05a62a166ac8eab9755","t":"네놈은 지난번 명령을 어기고 멋대로 앞서 나간 탓에 근신 중이었을 텐데?"},"251:1":{"lh":"237063c","m":0,"g":"4c0fb1cad3e14a6dc6cbf9a8425048a296664daf4af975056a12a8b0659baeb7","t":"윽, 그치만…… 지금 있는 놈들로는 못 쓰러뜨릴 것 같아…… 몇 마리 놓칠 거야……"},"253:1":{"lh":"8911198d","m":0,"g":"21a1f17653af24fa77d6acb0a8a7804466a85ced26765fec8faf6ba900a0d99c","t":"……부대를 이끄는 자의 명령을 따른다면 허락하겠다."},"256:1":{"lh":"89f18c4a","m":0,"g":"45a5b50299c46ab33b6577f8321cac58d718cc1e95a62bab34faa4e42146f346","t":"정말이야!? 그럼, 갔다 올게!"},"270:1":{"lh":"bded9ad8","m":0,"g":"3cfcac3fe4b821cf0a690dbeb40d6e68fad4eea0e6d793aac469df3b781c6b8f","t":"……아무튼, 이 마을에는 혈기왕성한 자가 많아서 제물 운운하며 소란을 피우다 지금에 이른 거야."},"272:1":{"lh":"a0cdc574","m":0,"g":"8c9d0eacad8ea9efaaa6a07e07defd6fc11e4e8272fa4f6a387fe2d81191afd5","t":"하…… 하아…… 그래도 싫으면 그만두게 하면 되는 거 아……닌가요? 이 마을의 촌장이시잖아요?"},"274:1":{"lh":"cc113437","m":0,"g":"81ef4781639e33df283872548bd81b3be0908002746aea9a9f93cb24c70b03f7","t":"그렇게 할 수도 없어. 보바 마을의…… 토레 마을까지 포함해 대부분은 신의 심판을 믿고 있다. 갑자기 그만두겠다고 해도 납득하지 않겠지."},"276:0":{"lh":"53380105","m":0,"g":"2b3c0abc38e2ee2d3356cd43d3e1e042f43dea50ca941979e2a9e92a67a89b2e","t":"어…… 라기오라…… 씨는 신을 믿지 않으세요?"},"278:1":{"lh":"3d0353b5","m":0,"g":"bd7d88c6f66fdfe25da6828dd625af468f623ee5dd63cd88f2fd1644ab5e1cd7","t":"나도 전혀 믿지 않는 것은 아니지만, 이번 이상 기후는 신의 분노와는 무관한 것처럼 느껴진다. 제물을 바친다고 해서 멈출 것 같지는 않아."},"280:1":{"lh":"b02bf5bd","m":0,"g":"1d132ce5ee4c4978df7c61528b57f5e60dd53a7fc6f213da591ea67a0da354ce","t":"제물을 바쳐 백성들의 마음이 구원받는다 해도, 날씨가 원래대로 돌아오지 않으면 의미가 없다. 그래서 제물을 무턱대고 바치지는 않고 해결책을 찾고 있었는데……"},"282:1":{"lh":"3ad99464","m":0,"g":"12807955d5cc257b14c2650d307718801f7fb1904cd6413e5a371acfcc161ce8","t":"（이상 기후를 멈추겠다니…… 글쎄? 정말 신이 기분 나쁜 거라면 어쩌려고 그러지?）"},"284:0":{"lh":"800cdae0","m":0,"g":"a988c0b8a886a6afdf4d56b6d216eec7d41304ee5ec62139b84b979dcf7787b6","t":"（우리가 해결할 수 있는 문제는 아닌 것 같은데…… 아니, 루미나 일행이라면 어떻게든 할 수 있으려나?）"},"286:1":{"lh":"6d47fffa","m":0,"g":"0606416cac916785cc7f4d5744f916c761fafe892eb37381e6d7e8669faf2bbf","t":"얼음이 녹고 나무가 시드는 것처럼, 날씨 또한 어떤 법칙에 의해 이상해지고 있는 게 아닐까, 나는 그렇게 생각한다."},"288:1":{"lh":"ecc9c31a","m":0,"g":"18bf1e385a27dc904ed974d38b7121779e75ca8086a9312af901fce8d6906a3e","t":"우리에게는 없는 지식을 지닌, 하늘을 나는 자들. 너희라면 원인을 알고 있지 않나?"},"290:0":{"lh":"c281afe7","m":0,"g":"18972b37b6deec487577fff0bd65cdf951e3d0491e724d04620c9cbede751620","t":"그 말을 듣고 코하루와 다시 얼굴을 마주 보았다……"}}}