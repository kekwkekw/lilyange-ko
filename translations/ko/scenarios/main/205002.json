796999991f038fc6d59724dc45d406d8455fa2d1f3775d6f808","t":"히나타라고 합니다! 신세 좀 지겠습니다! 이렇게 큰 마을이 있었다니, 몰랐어요! 대단해요!"},"54:1":{"lh":"68cd96fd","m":0,"g":"ca3c717aa8e37ea955f60375c412e658dcb97b671c6a24d6dbf72391d34451a5","t":"라그셰예여, 여러모로 의지할게여!"},"56:1":{"lh":"f0fcffae","m":0,"g":"df4687f65f672fb5017934710686b88e80e991e38db6a3294a255dd01675a4c2","t":"……음? ……뭐, 상관없겠죠."},"58:1":{"lh":"1c76734","m":0,"g":"f65196e5df8f8fd0f7f13d70f45a2f9181b36899a6970c2286af46d76c5b42ad","t":"스읍, 하아…… 심호흡하니까 기분 좋아……! 공기가 맛있다는 게 이런 거군요!"},"60:1":{"lh":"302b8bc4","m":0,"g":"28495a38e183e4cf94d462456c233a0b482dd375a1f03893cf3916b312996c4b","t":"여기 와서 공기가 맛있다고 하는 사람은 처음 봤습니다. 공장 덕트에서라도 사시는 겁니까?"},"62:1":{"lh":"8ba09aeb","m":0,"g":"5514d4c292eb9277941a9f14ddf2a3eb0e6d785f5a68a8dd0415fcdf972745e9","t":"으으음, 히나타 님은 정말 착한 아이네여! 확실히 메모해 둘게여!"},"64:1":{"lh":"7700a22","m":0,"g":"a155592abc2c11b7d230c61b59b5713cb43a028d97ded83a6aabe681ae83c90f","t":"그리고…… 으음, 카스미 님은 착한 아이인지 아닌지 판단하기 어렵네여. 일단은 착한 아이인 걸로……"},"66:1":{"lh":"3e3b952a","m":0,"g":"58114d6afb5d147b6e269465592afb58ecab1cd2540748e4b85b3368a560a208","t":"무슨 이야기인가요……?"},"68:1":{"lh":"5796bc58","m":0,"g":"05721cb27ef31b576c3c6e0a9856893d929c82ebb9857119c3c5379dceb2f873","t":"그런데 체험 입학은 두 분뿐인가요? 한 분 더 계시지 않았습니까……"},"70:0":{"lh":"4b10e75d","m":0,"g":"e4bf575ff3b8844da1b9248c07cd81c56d0d04d2e179e3feab0a1c9d8d1f38d1","t":"루미나와 코하루는 우주선에서 기다리고 있다던데?"},"77:1":{"lh":"56c2f94c","m":0,"g":"b7e763a6ab4a893aed39a312807ba9487fcb36acbb2df62d0d727bbba08b10fb","t":"아이도 라그셰만으로 충분할 것 같거든. 라그셰 사진을 다 찍고 나면, 아이는 밖에서 학교를 구경할 예정이야~♪"},"79:1":{"lh":"938f9ce2","m":0,"g":"1409298c72bc395f52e8927f7529d504cc3103e875ef19cbcc2c2d51ece2b1ff","t":"그건 전해 들었습니다만. ……뭐, 됐습니다."},"84:1":{"lh":"2b4e8b71","m":0,"g":"515cb1f72e9e65701646e7e83412f742b10cc0c2fe66321919d96d4c88850885","t":"체험 입학을 위해 준비를 해야 합니다. 체험이라고는 해도 필요한 물건이 많으니……"},"86:1":{"lh":"1349a4b1","m":0,"g":"b20f58600dcce81fbff232840361bbcca905e3a1f37bd47717adcbc3443bc2a4","t":"문구류 같은 것도 사고~? 기대된다! 라그셰한테 딱 맞는 걸로 찾아보자~!"},"92:1":{"lh":"71403272","m":0,"g":"28a475d11aafac3dd88cef56e661b87814ffb4e8a62401919bb1d0ad0e49ed2c","t":"피, 필요한 게 많이 있나요?"},"96:1":{"lh":"ea3f48c9","m":0,"g":"1346dd9f6dd5c9fcfc95acde1e26c4904fc25f8de9c3f5b3b65307d3f6d82245","t":"그, 그렇구나…… 우리 마을에선 그 준비, 어쩌면 어려울지도……"},"98:0":{"lh":"ca229403","m":0,"g":"064560cef8611fe3e6d3de5d59f9c6d1453aa4f5efc91ced0d04a2d863e91d39","t":"히나타가 주위를 둘러보며 한숨을 내쉰다. 확실히 주변에 있는 고도의 기술로 만든 물건들을 보면, 흉내도 낼 수 없다고 낙담하는 마음이 충분히 이해된다."},"100:0":{"lh":"9fcd9042","m":0,"g":"9449376eb28c25d246939837160ebf73329ce88aaa8e4e42ebb23af64b34da36","t":"아…… 여기가 이것저것 유난히 신경 쓰는 것뿐이니까, 독과 부패의 별에서는 필요 없는 것도 많지 않을까? 만들 수 있는 것만으로 충분하잖아."},"102:1":{"lh":"948d37c3","m":0,"g":"a3dfc6583834b77cd84f729335190522e60b4c87b519531c7c27146b341d4139","t":"그, 그렇네요…… 여기만 못할지도 모르지만, 그래도 힘내야죠……"},"104:0":{"lh":"a90e14a7","m":0,"g":"a05043b4aea37b76d6c6f01b38cd94d51bc62e0ccb5c17f3a751838b1071fcdc","t":"（음…… 왠지 아직 기운이 없어 보이네）"},"106:1":{"lh":"32c4f44a","m":0,"g":"85dae5489c659a755dca31830f0bfe178bc7bdcb6f07892a56152600fe3c661d","t":"히나타 님, 준비해야 할 것 중에 아주 중요한 일이 있습니다. 그 일에는 히나타 님께서도 협조해 주셔야 합니다."},"108:1":{"lh":"84cc55c9","m":0,"g":"2bb2ddbfda955c15c7c3470e9f68da7f6bccb170768b936126c9f078390db903","t":"협력……?"}}}