9:0":{"lh":"81b68fff","m":0,"g":"0208e859ee18a226bbf68a6c3ab8ea37be944d2f988fdb7df6a4e200ee151173","t":"큭……!"},"71:0":{"lh":"9947dfe4","m":0,"g":"4e138f54e4f854aabb03c54169aa19e455b17d6cd977f40e024bb445b1b910bc","t":"시즈쿠의 공격은 실패했지만, 아직 시도하지 않은 공격이 있다. 어느 하나가 통할 때까지 계속 공격해 볼 여지는 아직 남아 있다."},"73:0":{"lh":"aafdb4e3","m":0,"g":"4af1b64c04231e793b5939e994054adfcf73a5e61d13048ca3c513bd0dc87173","t":"하지만 힘으로 밀어붙이는 싸움이라면 절대로 지지 않는다는 자신감이 라빌리스의 여유에서 드러난다. ……설령 깨어날 수 있다고 해도, 몇 번이고 이쪽을 다시 잠들게 할 수 있을 것이다."},"75:1":{"lh":"c0fd3104","m":0,"g":"2ed19a90f37d679b36a47b5468220d7decc5bcbc2e9af4cc6b1a2eb4830349ea","t":"그렇게 걱정 안 해도 되잖아, 다 같이 돌봐 주기만 하면 죽지는 않는다니까～!"},"77:1":{"lh":"7562899b","m":0,"g":"a9509fb514389044c7e14d7d7e50f89bde26bf4ec952c5b0ef85d15271f8491c","t":"그러니까 느―긋하게, 푸―욱 자고, 쉰 다음에 앞으로 나아가면 돼. 그때까지 멈춰 있어도 괜찮잖아? 지금까지 열심히 해 왔으니까……"},"79:1":{"lh":"a1753002","m":0,"g":"da960d24a70d59b2b3d3fb5cbc854b05509a8c0b92be119f4aa98f909a1f7a7e","t":"계속 잘 수 있다면, 계속 자고 싶잖아? 다들."},"81:0":{"lh":"b1ae991c","m":0,"g":"d4958d3b288e7bf6064661695055387a4ff0a92b095c0b3500de7d8012a0f6e0","t":"그럴 리가……!"},"83:1":{"lh":"2817ad9b","m":0,"g":"3d8a3cc22da3d404bc54f0944ebcf9114b11b7c429242543e7f5346a3d1bbe0f","t":"사람마다 다르긴 하겠지만~. 마코는 어때? 마코도 나랑 같은 생각이지~?"},"92:1":{"lh":"a1017676","m":0,"g":"69562e0bd3f70767145596cab63b5252255098428068fd2a3a631f2fb940bb07","t":"마코? 음~…… 음~…… 글쎄……"},"94:1":{"lh":"b30d988e","m":0,"g":"6b8958efe2833c4c3cf72b64abdd22adb79770e165fcdba8d8b2aaee393fc9f3","t":"마코도 계속 자고 싶을 때는 있긴 하지. 계속 놀고 싶다거나, 계속 이대로 있고 싶다고 생각할 때는 누구에게나 있지 않을까?"},"101:1":{"lh":"bff38158","m":0,"g":"0e976307dea1aaabbe73863d724ae4be65418b885f100593bba96c2107fe0179","t":"그치, 그치~! 역시 마코는 말이 통한다니까~♪"},"103:0":{"lh":"222d1c8f","m":0,"g":"acda64664dba0eefc2e2721f50ebeadf757b2b400f8c86e7de8d84abc4e4e6e6","t":"마코……!"},"105:0":{"lh":"7fea414c","m":1,"g":"bae858e6e51a2cbae143a60b0a817a3de6bee53190dcb2a9459f6ee54c748eaf","t":"라빌리스가 눈에 띄게 기고만장해진다. 코하루를 위해 라빌리스를 설득해야 하는 상황에서 초조함이 커져, {PLAYER_NAME}은 자기도 모르게 말투가 거칠어졌다."},"107:1":{"lh":"91115cba","m":0,"g":"2f4c8a677caf182c789db9a41d9bb4fb0cb9f022b1d8f7cb1e455c5cddde6cb6","t":"여기서만 하는 얘긴데~, 내가 일하려고 몇 명을 모델 케이스로 골라 뒀거든~. 마코도 그중 한 명이야."},"109:1":{"lh":"c850f707","m":0,"g":"0221cb1f82699539bb7c9371f426b5994d896a308322527be2e55e5b4a4784b1","t":"어? 마코를 지켜봐 줬다는 거야?"},"111:1":{"lh":"da5cb904","m":0,"g":"9c66f1e8d43f61203ad60a167e0e3301aa73520d51a14d13cdfe36da52024f6d","t":"맞아 맞아~♪ 인간에게는 여러 욕망이 있지만 말이야~, 마코는 돈 때문에 곤란한 적은 없었잖아~?"},"113:1":{"lh":"1db9ff36","m":0,"g":"f8d07447c7d0a73921f373a3c28d1201a11f40091eb966aafd43d67347f863a2","t":"그러니까 인간의 금전욕 말고 다른 욕망을 알아보기에 딱 좋았어~. 다들 꾸는 꿈도 마코 덕분에 더 알차졌을 거야~♥"},"115:1":{"lh":"86920aa4","m":0,"g":"3c188b2ab487ead9c5d3159a993b22936e0409d365af797e6aa248c39db413aa","t":"아~, 그렇구나. 그런 거구나~…… 하지만……"},"119:1":{"lh":"2eb8515c","m":0,"g":"b9fa5340596a6fc065021a6d642ebc833e35cb00f85bbedfd3a7cf94d1dc5fcb","t":"결국 조금만 지나면 다~들 일어나고 싶어질 것 같은데? 아마도."},"123:1":{"lh":"aa1953d2","m":0,"g":"69af9b8182d2a2f33ca7672ba395edffcb6fc43cfba622a5ddf66c2e768b9194","t":"……어?"},"129:1":{"lh":"7f005411","m":0,"g":"1f8d6d97b0f090f4bfd9a50e9a12d2b0befc98c8eed5128a97649ad899577ff2","t":"마코도 얼마 전까진 말이야~, 돈을 더 갖고 싶다고 생각했어. 돈이 잔뜩 있는데도 말이지. 지금도 최애를 응원하려고 돈 버는 건 그만두지 않았지만."},"131:1":{"lh":"6d756d43","m":0,"g":"a106724f1d9cbcf5a75ca0da8ca1c9c9c86ef32da131709237a25c2b3a29a6cb","t":"으, 응……?"},"133:1":{"lh":"e0586538","m":0,"g":"a32a3deb05be69e7ece1f95583678c8bce2cac69ef372fa8e515d44213092b6d","t":"마코가 돈을 그렇게까지 원하지 않는 건, 돈이 많아져서가 아니야. 돈으로 이룰 수 있는 다른 꿈을 꾸고 있어서야."},"135:1":{"lh":"ff8ed2bf","m":0,"g":"d5b300bc85201abac850769cfcf1e24ad340be7545674adf71562605ac4add7f","t":"다른 꿈……?"},"137:1":{"lh":"f363b741","m":0,"g":"e3824cd859a4b42d9c37bc3db738bc75be8c52c0ef5a9f96856f046ad0d2bad7","t":"라비삐가 아까 말했는데~, 다들 흔히 돈을 원하잖아? 그건 돈을 써서 뭔가 하고 싶으니까 돈을 원하는 거지?"},"139:1":{"lh":"61da02f2","m":0,"g":"1577483cd9d2fa6ddd5d7a2eda33e1987269a0c24024447d74adf1f82d1599e0","t":"그렇긴…… 한데……"},"141:1":{"lh":"ae6c9f7d","m":0,"g":"1ee407a3af31d43bc7b4b4d7c3f8e8ab6b1af51bddf657be5d87e199dfb2809b","t":"자는 것도 마찬가지야. 푹 자서 뭔가 할 여유가 생겼으면 좋겠다~, 체력이 생겼으면 좋겠다~, 졸음이 사라졌으면 좋겠다~……고 생각하니까, 자고 싶은 거 아닐까?"},"146:1":{"lh":"d12ca1ec","m":0,"g":"64453e5209f9f9af85a364a6444a1b2b8bd623b4250992c44361b90c2a866be7","t":"물론 그냥 빈둥~대고 싶은 사람도 있겠지만. 그런 사람도 진짜 속마음은 다르지 않을까? 빈둥대지 않고 척척 움직이는 사람이 되고 싶다고 생각할걸. 그 사람도."},"150:0":{"lh":"ef5f8b94","m":0,"g":"d6e848404cf965181164ad355c2ddfff67489411f902b7b2ac5c3fe3a3de01e8","t":"(뭔가…… 모습이 이상한데?)"},"152:0":{"lh":"9c5689a1","m":0,"g":"07f3efa61653dcaeb2ce809fba376c21f99cc358d50e8b8b63f201153ab838b9","t":"지금까지 줄곧 느껴졌던 라빌리스의 여유."},"154:0":{"lh":"385cfc46","m":0,"g":"9885964b1a6b5cd66d3900cf18b43f563978a3941975b1d86a9280951d51ea28","t":"하지만 마코의 이야기를 듣는 동안, 라빌리스에게서 느껴지던 어딘가 느릿한 분위기는 사라지고, 미간을 찌푸린 채 말없이 어딘가 한 점을 계속 바라보고 있다."},"156:1":{"lh":"1feee289","m":0,"g":"871df2e1c1b88155e54914a10cee6f0ef3370d4f914fed37df8b58ea64c63219","t":"……계속 자는 건 인간의 진짜 소원이 아니야. ……자고 난 뒤의 행동에야말로 가치가 있어……"},"159:1":{"lh":"a22dfdee","m":0,"g":"fdc748cfa12636ce54c2b3ca93dfbbff325cc74e7c8637e1609c0d692fe5f5ad","t":"납득했어. 라빌리스는 이 별에 필요 없구나."},"161:1":{"lh":"58ce03a7","m":0,"g":"0b19264495a7551d307d10120d6039c653b0d6f8c2b8c344ae8de15d85575537","t":"어? 벼, 별로 그렇게까지는……"},"167:1":{"lh":"cc5b100a","m":0,"g":"de89a52cb128863af9ea656e3b1e46901e5194f3dcf43931525127b9a979c930","t":"…………으음……?"},"169:1":{"lh":"bb859e76","m":0,"g":"8d2c905526658106ee0da2db1a2afc25e53b2f3a07b001f8aae8ad6c95cfa9de","t":"어, 어라? 나……"},"173:0":{"lh":"c951bd9a","m":0,"g":"178856543630418b5a18dfd9a257d21e9044a2e76dc89ab469dca25f3d116fe2","t":"코하루!?"},"175:0":{"lh":"9aad4076","m":0,"g":"ad785a16ceea4b8328b46b80ac8eebcafab8e0d6146ca0d25c754d32c5718064","t":"코하루가 몸을 일으켜 주변을 둘러보며 눈을 깜빡인다. 그러자 조금씩 주변 건물에 불이 들어오기 시작했다."},"177:0":{"lh":"b9458036","m":0,"g":"3cb7d3512764f5d9a776c8b5a617e937c7afadec1b8ba60f65a5753f28c0eda5","t":"다, 다들 깨어난 건가……!?"},"179:1":{"lh":"81a96874","m":0,"g":"e8ad8cc439d402764980ac58ca900ad3690ef16fe53f50f6bea1d0ff4b2860f4","t":"납득해 버렸으니까~. 내 능력은 인류에게 도움이 안 된다는 거. 그럼 그만둬야 하잖아~."},"182:0":{"lh":"55a5937b","m":0,"g":"6856c8ae1a1ccd1ea9846de977fc8a7618c331920f8716724585b55fe9726449","t":"라빌리스가 토라진 듯 드러눕는다. 그 모습에 주변 사람들은 복잡한 표정을 지을 수밖에 없었지만……"},"184:0":{"lh":"ed934d4a","m":0,"g":"b4c633bead19e4a230558d128afe62a04baa6f942e676e9fd9221ad47f36ed2d","t":"어…… 어쨌든! 고마워, 마코!"},"186:1":{"lh":"3fdc36cd","m":0,"g":"8ae2af7118c2683098006588f394c9ad5a3a5ae096db2d625b67d23d8996cfa7","t":"어, 마코? 마코는 아무것도 안 했는데…… 그냥 얘기만 했을 뿐인데……"},"188:0":{"lh":"86995c7e","m":0,"g":"badd43e8ba57eeb7a0021724c037f511a17cb3cb9028851960c91b2f3a7d087f","t":"마코 덕분에 코하루가, 이 별 사람들이 깨어날 수 있었어! 아무것도 안 했다니, 그렇지 않잖아!"},"190:1":{"lh":"9ca11035","m":0,"g":"acde5d2867e269337fb5a5fc8238132f49026b2056d27ef7991bcc1f0935d4c7","t":"저기…… 나도 도움받은 거지. 고마워!"},"196:1":{"lh":"2a223d57","m":0,"g":"22fbb537701fa8c7fb1d726a118469edd9695decd923f00520d4db43c327046e","t":"고마워, 마코 씨……"},"198:1":{"lh":"b808df49","m":0,"g":"8e48a1a16fe84f2f43a254bf24b6c60eed7628e2a958a9424b43b063f5af2ff3","t":"어? 어? 부, 부…… 부끄럽네~~! 지금이 평생 중 제일 많은 감사 인사를 받는 순간일지도~♥"},"207:1":{"lh":"b33ac8f8","m":0,"g":"5219949b3a579bdc40916add936ddc6e4f28dd7c57afae1af3d77488d6512da7","t":"흥, 진짜 최악이야~. 재미없어~!"},"213:1":{"lh":"e316593f","m":0,"g":"8be017d420a164458d68e110d63e03cc7834922ce53acc96e00d021beb10980a","t":"……이제 아무것도 하실 생각이 없는 겁니까?"},"215:1":{"lh":"4ad5edd","m":0,"g":"e67f0222ad71ea88083cc00c2a048e2008eb4d630eb53f031d69210a5417c45a","t":"하고 말고 할 것도 없이, 못 해~. 적어도 이 별에서는 말이야~."},"217:1":{"lh":"ff070f7","m":0,"g":"8b7ff80de6b77e45e6ca4fa1a030bfb6ac1b4cbf92b9f29901fdbbdd25dc2589","t":"(인류를 위한 게 아니라는 걸 납득했으니, 그만두지 않으면 안 된다……고 했지요.)"},"219:1":{"lh":"261017ce","m":0,"g":"349fa0c55f48dede206846e88ebbe537fcb4c6b7350cb1f95851afd49a8eea7d","t":"(모놀리스라는 것도 인류의 편이라고 자칭했습니다. ……혹시, 아니, 설마……)"},"221:1":{"lh":"52e1c134","m":0,"g":"7798792eb9b841c666d9c7ec98e7db82be40b58853f7a492c5b9af46d44c0dd6","t":"(앞으로의 여행에서, 이렇게 민폐스럽고 초강력한 기계들을 말로 어떻게든 해야 하는 겁니까……!? 이런 몰상식한 것들을……!?)"},"232:0":{"lh":"e9cb8898","m":0,"g":"dd643008f29539d56ba49f6f1a773cbd5ffa52fbb9a267bd158d6b8412f6