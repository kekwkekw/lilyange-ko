0","m":0,"g":"3232dec3de50a615fa84d45ad8fca4280d04dd7b9ca640e6ba8ef14cb4232f0c","t":"……어라? 저쪽 선생님은 왜 저렇게 서두르시는 걸까요……"},"99:0":{"lh":"bfe92be3","m":0,"g":"cbac77212c795d70854cfa84b05679fb07a457f189e86f3a8b41e1d2d800c05d","t":"줄리아 씨! ……지금 돌아가려던 참이야?"},"101:1":{"lh":"66e6129a","m":0,"g":"3cb83ef55f7dce5642fb7467d822af48fe92b06fe13dc769c251cc0e2f0c62d3","t":"네, 그렇긴 한데…… 무슨 일이신가요?"},"103:0":{"lh":"a8fadb96","m":0,"g":"a3d8026df40d319fc446eb14430255bb2fa6c37cb33fc534b042d44f18669bb6","t":"그게, 바쁘면 됐는데…… 괜찮다면 좀 도와줬으면 하는 일이 있어서"},"105:1":{"lh":"e47a4b0c","m":0,"g":"76e8524a7ccb909dbbd488a7a00acd854814d1ee9470c21511296240eca73298","t":"괜찮아요. 무슨 일이 있었나요?"},"107:0":{"lh":"8929c672","m":0,"g":"97d2e6167bdbba0e29756fcf8cf9bc33b8b146c0165685c4403947ebebc37dd0","t":"학생이 마법 연구에 쓰려던 동물을 실수로 숲에 놓쳐 버린 모양이야…… 내버려 두면 위험한 종이거든"},"109:1":{"lh":"58fefbb9","m":0,"g":"2d695de3c9625c746b80cfd07f5302bb0a6f92c362f4150501437c728f14f616","t":"위험한 종이라면……"},"111:0":{"lh":"339f9a7","m":0,"g":"b83b72e22d9b1f9d6a4e5fc6f63ab29e89dcd61c26a649e32c8ae7cba5a0e4be","t":"스카 슬라임이야. 본체나 비말에 닿으면 염증이 생겨"},"113:0":{"lh":"c77b81cd","m":0,"g":"9c8bcfa49c84d6de022742e155aaef8fbc95406801de5864453c8ea88c83a946","t":"실력이 어중간한 학생은 다치거나 찾아내지 못할 수도 있으니까…… 전투 마법도 탐지 마법도 잘하는 줄리아 씨에게 부탁할 수 있다면 정말 큰 도움이 될 텐데……!"},"115:0":{"lh":"a789d4a7","m":0,"g":"ac99bec5cabe62c499c8edfd35cd0c5973d559bb4de8372b2d01688cf5880199","t":"잘하는 게 아니라 필사적으로 공부했기 때문이에요……라는 말이 튀어나올 뻔했지만, 지금은 그런 말을 하고 있을 때가 아닌 듯했다."},"117:1":{"lh":"40ad3d31","m":0,"g":"555bcc2d63d26402289f8cae4928f342d496ca150e8319a050aa679917cd8646","t":"네, 물론 도와드릴게요. ……사고가 난 뒤에는 늦으니까요"},"119:0":{"lh":"889aa870","m":0,"g":"71758c03e1aed9218d6f042740bb5b19072762ac63f587b742e0ed07795ff5ff","t":"고마워……! 정말 큰 도움이 돼!"},"121:1":{"lh":"97b7259f","m":0,"g":"90c26936cd1147527c59d0ada499e0452f4ab687f28d741e03cf6788bf67033a","t":"숲이라면, 학교 뒤편에 있는……?"},"123:0":{"lh":"e5fa601b","m":0,"g":"1354ef4cd8594195c82d2d535138a02ff341d3f1e3340092dc4c7f2e27b0696e","t":"맞아! 연구동 뒤야. 일단 높은 울타리가 있으니 밖으로는 안 나갔을 것 같긴