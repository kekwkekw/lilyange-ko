d072c","m":0,"g":"c096acd09da6ab82fe819ef363125970453e539eb0896c0dbdc7a15b57ccc4f9","t":"뭐든 따르겠다는 건 아니다. ……하지만 문제는 이 오아시스의 물이다. 운반하려 해도 이 지형이 문제다."},"112:1":{"lh":"f755c1dd","m":0,"g":"512838c270db8c3fab65ecb658d1d85a64fccc52ddf74a755fdd893bc0dddbc9","t":"그렇네요오, 몇 명이 쉬어 가는 거라면 몰라도, 운반이라면…… 오랜 시간을 들여 도로를 내면 어떻게든…… 하지만 몇 년이 걸릴지……"},"114:0":{"lh":"a1675aff","m":0,"g":"eb9e759a437810a78504c5077f80b33be4b3cbfe506497543b41de986d72cb7a","t":"그러고 보니, 돌아가는 길은 있나? 어떻게 올라가지?"},"116:1":{"lh":"f5bbf274","m":0,"g":"60dbd53a5b00dd47c384fa8448d6b31576134fb5377d7634b492d0af85761dc7","t":"돌아갈 때 쓸 밧줄은 연결해 두었다. 불편하긴 해도, 불가능하지는 않겠지."},"118:0":{"lh":"1c19dfe8","m":0,"g":"fd8195e981cf4304ef6c3e30724cb88a2c137a0f98e63cd5695ec6fb696a50f7","t":"(전혀 눈치채지 못했어……)"},"126:1":{"lh":"8584aea4","m":0,"g":"1bcd1219b6d219847016eb765a7014c9a8cf90e31bae531df61529dc486bf133","t":"그래서…… 물을 운반하는 이야기였습니다만."},"128:1":{"lh":"cd05b4f1","m":0,"g":"dd33af2c8c694a1a32bc00bd4acc5bbecd4854ffae76ed67996ebd98e1e4fff5","t":"여기서라면 물의 흐름을 스캔……이 아니라 점술로 확인할 수 있으니, 각지에서 우물 정도라면 팔 수 있겠지요."},"130:1":{"lh":"3c74b87","m":0,"g":"19d4b0c58237cdcfa0e2a47fbd568e8a46eb0fb49715519f113c62b5d26b985f","t":"어…… 그런 거야?"},"132:1":{"lh":"917d6755","m":0,"g":"705e4d879c513934c93cf82f3cc82e49eb820fb126ecdd0506e542925474916c","t":"수맥에 대한 정보까지 얻을 수 있단 말씀이신가요!? 그것만으로도 평생 놀고먹을 만큼의 가치가 있답니다!"},"134:1":{"lh":"d7ec1179","m":0,"g":"9c62b5c3431ea0fec67455c01d5b6b00cf5a2fed27b6e3bbd3577623eb07413b","t":"특히 굵은 수맥을 따라가면 됩니다. 어디서든 가능하진 않겠지만, 각 방향의 수맥 위치를 대강 알아내기는 쉽겠지요."},"137:1":{"lh":"5d4edcb2","m":0,"g":"7ce89d146f0c38f317cf39bd342d67e0e3ccd15a210b4b08d0113c2bbc8112e7","t":"정말……!? 대단해, 대단해!"},"139:1":{"lh":"b56811a5","m":0,"g":"36d379845cc7e0396895cad5c6f6e5115f11135b1cdeae7b4dd20e29bb0218fa","t":"우물만으로 물 부족을 완전히 해결하긴 어려울지도 모르지만, 적어도 물 때문에 벌어지는 전쟁은 줄일 수 있어…… 아니, 우물 수에 따라선 아예 없앨 수도 있어!"},"147:1":{"lh":"9fb9b941","m":0,"g":"9914746ced8aeca7abd05dbb5885accabb3f6156f35b6ea7120baf90c7eb6429","t":"정말 다행이야, 라일라……"},"149:1":{"lh":"98b6025b","m":0,"g":"7b9ce47