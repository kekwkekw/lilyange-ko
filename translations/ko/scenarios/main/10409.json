6fb0de3f5fac8639554df6d133947f68","t":"고마워……!"},"174:1":{"lh":"61557570","m":0,"g":"1c4927bed6ef0591a50a22d2498cda0509dd3d56dfce5925b636389321a41ce2","t":"하지만 참 희한한 광차네. 다른 마을엔 이런 것까지 있는 거냐?"},"176:1":{"lh":"ff04bc38","m":0,"g":"5a6d0b8b7eac5245a9bcba217b44d6f27eaf691cf229a29e5577413b5e482774","t":"어……네, 그렇습니다."},"178:0":{"lh":"2429c06b","m":0,"g":"ec1f1570a77cfb67e5181a51e5abc058866a14f6fd0decf06b14b81e88359ba4","t":"(설마, 아직도 다른 마을에서 왔다는 거짓말을 믿고 있는 거야?)"},"180:1":{"lh":"ead4b93f","m":0,"g":"93b9bf6e4c4c5a1341c9b24b7e296ffb1bf3ab747a862529690d55cef0f667ec","t":"(돌의 목소리라는 것에 너무 의지하셔서 감이 무뎌지신 건 아닐지……)"},"182:1":{"lh":"bab694cd","m":0,"g":"cb2f25ffbb647f8ddbb806e6e12cb2829f10efdbd8f8e6060fced6a5483c5241","t":"그래도 다행이야……별을 지키는 데, 힘을 보탤 수 있는 거구나……"},"184:1":{"lh":"d6529c3","m":0,"g":"1da481998c6ded85bd4d6849e873bc9425b515c708a59cc86e4749d0b2a09717","t":"별? 마을이 아니라?"},"186:1":{"lh":"11a403d4","m":0,"g":"d56993f46563d57bd04da319719477f0411b506927639ac9d16319db04ba12c5","t":"아……그게, 우리 마을에는……마을을 별이라고 부르는 문화가 있어서……"},"188:1":{"lh":"505e418a","m":0,"g":"ff4fac44d2a62295bcec73ae7bd3d92e9fe083ab93227efe2994ee9173e315cb","t":"흐응?"},"199:1":{"lh":"1ce747fb","m":0,"g":"434a97e43df0a2db7edd274821eafeaa1eb77cdabd8a3b47f42c19bcce9d80e4","t":"아마도요. 지난번과 마찬가지로, 멈추지 못하더라도 파괴하면 됩니다."},"201:1":{"lh":"30e3f5c7","m":0,"g":"90ab5a5bc01e1c40dfe3a4363829e743ab53c6cde7829ff5e23871e2f47beceb","t":"그럼 서둘러야지! 이제 2시간도 안 남았다고!"},"210:1":{"lh":"19e98375","m":0,"g":"ccd5e6343b3b64d476dfd1c1735f44c6e142777010f2905635aebd3321aa111d","t":"그렇다면, 이것을 받아 주십시오."},"212:0":{"lh":"58e3fab1","m":0,"g":"27c0e2859822eb528b6ef8a7c3fa511b6412f009655e70d055ab5b28262b7bdb","t":"아폴로가 시즈쿠를 향해 무언가를 한다. ……분명 시즈쿠가 가진 단말기에 데이터를 전송한다던가 하는 동작이다."},"214:1":{"lh":"122822e","m":0,"g":"92b7534811ec36245d69848f3c94de11cf9122286d36e74e5172c6e507bf34d0","t":"그 프로그램을 이용하면, 근거리로 한정되지만 기계의 반응을 감지할 수 있습니다."},"216:1":{"lh":"2d7267c","m":0,"g":"62a3e713f13c252452c90a0003af6e8df6b7db6b60f36a41f4d1260909358f2e","t":"알겠습니다."},"218:1":{"lh":"a1e752c3","m":0,"g":"785392259e26a89e0a3e8e8276df3f18c26a46a33426dacce91d3d0c037a66a7","t":"기계……라는 녀석 가까이 가면 된다는 거지? 그럼 대략적인 위치는 돌의 목소리로 알 수 있으니까, 그다음부턴 맡기면 되는 거네!"},"220:1":{"lh":"abe8ee35","m":0,"g":"bb1a3fa015b829a148ae1f65dd875127b630e54b40db285d065a1353f27783f0","t":"그렇군요. 그렇게 할 수 있다면 큰 도움이 되겠습니다. 안내를 부탁드려도 될까요?"},"222:1":{"lh":"ea5c98f6","m":0,"g":"ff10727ede77e38f0efc1e9b51e29b5f7ad3d1953fc155f4bcad4640f7e40fa3","t":"물론이지! 가자!"},"236:1":{"lh":"792a9ff4","m":0,"g":"fb52a46eee5996f332f07f72ecad9a3331d0f00d45c71fbd06b224a065c07a6a","t":"이쪽……처음에 갔던 길과는 다른 것 같은데, 괜찮은 거지?"},"238:1":{"lh":"d4c49ff4","m":0,"g":"03b0d38e805e3ef387fe3fcd798d10f22bbda4154f34cb6bd1866c0cf8b474d3","t":"다른 입구로 들어가서 지름길로 간다! 광산엔 입구가 여러 개 있거든, 따라와!"},"259:1":{"lh":"6ea274ec","m":0,"g":"d7805196f89f2d7b514a0b841dfd9b3e39b9e0f607c2aa77bfe846153718e7f5","t":"이쪽이야. 돌의 목소리는 이 안쪽으로 이어져……"},"266:1":{"lh":"e4779680","m":0,"g":"7dd4fe88ab5835e873f4eeb29e60fcb932e6eff9825858fcb4590afd3d5ebaa7","t":"머, 멈춰!"},"274:0":{"lh":"5657c262","m":0,"g":"807cf5b5adddef4a72d633821581bee0b684e2db41877702039cf2ff74f7662d","t":"블로어의 외침에 황급히 걸음을 멈춘다. 그 모습을 보자 바위 뒤에서 무기를 든 남자들이 나타났다."},"276:1":{"lh":"c20687a8","m":0,"g":"0b0bc9ab62078b9451a4f0edd5b6f6d132920d83b4ceb7b3e0f9be11190cefc0","t":"너희는……"},"278:0":{"lh":"c24c9c86","m":0,"g":"c87cee5e98841897be3aeda0727a9a24b99b8c9b8a125a8ddde83c20becffafd","t":"역시 냄새를 맡고 왔나. 코제 그 자식이 어슬렁대고 있길래 큰일이다 싶었는데……이렇게 빨리 올 줄은 몰랐군."},"280:0":{"lh":"db167030","m":0,"g":"5416645d96716d67c0aa9b66c922f3e7266c28ab1e460ba2c58b6c04efdfc7ec","t":"냄새를 맡았다고?"},"282:1":{"lh":"eb34405d","m":0,"g":"68b40e86355665b93bf4a691e574c839eed609c123988d39100801df94e90f86","t":"……폭탄을 쓴 불법 채굴 얘기겠지. 그런 건 지금 아무래도 좋아, 우린……"},"284:0":{"lh":"ea077d51","m":0,"g":"3d572cff9c5b6e48448fa0f670ef26d33a1f8fa6105045227034eb13003f7ffc","t":"우리도 너희 사정 따윈 알 바 아니라고! 허구한 날 방해만 해대고!"},"286:0":{"lh":"e8d26b5b","m":0,"g":"0fa5623ce7ff3ea563c1f48f9deda67e3371a4f87f1ca201a711442c9c901963","t":"너희는 왜, 같은 마을에 사는 사람들끼리 이렇게 서로 발목을 잡는 짓을……!"},"288:0":{"lh":"ca1970e","m":0,"g":"9acd7f2160847f5421da72daa35c990f401fecb1c3264e12a3cef09a487dd3c7","t":"같은 마을에 사니까 더 방해되는 거야. 우리가 얼마나 고생하는지도 모르면서."},"290:0":{"lh":"ef054040","m":0,"g":"757afecfc0e9126f5d7ec280d0d67925f916a13829f860c5c2378acfcdbcf574","t":"값나가는 돌은 블로워가 싹쓸이해 가고, 우리가 캔 돌은 코제가 헐값에 후려쳐. 언제까지고 우린 위로 올라갈 수가 없다고!"},"292:1":{"lh":"8812ef1d","m":0,"g":"6a2c170d86ed99a84114b220f3eaf6263ef8b36e4495bb0ea341c9d096bcd712","t":"난 싹쓸이하듯 캐지도 않았고, 코제도 너희가 불법 채굴만 안 하면 좀 더 나은 값에……"},"294:0":{"lh":"b398e996","m":0,"g":"93cd37735001ea18c61ddf3a33435581763929a64314864b8bac92c5dc6df734","t":"닥쳐! 툭하면 잘난 듯 위에서 내려다봐서 짜증 났다고! 지금까지 쌓인 원한, 뼈저리게 느끼게 해 주마!"},"296:0":{"lh":"4643527c","m":0,"g":"54c53a607809597ae7b1dc72582690a8e25ceb2c36e2d424709d932958994b7e","t":"젠장, 말이 통할 것 같지 않네……이대로면 다들 죽을지도 모르는데."},"298:1":{"lh":"2ab8e546","m":0,"g":"204033fb56c0f974be5e4aaad711dc3b09abcd554d9321014414d72b1498e01b","t":"남은 시간은 한 시간 정도인가……서둘러 해치우고 안쪽으로 가야 해……!"}}}