fa","m":0,"g":"4395ec528ef636ef8a3bc01d244ca1ea36c472a53671300735c9226fc2480c02","t":"아니. 그럴 필요 없어. 아폴로에게 만들어 달라고 하자"},"441:1":{"lh":"429d819a","m":0,"g":"33c249e0e98bd4ed49ac1cb4dd9f1d6ea223a6e5c9cfb1616a65f6784b0e9e1c","t":"루미나 님……참으로 다정하시군요. 저는 일찍 일어나는 것쯤 전혀 힘들지 않습니다만"},"443:0":{"lh":"f1713ffa","m":0,"g":"a8638d88aecc6ce5d4eba8291e0a290c1de488c7b886ea99ffbc93cebbc1f2dc","t":"그런 대화를 나누며 식사 시간은 흘러갔다."},"449:0":{"lh":"5476a680","m":0,"g":"f007ba8c39117b75688aa33fb5d454d41eaecbc96d9de6e059e03edf01e59d1a","t":"접시들이 차츰 비어 갔고, 나와 코하루가 신께 감사드리는 짧은 기도를 올리자 시즈쿠가 식기를 치웠으며, 루미나는 각자 방으로 돌아가자고 제안했다."},"451:1":{"lh":"403040f6","m":0,"g":"8e555dc32ccf6a32734f22871ba4cd7553ae7a5f2f9f3ccc583c0882b90e6ee0","t":"잘 자, 요……"},"453:0":{"lh":"d6be7085","m":0,"g":"a97e6e47f65716d39a984ac52fc0ca094b860c41c845d394692d70b6edd9a00d","t":"그래, 잘 자"},"467:0":{"lh":"916203ad","m":0,"g":"6633cbd95406de768f7237c2109bcbb0eb903347a3e640b44fa525a5dffee3b4","t":"이 근처였나?"},"469:1":{"lh":"d6e68174","m":0,"g":"8a44cd2cf5c6df91f9c1be9bcc5426dac6dbc72ca31885e5c879dde8fb84bd72","t":"어디 보자……아, 여기네"},"471:0":{"lh":"7a75cd11","m":0,"g":"38d2210d5e284b7e2f3765915b6376a410300005041217c5754de6c6f414f047","t":"코하루와 함께 확인해 가며 배정받은 방 문 앞에 선다."},"473:1":{"lh":"3c329820","m":0,"g":"b91bf95e20393e12e24487df2d48a713e6a098d597db298ad6ebfa5fb2a42312","t":"그럼, 잘 자!"},"475:0":{"lh":"7c03ff30","m":0,"g":"6d714e780ce86d26d4b50bb98505cdc61dc540770011f3fc46e3d5e8947b35bc","t":"그래. 밤늦게까지 깨어 있지 마"},"481:1":{"lh":"6b00c518","m":0,"g":"05304324080bbf4c4952d7c4edc3f8331339fc51b856218a83034090a21046e7","t":"너야말로 늦게까지 깨어서 기계 만지작거리지 마!"},"496:0":{"lh":"da8a0bfb","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"498:0":{"lh":"b1fd27d1","m":0,"g":"7a621b8bb871f50df85103e954103a98d2141ff56b1a6f8f174af5030810e472","t":"쥐 죽은 듯한 정적이 찾아온다. 방음 처리라도 되어 있는 걸까?"},"500:0":{"lh":"62d42c0e","m":0,"g":"27fb7839c011f39203f273caafe82a2861ef2163252456920109c374cec3fda0","t":"낯선 방에 혼자 있자니, 마치 홀로 남겨진 듯한 착각이 든다. 이제부터 