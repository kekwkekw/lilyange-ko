e769d31278065d1f35a26029c855f90a3411ebc536cd373d4f5334","t":"소리 내지 마. 칼이다. 알겠지? 내가 조금만 힘을 줘도 넌 바로 죽어."},"116:0":{"lh":"a1208a31","m":0,"g":"470dc6806b7ab4ee643fda024764924eff47a95a993af796519e35a9bfda7439","t":"식은땀인지 눈물인지 모를 한 방울이 뺨을 흘렀다. 그래도 아이는 거의 반사적으로 몇 번이고 고개를 끄덕였다."},"118:0":{"lh":"7aca8b80","m":0,"g":"35136dd041418b1a1dc5e4e5059d379e67b4e7a662ec5446f331618ffec5020a","t":"나도 굳이 널 죽이고 싶은 건 아니야. 그저 네가 들고 있는 자루에 볼일이 있을 뿐이다."},"120:0":{"lh":"7b4e83cf","m":0,"g":"7d4e6007dd4340e3f6526c1ac8f721dd77259898407c05cf57a496bd15844afb","t":"아이는 자루를 쥔 손에 저도 모르게 힘을 줬다. 넘겨주지 않겠다는 의사로 받아들여질까 싶어 황급히 힘을 풀었다."},"122:0":{"lh":"f66835d","m":0,"g":"d469b8d4eb55f4fc0d59ab11d58d4d7ac1fb88f451ee26201c479b5a5a37d6ba","t":"이제부터 그건 내가 가져간다. 하지만 소리를 지르거나 달아나지 마. 조용히 열을 센 다음 아무 말 없이 집으로 돌아가. 왜 빈손이냐고 물으면 사람이 너무 많아 못 받았다고 해."},"124:0":{"lh":"2af372b2","m":0,"g":"b9a0f418079ede331a65dd8717307b1722336d28b66c6e24bae0228c49d6bed0","t":"그렇게 말하며 등 뒤의 남자가 자루에 손을 뻗었다. 아이는 아무것도 할 수 없는 분함과 부당함에 얼굴을 일그러뜨릴 수밖에 없었다."},"136:0":{"lh":"835a48bb","m":0,"g":"d8c2ba952c8dee17b559794f10a85e6340222e5db9283580f7653f3e41c69651","t":"이렇게 될 것 같다고 생각하긴 했지만…… 어라, 이 대사 아까도 했군."},"149:0":{"lh":"dd332c0b","m":0,"g":"dff37a1c56f5e37baffa4db78199ff40c22d82c5c1a7a907cdfebbe86d06c9d5","t":"…………！"},"151:0":{"lh":"899a37d6","m":0,"g":"778917c9d59a8cc8ddaf6c8b61300521837c672ca8b215a227441f1e3ce4bc1d","t":"너, 너희…… 아니, 당신들은……"},"153:1":{"lh":"f72dae13","m":0,"g":"d65166cc786654780e2d42cf1229857946ba42616fc2e6cf06f5dd7e1f65d72d","t":"당장 살아가는 데 부족함이 없을 만큼 물자를 나눠 주었는데도, 역시 남에게서 빼앗으려는 자가 나타나는군요."},"155:0":{"lh":"9605d91","m":0,"g":"383e94d2bee030af2f34f09355a71709c4a22cd0864dd1ddd155a5bc6e716bcb","t":"차, 착각하신 겁니다! 저는 그저 이 아이가 무거워 보여서 대신 들어 주려고……"},"157:1":{"lh":"248b60ef","m":0,"g":"b93ce9bff5493876f667c3d0d31a71edfb825ea36b1d1e8acc750c741519ccef","t":"이 행사를 위해 여러 대책을 해 두었다고 말했지? 물자에는 그것을 획득한 사람의 정신 상태가 심각하게 악화되면 경보를 울리는 마법을 걸어 뒀어."},"159:1":{"lh":"c195e21f","m":0,"g":"3d461c8453d1c3212389076a9fcc3dcda1445e8a0d90314ec050c6fd01e5b2ab",