e929bf6d","m":0,"g":"ab1ada58fb99108d185ea6ee2dcbabdfab3851fc9a7cf3620bcbdfec0b37681b","t":"라빌리스한테는 다시 자겠다고 했지만, 이대로는 잠들 수 있을 것 같지 않다. 하다못해 뭔가 속이 개운해지는 것이라도 마시고……"},"138:0":{"lh":"a75f4f03","m":0,"g":"3f34daefbbcc1d81bac4b0e5aacf3f8808c12d5314fbaed20b1d47cea970c719","t":"괜찮으십니까, 코하루 님. 방에서 그 기계가 나가던데요……"},"140:1":{"lh":"83858a6a","m":0,"g":"55ad876b0d65d18c8a1752b6a7652f0bb2e2bda23a39dbb31d0fb961fdfd2fbc","t":"시즈쿠! ……잠깐만 기다려."},"142:0":{"lh":"b08d6ccb","m":0,"g":"9728f1d6c4276a74569cbdd3717397dc7f40e1f60c177e2a1ad0089847e4d20b","t":"다시 땀을 닦았다. 옷매무새를 가다듬고 가볍게 헛기침한 뒤, 이어서 대답했다."},"144:1":{"lh":"9323760e","m":0,"g":"7cf6c0555ebb2fbeda24d10d615df5f0ea9b980d7dc2e1b2f6ddfa9c8c04b574","t":"들어와도 돼. 꿈자리가 사나워서 내가 끙끙 앓고 있으니까…… 걱정돼서 왔을 뿐이라나 봐."},"150:1":{"lh":"bb7fc2d","m":0,"g":"64838202375a494282dabf540fb75cdeb4a9c74d2590e1ca69cb452b197d7599","t":"실례하겠습니다. 꿈……이라고 하셨다면, 역시 그 악몽은 그 기계의 소행입니까. 가서 목을 조여 놓고 오겠습니다."},"152:1":{"lh":"762902c2","m":0,"g":"0580f9ce02d6dd8a195d05d3e3601a04d358eed5706d5df95bbffe90d085b4f3","t":"아, 이미 물어봤는데 자기가 한 게 아니래…… 다른 꿈을 보여 줄까 묻길래, 왠지 무서워서 거절하긴 했는데……"},"154:1":{"lh":"5c01bce7","m":0,"g":"ab52facc3f9d415edb51ab52f871d81672ae54852e45a50bc6cc2da334a24b88","t":"그렇군요…… 그러셨습니까."},"156:1":{"lh":"8e58334e","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"158:1":{"lh":"c3a2871a","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"160:1":{"lh":"6cff9d9a","m":0,"g":"c16d47d570374e0c00b26a4708394f206d8c19f1b7fdb70c121458bba57117f6","t":"저기…… 괜찮으시다면 말입니다. 고통스럽고 힘든 기억은 누군가와 나누면 조금은 가벼워지는 법입니다."},"162:1":{"lh":"ec486c68","m":0,"g":"60669ccfbcbded090c1265f242c6097d7a2a3ca739463c824259602eeecad149","t":"저 역시 루미나 님께 말씀드린 뒤 더는 괴롭지 않게 된 일이 많습니다. 그 악몽이라는 것도 같은지는 모르겠습니다만……"},"164:1":{"lh":"f8e7c029","m":0,"g":"f4c70c2d7ec6e5fdbf9891ad411d9f160bd79ffb2e3ded6e0b72031628df1a6a","t":"그 남자나 루미나 님께 말씀드릴 수 없는 힘든 기억이 있으시다면…… 제게 말씀해 주실 수는 없겠습니까?"},"166:1":{"lh":"b4ef7abd","m":0,"g":"b5999fb8c439aedc310