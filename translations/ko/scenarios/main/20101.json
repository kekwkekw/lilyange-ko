{"script":"20101","fragments":{"28:0":{"lh":"c2ccc3de","m":0,"g":"643583555b8773be6739761364bbeaec7cb7d8b41ad58fa0506d30b6342400a3","t":"어디선가 울려 퍼지는 수수께끼의 목소리. 소리가 나는 곳을 찾지만, 마치 공간과 건조물 자체가 진동하는 듯해서 대체 어디서 들려오는지 전혀 알 수 없다."},"30:0":{"lh":"b5b1be52","m":0,"g":"439acc430d571eb51af78f78ab11e1460d607650a3c59b2925db41fb6725c61f","t":"그 능력은 본 기체가 오랜 시간을 들여 정성껏 맞춤 제작한 것. 사라져 버리면 곤란합니다."},"36:0":{"lh":"4a3ee4a9","m":0,"g":"34d23d98441ae6af644f3d6976c89da4fb98f99c6657d513044c764c553809c5","t":"루미나가 얼굴을 일그러뜨리며 이를 악문다."},"38:0":{"lh":"7b3d97b8","m":0,"g":"49769388bfe02bf76b4afcb953ac488a9b5fa3a9b458e3f2f1c8eb72d4e909f0","t":"그럴 만도 했다. 자신을 괴롭히고, 어머니를 괴롭히고, 자매들을 괴롭힌 원흉. 수수께끼의 목소리가 스스로 그 원흉이라고 밝힌 것이나 다름없었으니까."},"40:0":{"lh":"14730931","m":0,"g":"6b22cef251f4f44fb06bd2afe0e3ec62002c9fd3243db3c813c524ea08ea0901","t":"모든 것을 무로 돌리고 처음부터 다시 시작하는 건 쉽습니다. 하지만 이토록 순조롭게 능력의 농축이 진행되는 경우는 드뭅니다. 부디 다시 생각해 주시기를……"},"42:1":{"lh":"8c98711e","m":0,"g":"0da4c7be9fcbe25a1a791749f26cacb4ecad2b5352bc4335a3483ce7caf629a0","t":"당신은……대체, 누구……야!?"},"46:1":{"lh":"7822f9d8","m":0,"g":"1d519aeafa7693ed65dd498dfd151307b630c50d084b353440b0c863d5b5ec4b","t":"루미나 님……! 위험한 상대입니다. 최소한, 저를 사이에 두시고……"},"50:0":{"lh":"c98c8c07","m":0,"g":"a6ab9de9fee7cd19907c4f195672d97deb59da3221347e978290bd318402ae70","t":"루미나는 말없이 고개를 젓는다. 시즈쿠도 입을 다물지만, 아까보다 루미나 쪽으로 더 다가섰다."},"52:0":{"lh":"3b024c2c","m":0,"g":"65d79a74bff948b0fe62e536c7c5833a9d7c6dddf07647763b50298750656e53","t":"잠시 침묵이 이어졌고, 모두가 수수께끼의 목소리의 대답을 기다렸다."},"54:0":{"lh":"8c7f070e","m":0,"g":"8b5a5cae8a7f55f1dbcc776c36f04fdb18374eaa541ec2b35720abcef82adc76","t":"……본 기체는. 그렇네요. 모든 것의 시작입니다."},"56:0":{"lh":"4a8ff46a","m":0,"g":"9d2da282335dc32a1278426f17ebf55dc27809e6be760f500c0f6c4da799fc7c","t":"모든 것의 시작……?"},"58:0":{"lh":"8b139c61","m":0,"g":"1b08df36aa1b40af810000b21f85bd324ce9f07d4415c3120f6b7867b985a4ec","t":"요점을 알 수 없는 대답에, 절로 눈살이 찌푸려졌다."},"60:0":{"lh":"d2575ceb","m":0,"g":"ba51ca4791648690f547d59e19d1ce0913def9cb6f72945ff843f108ef93ba52","t":"‘하위 기체’, ‘본 기체’라는 말로 미루어, 기계……AI 같은 존재라는 건 짐작할 수 있다. 그런데도 기계답지 않은 모호한 대답에 초조함을 느꼈다."},"62:1":{"lh":"e87adabc","m":0,"g":"087be45d3e24791e1ce389166b9af2dbce655d7480185f3064e561f90a17a397","t":"목적은……뭐지? 나를 조종해 수많은 사람을 괴롭혔어. 그 결과, 당신에게 무슨 득이 있는 거지?"},"64:0":{"lh":"f9b78c","m":0,"g":"51b3962e949f646e25c66988dba33b95be91a9e784b89751685f5ab587c7dc3c","t":"괴롭혔다고요? ……아아, 그렇게 받아들이시는군요. 죄송합니다. 수명이 짧고 사고의 척도도 작은 인간이라면 그런 감정을 품는 것도 이상하지는 않습니다만."},"68:0":{"lh":"707cb560","m":0,"g":"f86838d81eea7e266645fccff52c40e8b8b0dfa8aaba58f47bbcc95f70fd966c","t":"본 기체는 인류의 편입니다. 모든 일은 인류를 위해 하고 있는 겁니다."},"70:1":{"lh":"d3208031","m":0,"g":"af0797a71c486bc8cff77da795f88f270fb82ed68923e6272f0426142258b697","t":"인류의…… 편? 인류를…… 위해서?"},"82:1":{"lh":"5423a068","m":0,"g":"e11ab018f1e50c51928c7e5e0af4bdfbee310b2060b4d9ec1a43ffac9eeb7d35","t":"인내가 필요하겠지만, 다음 별에 기대를 걸고 처음부터 다시 시작하자. 이 별은 파괴하겠어."},"102:1":{"lh":"4c6dfb35","m":0,"g":"b902787de5c0baca87d105597a98d8d80ad89d6efc2ebff97a4d017c98fb5bc6","t":"『이제 됐어』란 말, 하지 마!!"},"126:0":{"lh":"9510c99c","m":0,"g":"08f0a8485db973f261d79c31cd9b4d373911fb3e137ef9d9df3c10f947ecc151","t":"……웃기지 마"},"132:0":{"lh":"19d51def","m":0,"g":"38bac6b93c8c5ff72dec3cea4ba70b6fd51deff3ef8cdb52e1b24fd5315fcdcc","t":"넌 틀렸어. 뭘 하고 있는지는 모르겠지만…… 네가 한 짓이, 루미나 일행에게 한 짓이 인류를 위한 것일 리가 없어."},"134:0":{"lh":"444042fb","m":1,"g":"e6272a8408cd2f03fcb7506b53938465544a3eac40a248f3fe169f1c3bdc9860","t":"루미나 일행이 지금껏 입어 온 피해가 {PLAYER_NAME}의 뇌리를 스치자, 자기도 모르게 거친 말이 튀어나왔다."},"136:0":{"lh":"e65cbc21","m":0,"g":"978446a7370b7917c92cbf983588e07447032e4465c38fda8b1a7c0498f24933","t":"목소리의 주인이 화가 나 무슨 짓을 하지 않을까 긴장이 감돌았지만…… 짧은 침묵 뒤, 수수께끼의 목소리는 변함없는 어조로 말을 이었다."},"138:0":{"lh":"9618ca21","m":0,"g":"d5abf0898b45eb3677cb642f7584fe976c70719bc5a05a78bdddf653a1e6b945","t":"……그럼, 본 기체가 옳다는 것을 당신들에게 가르쳐 드리죠."},"140:0":{"lh":"5abdf354","m":0,"g":"7d9747b0d06f33f1d6f0900ff52fff545c799954e792e8376447b73c05147aa1","t":"뭐……?"},"142:0":{"lh":"b7e382a3","m":0,"g":"295ef182beba3c967424904b3b73fd461f678eea1702370aa9dd9cee0e027d2d","t":"당신들이 변방의 별이라 부르는 별로 오세요. 지금까지 온 길을 되돌아가듯, 같은 별들을 차례로 거치면 됩니다."},"144:1":{"lh":"6382b033","m":0,"g":"c8014a384a22ba6d1d2fbd5d4e985370a29e15a6510d5b8839622160aba78d41","t":"그건……"},"146:0":{"lh":"540a6e4","m":0,"g":"b458ec8e81a4b5ffde25ee13bc8091c19198f0afb840c21e0ed75ae654d47aed","t":"본 기체는 이미 당신들의 여정을 파악하고 있습니다. 도중까지는 데이터를 확인했고, 그 뒤로는 직접 감시하고 있었습니다."},"148:0":{"lh":"74116c9c","m":0,"g":"8e90acd901bf204181719f3ad68e98d0eb1f6f67642be4331477a361c739b6b2","t":"……아……!"},"172:0":{"lh":"9da32f8","m":0,"g":"1b0baaaa54217a81676aa40daa3e138f8e9dd31d5d697ec7c4f9dc6339ef402b","t":"(그때 그 목소리와 똑같아……!)"},"174:0":{"lh":"5d1555f0","m":0,"g":"ea5ae3e025ccae05adf061aee0e82ce832420cefd3a949f5826f5426880c431b","t":"지금까지 여러분이 거쳐온 별들에서, 본 기체가 인류를 얼마나 이해하고 있는지 증명해드리겠습니다."},"176:0":{"lh":"263f4cbb","m":0,"g":"f8a299a1a18df27b1524dc2532d4cd7768406dfd84dbaab4852b77502cba0e4d","t":"그리고 본 기체가 옳다는 것과, 본 기체에 거스르는 일이 얼마나 어리석은지도. 그 몸으로 실컷 깨닫게 해 드리죠."},"178:1":{"lh":"e721bb13","m":0,"g":"40a679e7d1f4dcfae1d8400ca6c211795a48f21dbd142f8ad54f77e3f8b7100b","t":"기다리십시오! 대체 무슨 짓을 했고, 앞으로 무슨 짓을 할 생각입니까……!"},"180:0":{"lh":"9e10282d","m":0,"g":"22824f73318ff5d76207ba593062e0b517c66a256169d0338eae1bb9b346aaa3","t":"무엇을 했느냐고요? ……글쎄요."},"184:0":{"lh":"4035528d","m":0,"g":"f139afeea941b75a0e6a5f1254e5d8e378c1c561312dd637c47086b35cd97e5b","t":"전부입니다. 전부 했습니다. 앞으로도 하겠지요."},"186:1":{"lh":"85823b58","m":0,"g":"02a6f418a249143fbb49558f31b1c742f7e84f247f02677ee9c571b0309e03df","t":"뭐……?"},"188:0":{"lh":"6affecab","m":0,"g":"b7398008fe4c0b97a371f12dc5a7c72610cc63772f6f862302569629da62d9e0","t":"그 후 잠시 목소리의 반응을 기다렸지만…… 이전의 침묵과 달리, 이쪽에서 무슨 말을 해도 아무런 반응도 돌아오지 않았다."},"196:1":{"lh":"4dff21c4","m":0,"g":"fd31d26e76f1e522cd5e21a2be03bfdea12db87e78b8d6473ced8ab96077b35d","t":"방금 그 말은…… 그러니까, 지금까지 지나온 별에서 무언가를 할지도 모른다……는 뜻이지? 아마……"},"198:0":{"lh":"8ce2904a","m":0,"g":"7d4a42accfaf357db47e572f38e6a492a114824912a9f1785abc6886be5c8688","t":"……지금까지처럼 기계를 이용해서, 무언가를……"},"200:0":{"lh":"8c67251a","m":0,"g":"9edf912e16f89809cfbb5c76adb479c976578bbb585652795dfb4db8a8cd1ca1","t":"그동안 방문한 별들에서 때로는 파괴했고, 때로는 회수했으며, 때로는 찾아내지 못했던 수수께끼의 기계. 아마도 방금 전 그 목소리의 주인이 관련되어 있을 것이다."},"202:1":{"lh":"540b0959","m":0,"g":"b1336d2004126831a52f60ac131b58d91c208c8eca047a428cca1cb67964d65e","t":"성의 AI에게 방금 그 목소리를 분석하게 했지만…… 어디서 들려오는지도 알 수 없고, 과거에 기록된 적 있는 목소리도 아닌 모양이야."},"204:1":{"lh":"40b21fc","m":0,"g":"9e8ab936698bdd8e4add92d69dc1a9e518fcde9d84d01e51d25023731c98d161","t":"만약…… 다른 별에 이 별과 같은 피해를 끼치겠다는 거라면. 기술 선진 행성의 대표자로서 다른 별의 문제에도 대처할 의무가 있어."},"206:1":{"lh":"5971bf98","m":0,"g":"f25fe35dd061991dec23a93ee1d27855a66564d621f526ea40f596faf7646eed","t":"이 별과 나에게도 어느 정도 책임이 있으니까……"},"208:1":{"lh":"388c9a88","m":0,"g":"9fdf4cac3efceec11fd870f483291d3b08d074e05cb6f51cba8b1958789d7bb4","t":"응…… 지금까지 알게 된 사람들에게 위험이 닥치고 있을지도, 몰라…… 가야 해!"},"210:1":{"lh":"33a80b7","m":0,"g":"9cd7cc6cb6fb8aa7e98880473a543029c18cecf33affa9bfe8f20572f24a1edf","t":"루미나, 안심해. 엄마도 같이……"},"214:1":{"lh":"4202daa5","m":0,"g":"7c094ad166a9341255a5af2e62c3e5d467a5d6c442b3ba9149515ef9ca4af2f6","t":"윽……"},"218:0":{"lh":"e7dacfcc","m":0,"g":"de38222ee585314680c748619d208bd7bb37b5f3f56d6fe660129514a5fc5b6b","t":"레지니아가 무릎을 꺾으며 바닥에 웅크려 앉았다. 안 그래도 무리해서 대관식에 참석했는데, 한계가 온 모양이다."},"220:1":{"lh":"e6997b41","m":0,"g":"8513c2dfb6aa2175ab38ae0e1877e46464e2189efd61bd157746388b64af6a24","t":"엄마, 무리하지 마……!"},"222:1":{"lh":"dad1d42f","m":0,"g":"39c5e9e038f1fc9965eebb2fb79c7137ae4a8f785dfc8e8f1cee88f1af1d10af","t":"……괜찮아. 지금까지 폐를 끼친 만큼, 조금이라도 루미나 일행을 도와야지……"},"227:1":{"lh":"4b489008","m":0,"g":"1f3d021b94555c3215b2d9cce61b3c4354a2e7abb55090cad365e915280dd9fd","t":"외람된 말씀입니다만…… 끝과 시작의 별에도 아직 문제가 산적해 있습니다."},"229:1":{"lh":"9e220b58","m":0,"g":"abc754466800e8b048b0f8fa2e23e31606579cfceb422b53e5720018b47071dd","t":"체제가 바뀐 여파와 여왕님을 조종했던 능력의 영향…… 대관식을 치르며 다소 안정을 되찾았지만, 아직 이 별은 혼란에 빠져 있다고 할 수 있습니다."},"231:1":{"lh":"ee29dd55","m":0,"g":"c931b5b96cc383af87781fa7788a5a2486d8e793260e67c18eb8bb0c342203a6","t":"루미나 님께서 이 별을 떠나시고, 여왕님마저 떠나신다면…… 설령 그림 님과 그레아 님께서 계신다 해도, 감당하지 못할 문제가 생길 것입니다."},"233:1":{"lh":"a956ea79","m":0,"g":"fa021ececd454abd2a312d3a36d14e55913e973469cd685bd2f11a01ab245ddf","t":"본래라면 군도 동원해야 합니다만…… 복구 작업도 있고 인원도 부족합니다. 지금은 그럴 여유도 없겠지요."},"235:1":{"lh":"8a376047","m":0,"g":"e1571ff44eee4e1446fc6a470d891cdb0cf696b8b1e44e2053d529e673eed1de","t":"하지만 이런 위험한 일을…… 루미나와 너희에게만……"},"237:1":{"lh":"2d33e187","m":0,"g":"ba0afa204ecf18eba36f6d28204df947722fb698b1a4af042b92d19f55b9cfbc","t":"엄마, 괜찮아"},"239:1":{"lh":"3c1b6219","m":0,"g":"ce2f095fb974d049fefe4558747b7a5fa7e882659f87286aec39f2c8167f902b","t":"루미나……?"},"241:1":{"lh":"15b7ebe4","m":0,"g":"616fc262fb49f6d55b505af576bc77c473359cc0d1438e317c73e73f4c364daf","t":"왜냐하면 나…… 친구도 아는 사람도 많이 생겼는걸. 무슨 일이 생기면…… 다들한테 의지할 거야. 그러니까 괜찮아."},"247:1":{"lh":"379630d5","m":0,"g":"ef1d298c91ccf58347e0415d75ec71dc4a78957f233e0ab1a46c90c8d9d4e30d","t":"루미나, 강해졌구나. 정말……"},"249:1":{"lh":"aff01c3a","m":0,"g":"bde334e4d9a1da10e0926d1cb9cdad83b780b4a35266d93ebf59f3c364f00418","t":"……헤헤……"},"251:1":{"lh":"11764e9d","m":0,"g":"09112388860d90272a2251f128e202075ebb4969b3f598b81ccf8f069743df88","t":"그래도 정말 위험해지면, 엄마도 반드시 도와줄게. 계속은 무리겠지만, 언제든 엄마한테 의지해도 돼. 알았지?"},"253:1":{"lh":"e0bc4dc6","m":0,"g":"ece748c4d2718a225b18ade0a2e991e72ec3f2ca686ddf51602b51b4621a118f","t":"으…… 응. 고마워……"},"255:1":{"lh":"6c0e48a9","m":0,"g":"390a23614632d229b57aa823d121587b29c206f340bd50f5308127213321c47f","t":"그럼 앞으로의 일을 논의하죠. 우주선으로 돌아가, 예상과 대책을……"},"258:1":{"lh":"7b026b23","m":0,"g":"9d4c760302657adbb7763f37c4dc7bf1994c905da1a519d18657346ae92978d9","t":"그래♥ 가자♪"},"260:1":{"lh":"d9bfd6f5","m":0,"g":"2196d5d463c1d5be896eccf1e40ad6c6ed708234923d57ecfa749b7e74f56d09","t":"……여왕님께서는 의무실로 가 주십시오."},"263:0":{"lh":"fba9ac84","m":0,"g":"3180997bfe7244a9623b3175196fbc2a2541fd62e6e96d5c95f5abd4aa130177","t":"언제 불렀는지, 복도 저편에서 의사가 허겁지겁 달려오는 모습이 보였다."},"265:0":{"lh":"283a86e0","m":0,"g":"7ed94495b5cf33c67e527d47852c2083501d360f8e25da93ce0c96ef5e64d0f5","t":"그 모습을 보고 체념한 듯, 레지니아는 입술을 삐죽이며 어깨를 늘어뜨렸다."}}}