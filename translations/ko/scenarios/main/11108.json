f8f313cf","m":0,"g":"47de4014ef9907b57422d35427e70832dde2903588f4fffdb5edec0e4376e5c1","t":"괜찮다니…… 무슨 뜻이야, 루미나?"},"217:1":{"lh":"807ef3ab","m":0,"g":"6c68dc6ad240c63231237517667013fac8b9c2812645794c67d185afac4e7d2f","t":"길이 없다면, 밖에서 들어가면 되니까……"},"231:0":{"lh":"54d0418c","m":0,"g":"9acfae4ff218a688ca44b00ec7b87ddbcc6ed2c3e1a640181b316f725955ec3c","t":"루미나의 발밑에 빛의 판이 나타난다. 조용히, 천천히 루미나는 허공으로 떠올랐다."},"233:1":{"lh":"17a0efd5","m":0,"g":"2bd6e752dbbd783ef451407d295a1a47302896f9eafacf8c852e2422e69b40e1","t":"안 됩니다, 최고 수준의 보안이 걸린 여왕의 방에 밖에서 접근하시다니…… 너무 위험합니다! 하다못해 소형선을 준비하면 조금이나마 장갑이……! 제발, 저를 데려가 주십시오!"},"235:1":{"lh":"962aac4a","m":0,"g":"7513b6f2ab46fd0785fd0fc978b43707a0bea99a0a6b7af4d5e43fadf5578114","t":"준비할 시간도 없고…… 다른 사람을 데려갈 여유도 없으니까…… 나 혼자, 갈게"},"237:1":{"lh":"cdb60639","m":0,"g":"303e4c2873f7ab6396140ee3dad66f16faacedbb555f1bfb7fd2a9eea30191c8","t":"아무 의미도 없을지 모르지만…… 어머님을, 막을 수 없을지도 모르지만……"},"239:1":{"lh":"2d7a12f6","m":0,"g":"af85b1a0eec6b3c0ebc68a124d44e76820256160c2439ae64af8755ccc7c8bbd","t":"그래도, 할 수 있는 건 전부 할 거야. 어머님이 조금이라도 제정신을…… 되찾아 주시지 않을까…… 해 봐야 해."},"248:1":{"lh":"96a683ae","m":0,"g":"1b47405387dd27247211e8f0d2c516def1f88cf0142c7e003404e78bddf1fa1c","t":"루미나 님!"},"250:1":{"lh":"717503ad","m":0,"g":"c4b764baed956fe5802fdcfa539c20d1099a05d583ccb38f4b31c21e7ca6e2ff","t":"어, 어떡하지…… 우리는, 뭘 해야……!?"},"252:1":{"lh":"9c85ac14","m":0,"g":"5206831dd75fb9c7b7519a84411bcf35eff481ee0d419ee0677382fa5817e08b","t":"정해져 있습니다…… 수리가 끝나는 즉시, 통로를 통해 여왕의 방으로…… 늦는다 해도……!"},"254:0":{"lh":"99c40817","m":0,"g":"bb9c17b1c64c18fc3c60f419936654bd6c2ba9cc9a68f11e0d00d9920839261d","t":"어, 어이……! 무리하지 마!"},"256:0":{"lh":"70c52959","m":0,"g":"a7df54f21d5b0dc10d92d0b13dbe8a05e4e3dbc51275d2da2c2789bb3fceefd9","t":"시즈쿠도, 코하루도…… 그레아와 그림도 만신창이다. 간신히 서 있기는 하지만, 무릎이 떨려 금방이라도 무너져 내릴 듯하다."},"258:0":{"lh":"341d65e9","m":0,"g":"5b62f6237f9841c4efe888b585b079a128d78600e0a39558f23ba1d6c9c8f5e3","t":"내가…… 이번에야말로 루미나를 구해 낼 테니까……"},"272:1":{"lh":"c62ce1c7","m":0,"g":"e6bf9fdc338abf29438e69ce7659cb9b692db7302c6118dab483fdd0e607f752","t":"（부탁드립니다, 신이시여. 지금만, 다시 한번 누군가를 위해 목숨을 버릴 용기를 주세요……）"},"274:1":{"lh":"a7611286","m":0,"g":"f379a7d6240ccca66c050d5ddcaa5a7a13c4b0848480fc95c438f96ac82f6c49","t":"（아폴로처럼……）"},"285:1":{"lh":"6a3d2d02","m":0,"g":"38b433043421e2d77287418832bfb0d525501fc636ba3117dd6a3d3df05f8ef8","t":"후후…… 이제 곧, 이제 곧 끝나. 끝내겠어……! 다시 한번 처음부터, 더욱더 강력한, 영혼을 조작하는 능력을 연마할 별을……!"},"289:0":{"lh":"1107be6c","m":0,"g":"19d8ffe95197a90bfad8036cfb4167838d6801740da6eb77c15495e5fa6fa980","t":"최종 확인 시간이 지났습니다. 행성 유지 장치를 모두 끄시겠습니까?"},"291:0":{"lh":"2a694ddb","m":0,"g":"666a763737049359d1c4ed980fc9a6bb42134507b6ca6df74c72755a754cdcf7","t":"끄려면 30초 이내에 \"종료한다\"라고, 취소하려면 그 외의 지시를 음성으로 입력해 주십시오."},"293:1":{"lh":"27c6f25","m":0,"g":"5d370a3d585a9b7d0186885ec7b99d40775f5e0453dc04d946c602686d652fec","t":"종료……"},"297:1":{"lh":"7b91937c","m":0,"g":"0096f32c87a58ea03997c71717738a8e3dbd9a4f0e92bb11e32fd2bf16a83a29","t":"하……"},"299:0":{"lh":"c964f73d","m":0,"g":"f88e202c19c697f2cc9a16b388ac80cf7bbfa5ab10f6d7d3f53add8152965f1a","t":"레지니아의 시선이 창밖으로 빨려 들어간다."},"301:0":{"lh":"60d824ab","m":0,"g":"d57356ddca51b5aee40756ab385a688480b1838794ea6155f24b36b292fd30bb","t":"지금 상태의 그녀에게는, 본래라면 아무래도 좋을 존재였을 그것. 행동을 멈출 만한 이유가 될 수조차 없는, 사소한 존재."},"311:0":{"lh":"a2d1d149","m":0,"g":"4a90a2b8f8fb5a3fcd0d898cbf654a4f8a87d294ed1d6bffc1610ce9b1e69c78","t":"그런데도. 어째서인지 그녀의 눈은 창밖의 루미나에게 사로잡혔다."},"314:0":{"lh":"56f4cf3f","m":0,"g":"d3c31765a15a65432014bb7036190d4c8cccb544f0de32c087d1727da44645e4","t":"읏…………!"},"317:0":{"lh":"3a2b92a4","m":0,"g":"658db4841d5c4d6aae21a2424471ef23af266d404992e6cde7cdc66631587e97","t":"……어머, 님……!"},"327:1":{"lh":"3622d0d0","m":0,"g":"cb25dbc346ba6ec24375af0660199b558091866e1a7af5f49aaa8fb8de6396a4","t":"………………"},"329:1":{"lh":"6b6f93ca","m":0,"g":"1d034d8038cad3e6e93e373bde0a3b6929d40add7b3ba1cae70f2d51ad74defe","t":"……루미, 나, 야……"}}}