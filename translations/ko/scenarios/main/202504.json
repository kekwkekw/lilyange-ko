834913793f0be5db3728c4365e134a1851df585849a70d7311e8b9","t":"결과적으로 호위는 이루어지고 있으니 해는 없다. ……카스미는 의지도 없이 복종하는 인형인가 염려했을 정도다. 이 정도는 아이 장난에 지나지 않는다."},"265:1":{"lh":"efa15e60","m":0,"g":"ead487a09c176b6a0b4eea8e6a67548cedc880deaa0ba556d37c87c11b208883","t":"(무엇을 꾸미고 계신 걸까요…… 지금 당장 루미나 님 곁으로 돌아가고 싶지만, 임무가……)"},"267:1":{"lh":"839e2897","m":0,"g":"191213294abb41cb54b644bc43b48ce4d521df20d1cf90c1873e2b5e4a531605","t":"하지만…… 흐음."},"269:1":{"lh":"4d885135","m":0,"g":"fea14373030f77fe59b8e828b607a745b9576347d4420757e783504fbaf52ab2","t":"……？"},"271:1":{"lh":"98e56d74","m":0,"g":"ea553091f8b561f7ed927f40cdb03e291d432110563dff90cfcf8f5f165fdd0a","t":"어느 아이의 편도 들 수는 없다만, 아이를 믿고 그 바람을 이루어 주는 것이 부모의 역할. 호위, 내가 맡아 주지 못할 것도 없노라."},"273:1":{"lh":"6ff4b3fc","m":0,"g":"21a9f34eacb52d4cb46e78df5c2aada5a5a50bbcc7f603da2f380d141ac8fec3","t":"그…… 그러니까 로아 님의 호위를 永虚 님께서? 괜찮으시겠습니까, 그런……"},"275:1":{"lh":"c30b4087","m":0,"g":"08987b7cf3238d2468a1c33d3720365936fdc757910143cd36b7f7147ceaf54f","t":"다른 자를 불러도 좋다. 그때까지라면 그리 오랜 시간도 필요 없겠지."},"283:1":{"lh":"600b1176","m":0,"g":"cea4fea1a5fb76aafdd3dc2439e8554a4a59931547e398683535fae73da31d2a","t":"하지만…… 물론, 대가가 없을 수는 없지."},"287:1":{"lh":"c2a0dbd7","m":0,"g":"dff37a1c56f5e37baffa4db78199ff40c22d82c5c1a7a907cdfebbe86d06c9d5","t":"…………！"},"289:0":{"lh":"5c7e6470","m":0,"g":"1d24020569a84260bf336c384f6bfeb06b2e5a3b441a670318d07c33529165c0","t":"永虚가 무기를 들고 자세를 잡았다. 조금 전까지 억눌려 있던 검기가 폭풍처럼 시즈쿠 쪽으로 밀려들었다."},"291:1":{"lh":"9b5cc881","m":0,"g":"565d6a4fff4669cddcbaa7d420382286ee329a3c5c27e688ec816ebfdb1f4f54","t":"아무 이유 없이 이 배를 떠나도록 허락한다면 카스미에게 의리를 저버리는 셈이지. 그 정신은 언젠가 보여 달라고 했으나, 지금 여기서 보여 주도록 해라."},"293:1":{"lh":"fe08fab3","m":0,"g":"c6c0e3b4f04dce95a6efbb77f081320167ee818acc364367aec35b2d9d0aa19c","t":"……카스미도 永虚 님도 오랜만에 돌아온 동료에게 가차가 없으시군요."},"295:1":{"lh":"a83a289e","m":0,"g":"dcad9c9b275d7407878bbc5e3755148be2c791c6ebcc44d7aa5a5248f18be867","t":"왕녀 아래에서 벼려진 칼날. 마음껏 나를 향해 휘둘러 보아라."}}}