":0,"g":"9ed8d7bfa289a1a516af24c2f3bca27399635316b330ca61e113bb7b89a6c115","t":"어, 어떻게 할 생각이지……?"},"206:1":{"lh":"c7943d75","m":0,"g":"9931707e819d3232c6c775243a7f83d3076333d1b11e4a226d9f26c3aeefbd6f","t":"여러분! ……먼저, 소란을 피워서 죄송합니다! 저희도 여러 가지로 예상치 못한 상황이라……"},"208:1":{"lh":"92486abe","m":0,"g":"53ee5fd120f1c325f98025b2179f0ceee6e5207d2f8f8230a4161e113c28bd14","t":"오로라가……저희가 쓰고 있는 마법은 여러분도 아시다시피 금지된 비행 마법입니다! 바로 조금 전에 연구를 마치고 완성했습니다!"},"210:1":{"lh":"bd4bd71e","m":0,"g":"e15689ea8fcb1104591bdd721bb190b0d9a21938009f134ef2ee205425b5ba96","t":"원래라면 사람들 앞에서 써서는 안 되는 마법이고, 결코 칭찬받을 일은 아닙니다만……"},"221:0":{"lh":"afdf0b96","m":0,"g":"02497d18dd399b7c53902272701423e5a9d7595be2753d968800ac134ca74075","t":"이거……괜찮은 거야? 나중에 엄청 혼나는 거 아냐……"},"223:0":{"lh":"e3632f4a","m":0,"g":"182ddba972a15c1c942878d66f4f22d0e1b27229bf070098c983065bf0d61933","t":"저 사람, 우등생으로 유명한 포니 씨 맞지? 이런 일을 벌이는 사람이었구나~……"},"225:0":{"lh":"53228ef3","m":0,"g":"92fab02df831107d36c4822e155560ddaba8f23abd0be5eaa87628c0ee74a944","t":"테러? 테러 같은 거야?"},"238:1":{"lh":"6291d0b6","m":0,"g":"ca5f49d8fe24606634504ab5b005d29961450bab907722f13b040c116ab622ce","t":"（포니, 무슨 말을 하는 거야……!?）"},"240:1":{"lh":"168aed1a","m":0,"g":"b6d5e3951db8f3793c0d8bf50f614a34944ac43d0a66191ff0af551ec45662d3","t":"（나, 나도 패닉이라고! 어, 그러니까……!）"},"247:1":{"lh":"53f5c0fb","m":0,"g":"ba5cc9e024c1658df333434a15571e3a6768575ca7b4b86e69f6bf45a87c25a5","t":"……10년 전, 하늘을 나는 마법의 연구가 금지되었습니다."},"249:1":{"lh":"18b943c4","m":0,"g":"f379d444a3c78f3bf7561222f162c0539844a10c9b6640164341a3db0f8c5c9f","t":"저는 그때 마침 하늘을 나는 마법을 연구하고 있었지만, 어쩔 수 없이 연구를 중단했습니다. 그 모습을 보다 못해 연구를 이어받아 준 사람이 오로라입니다."},"251:1":{"lh":"37a14504","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"253:1":{"lh":"abdb0fd2","m":0,"g":"e38b31ddea822253d0fb179f5eca51262b70b9ed5c07949f2e75a257530fac96","t":"마법 연구 대상을 가려내는 기준은 날이 갈수록 엄격해지고 있습니다. 정말로 연구하고 싶은 마법을 부정당해, 눈물을 머금고 포기한 학생도 많을 겁니다."},"255:1":{"lh":"8fbc85dc","m":0,"g":"4fbb272ebe3ca2516179beaf61520639efd1e8fcc329