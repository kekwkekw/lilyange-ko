61c193dcd94781b7b6c20417304e426c4b0b8128c77e50e23168b9d4b12ecbea","t":"우리가 져야 할 때가, 지금이라는 거야……? 아직 아무것도 이루지 못했는데……"},"71:1":{"lh":"c56424e3","m":0,"g":"aced27247e128fdd32ef633d7238aaef5dccaa03182ff9ae365865e6b1f1e078","t":"……저희는 도중부터 방법을 잘못 택했습니다. 하지만 아직 늦지 않았습니다."},"80:0":{"lh":"c1591ca5","m":0,"g":"ba2705a378a911eb33ea0e9412449282f9c4fe113ac1924f102a613b15640012","t":"진정한 싸움은, 분명 지금부터일 겁니다……"},"94:1":{"lh":"8c0e21fc","m":0,"g":"45d9aef38809d9ad926b32e7b3ed0056ed1cee9919d3178218ee395e9270c100","t":"모두, 귀를 기울여라! 독은 사라졌고, 독사님의 노여움은 가라앉았다!"},"96:1":{"lh":"7a4de9b","m":0,"g":"ad96ec0ee77dba64f57d89ef868d46de155864a2fdd589bc47dd778cf32b3ee7","t":"그 증거로, 지금껏 기둥이 되었던 이들을 독사님께서 돌려보내 주셨다!"},"98:0":{"lh":"ada883d6","m":0,"g":"7f25c44eb598fe40cf674fe244accd01586578f7496d52be69eb5563b20ae8e2","t":"돌아온 리리안들을 본 마을 사람들은 의아한 표정을 짓거나 떨떠름한 얼굴을 했다. 하지만 후우리가 뒤이어 한 말이 술렁임을 끊어 놓았다."},"100:1":{"lh":"330c3f85","m":0,"g":"25c2ba3665b9d18b226c88c022d3a4666034cfdf284c644145710c379ce027db","t":"하지만 리리안들에게 손을 대면 독이 돌아올 것이라는 말씀도 들었다! 기둥으로 삼은 자든, 삼지 않은 자든 가리지 않고 말이다!"},"102:1":{"lh":"69410cad","m":0,"g":"295239fb658e142035fd944e03eb32d87365f65528a3f47b24bcd79333b774f2","t":"……다음은 없다는 말씀도 하셨다. 독이 두려운 자는 리리안을 대하는 태도를 고쳐라! 그러지 않으면 이 마을은 멸망할 것이다!"},"104:0":{"lh":"f0544932","m":0,"g":"907dd5f4dc2b57c9804070487a69325d84518ec497cf898077e385bab05e8520","t":"아까보다 한층 더 큰 술렁임이 주위를 감쌌다. 리리안들도 서로 얼굴을 마주 보며 불안한 표정을 짓고 있다……"},"115:1":{"lh":"a8aa2e97","m":0,"g":"46f9b014a2f51556d58f0cfde0e024019507387a07e7eee78e59132837a40a4d","t":"……어떻게든 될 것 같아?"},"117:1":{"lh":"95bef9a3","m":0,"g":"9741a64c854804a9f0c03c65cd32dd2adc87f5f7ae934f0e487b9d29e93ec9e4","t":"바인 님의 능력도 더한 것이겠지요? 지금까지 독사님의 저주인가 뭔가로 실컷 공포를 심어 놓았으니, 효과를 볼 가능성은 있겠군요."},"119:1":{"lh":"646b0aa9","m":0,"g":"d73c9a06b88b65ab262fe149ad8bc373bc44f080fedbbefc41d923411e47af3f","t":"그랬으면 좋겠지만……역시 갑자기 친구 사이가 되기는……어렵겠지……"},"121:1":{"lh":"144f4e73","m":0,"g":"f61e46b829156ad1d1950f609715a8d0e1798d4ef59c35daa965eb48d70fbf9d","t":"그러게. ……리리안을 괴롭힌 사람들이 평범하게 살고 있다고 생각하면 찜찜하지만……"},"123:1":{"lh":"d989f9fb","m":0,"g":"feba6b0ffb08931e5758516a8ee3f5b679f5b5824b038338d1ced9fe811fe010","t":"……서로 떨어져 사는 수밖에……없지 않을까. 맞지 않는 사람들과 억지로 어울리려 하면, 서로……다치기만 하니까……"},"125:0":{"lh":"232679f1","m":0,"g":"fa324ed02e2ebedbe14a8adc16f006f2628b2cea24a561a5a1c873a0bd8c65ea","t":"역사 같은 걸 공부하면, 그런 식으로 생각하게 되는 건가?"},"127:1":{"lh":"2a94579b","m":0,"g":"b04e575e3f7e83774bc620fb8b7998691cbfb7792210a553216f290b7909994c","t":"……응, 그래. 그 때문에 멸망한 별도, 있으니까……"},"129:0":{"lh":"7cfd136f","m":0,"g":"efa5189e02942e0445d75df68bfa01af152a95453b68e5feb6b3bd5d0e3c5720","t":"그렇구나……여기는 그렇게 되지 않았으면 좋겠네."},"131:1":{"lh":"8f809143","m":0,"g":"e7eb6a6d4c8bcb8369d5ce25b5cd9050b9834ef245a41c2fa41aee925a9af3e8","t":"응, 그러게……서로 다가설 수 있는 만큼은, 다가설 수 있으면 좋겠어……"},"133:0":{"lh":"e4da2f27","m":0,"g":"9b6e8a740f7be7efa399f855bd765c7460d9ad0579728a02c974c8319f6138d1","t":"루미나네 모두, 고마워!"},"144:1":{"lh":"e94ef009","m":0,"g":"18b361f01363d47becbf3093323a50bbe77475ac4b0819f67b9204dc8b1a50f6","t":"히나타, 카시미아……나야말로 도와줘서 고마워……"},"146:1":{"lh":"25997fac","m":0,"g":"f49ceae78096c65d44b156343fe65922fbe227ef4de2458368cff9f6381c3af0","t":"나……지켜, 내어……?"},"148:1":{"lh":"95658b02","m":0,"g":"e04f0e0380509ffa5235825ffd29bb5ec11fa7679a66c745871aa44a3a38e302","t":"응! 카시미아 덕분에 모두 살았어!"},"150:1":{"lh":"a7a0d29","m":0,"g":"4ebba97b3ad6e205d51e7c7ae2c1ed6f8a8f5911a2eb67f179e5cd7299cf823e","t":"다행이아……"},"152:1":{"lh":"913b3f2","m":0,"g":"6747a7276508aba53804bfe83913fd772830280f48b0a7b75b4cc195b2b2ef33","t":"……다드, 이제 가 버여……?"},"154:1":{"lh":"e01e9efa","m":0,"g":"7bfdeae48a27cd26d5da0f0d46929e166d8c51f930f32817b6cdf2b912dbd643","t":"다들 이제 가 버리냐고!"},"158:1":{"lh":"7d40874","m":0,"g":"eac75e12017e8d96f64837b1cab1a68a008f0e37f3ff35ab003f60ee19112ebd","t":"쳇―! 새로 사람이 늘어서 재미있어질 줄 알았는데―!"},"160:1":{"lh":"a8e03b77","m":0,"g":"b016c95d95aaa25bf2644450597f710c58e2ce79ff857fa3df27b3defd0ab239","t":"……그래도 기둥이라는 게 되어 있던 아이가 돌아왔으니까 북적북적해지긴 하겠지만!"},"162:1":{"lh":"4198955","m":0,"g":"1346c6bf9d127ce2e9ad0814fadf1d056acef338d0a75e754b6390b0463aa867","t":"또……노러, 와아?"},"164:1":{"lh":"a78e0f56","m":0,"g":"364ece5d1ee225b149b0b9592e341129c9f7bbef7ca18e921269257543421793","t":"또 놀러 올 거냐고!"},"166:0":{"lh":"986d2902","m":0,"g":"689bcfa55a2078a5935471eb4e98b01c02256f0236c3bf0f7c8134fe0189c9d4","t":"응, 또 올게. 언제가 될지는 모르겠지만……"},"168:1":{"lh":"8ec57616","m":0,"g":"c3d2c347b72e65013497098aa025a982987327493bc2be9fc61b7f2ff2cd2d32","t":"……기다리, 께."},"170:1":{"lh":"2255d7a1","m":0,"g":"14097bd4ef6b455f2fc1e2fe3c599ef87384f87beb584304a5fb78ee42d3c087","t":"또 봐―! 아, 바인 님이 전해 달래!"},"172:0":{"lh":"667335de","m":0,"g":"8bdd311880d682a4eef9bb9afee48aa498320d72d9703db2e2cc60fbc37cbb30","t":"전할 말? 뭐라고 했어?"},"174:1":{"lh":"366d9756","m":0,"g":"9b36c1ea27ec420f0a1a7d509729e95ce865da4a181b49fda91013779bd0637a","t":"민폐를 끼쳐 죄송합니다. 사과도 되지 않겠지만, 무슨 일이 있으면 힘을 빌려드리겠습니다, 라고 했어!"},"176:0":{"lh":"d4755d8f","m":0,"g":"2ce88ed5e2132b39867d2e49f7990e853345d6e94042dd757994974791629b8e","t":"뭐랄까……마지막까지 딱딱한 사람이었네……"},"192:1":{"lh":"7f4ab623","m":0,"g":"3c186705b9661d6ba24e7dfe0ba7ae6d6ccc0b2282db1a120258ba0d7636f1c4","t":"부헤에~……이번에도 엄청 지쳤어―! 아무튼 목욕, 목욕부터 해야 해!"},"198:1":{"lh":"34886239","m":0,"g":"9cd8f4295e86b7f3c4945ac3c4f297c1179bdc6a2f385e465ab7d1436bf0b192","t":"응, 그러게……어제도 몸만 닦았을 뿐……이었고……"},"204:1":{"lh":"e43316af","m":0,"g":"5875ad41818d20aec9ef26efc1d400420ccb09eaaa44ac208c34e9a13d7bfbe7","t":"그렇게나 싸웠는데도, 결국 얻은 건 아무것도 없었군요."},"206:0":{"lh":"6eb4a86c","m":0,"g":"b5f8c8eea6121bf677fdbe427796fe2b4eb9f32cc0bbf17fecfa6d0c97e36564","t":"시즈쿠가 너덜너덜해진 구체 모양의 기계를 탁자 위에 놓는다."},"208:0":{"lh":"ee590417","m":0,"g":"1a6053528484629a024e3acde014885d3394cf314df79d1ac066489b1901dd93","t":"앗……그거, 망가진 거야?"},"210:1":{"lh":"caf963fd","m":0,"g":"5ea715ec4ab45a04f16af5d5a9f08211deebf488f7a1673bdcdef1d72d004f03","t":"예. 카시미아라는 리리안이 싸우던 중, 철구가 제단에 힘껏 박혔으니까요. 일단 회수하긴 했습니다만……"},"212:0":{"lh":"c865de1","m":0,"g":"85ce1bd8579bce40d6e374c4e5859e35c575eb3e033f5adf578431b3f5dd0a26","t":"흐음, 리리안의 능력을 강화하는 기계라……굉장해 보이긴 했는데."},"218:1":{"lh":"e24ea7e7","m":0,"g":"06330613e77fa0718c37e13818dfdbb97d206e0ee48d88f330528407f55891ec","t":"무사하셔서 다행입니다. ……기계 분석을 서두르겠습니다."},"220:1":{"lh":"9bebeb20","m":0,"g":"766eb436fbc24b68d5c0d172ec001f7432bd7dfa2743c7e339c53f36fabc052f","t":"앗, 아폴로. 그것만이 아니라……"},"222:1":{"lh":"6d2f53e8","m":0,"g":"439b6e1cbc6373b7ae34447d35f7a2d2185cb13d834651362e9f134cd38f4d79","t":"바비큐 준비를, 해 줄 수 있을까……?"},"224:0":{"lh":"28ac67d7","m":0,"g":"765e59643f5975e07e1fef946b564fbcd861f0b27d87eba53f281cc25ccd04ad","t":"바, 바비큐?"},"226:1":{"lh":"62ca9d4c","m":0,"g":"a39820fd0992b991fbba0bcbe56686c8704010a34ab39a91e76e6b0333e8e6b2","t":"고기를 가져왔거든. 하는 법도 공부했으니까, 맡겨 줘……!"},"228:1":{"lh":"b010c42c","m":0,"g":"74350a4e24d8fc07b2414af4695a8d9e296de61682f6fb20eb8959f0b8148540","t":"알겠습니다. 술은 드십니까?"},"230:1":{"lh":"8d4775a6","m":0,"g":"e90bcd8bb83b74332a2832d00cf000b360ee5019d134e31301b73a600ef2b497","t":"가끔은 마셔 볼까요…… 끔찍한 별이었으니, 지금은 마시고 잊어버리도록 하지요"},"232:0":{"lh":"778a4b45","m":0,"g":"89d99a05f0a7c77cabc8fe4e32610286f3685dcd1755ae3186aa5c209b1e8e15","t":"다들 기운이 넘치네…… 뭐, 리리안이니까 당연한가……"},"234:1":{"lh":"64ceb060","m":0,"g":"e8b220577cd18208fa7f14a3242c229c05dca5cfea52144c7f0ee3dd38b2d568","t":"그동안, 목욕하고 올게……"},"236:0":{"lh":"1b5e889d","m":0,"g":"3e5a768b63d86fe646476aa1dea26defe9ae0686620bbe59f20f093373ad8209","t":"그럼 나중에 다시 모이는 거군. 알았어"},"246:0":{"lh":"92a92e7","m":0,"g":"11214f7f0d1a72582646aa7e21788ae5eed80c4ca02aeabaae5e9038d4cf0a49","t":"후우…… 우와, 몸이 엄청 더럽네……"},"248:0":{"lh":"e9f313ab","m":0,"g":"0cd4837487cf2768c16e96cf8d631b16ec24d1f2dcea00b1356898955dfb2545","t":"별이 온통 늪지대였고, 마비당해서 땅바닥을 구르기도 했으니 당연할지도 모른다."},"250:0":{"lh":"a62dcc83","m":0,"g":"3d9f52ad1372e63e4cce773c87e4f339a454911a4414ab11a455390b054417fe","t":"옷도…… 깨끗해지겠지? 뭐, 아폴로가 어떻게든 해 주려나……"},"252:0":{"lh":"e8e0f11c","m":0,"g":"bceef3dc4f2cd3ebd4aed5165bc7087f4aeb1d13a634c508346fe1968c14e51d","t":"……그래도 이번에는 내가 만든 기계…… 기계?가 도움이 돼서 다행이네……"},"254:0":{"lh":"2add457b","m":0,"g":"12b7802bbcd02e84a7d3735130429d72f3431b5d711bfe1379d1c5d4b1a7809f","t":"불과 황야의 별에서 쓰는 기술과 우주 정거장 노점의 장난감을 참고해 만든 케미컬 라이트……라고 하는 모양이다. 루미나가 그렇게 부르기 전까지는 몰랐지만……"},"256:0":{"lh":"d4b75b27","m":0,"g":"a91ac616a2c28d79eabee638af2a0f204dadcf92d357ad17821be762a0a8ef2b","t":"도움이 됐다고 해도, 오래 빛나는 물건을 만들려다 나온 미완성품이라…… 루미나의 기지 덕분에 활용할 수 있었던 거나 마찬가지다."},"258:0":{"lh":"3b46f4cf","m":0,"g":"b41649de9d80e4e4750a6c1d24e1336652518d32b4ba79997eab88f982c52232","t":"루미나가 자기 능력을 알려 줬으니…… 뭔가 더 도움이 되는 걸 만들어 보고 싶네"},"260:0":{"lh":"a6020cd9","m":0,"g":"87f922936d8c9b24ca77c3917cabb2d323ec2d9931ad337413bae179ddc24714","t":"문득, 무의식중에 루미나를 보좌할 생각만 하고 있다는 걸 깨닫는다."},"262:0":{"lh":"1fcd2768","m":0,"g":"46110623429fd05d648b9006f894b79851a22dab37cbc356dd32d9a5b3333fb8","t":"빛을 조종하는 능력이라 이해하기 쉬워서일까. 아니면 도움받은 은혜가 있어서일까. 루미나 본인도 능력을 능숙하게 다루지 못해 곤란하다고 말해서일까……"},"264:0":{"lh":"cfa66772","m":0,"g":"cc16785264c87199583b8f3d25e4f2f8684b00b33d64d271e293fc8bee2f39ee","t":"이래서는 루미나의 하인이나 보좌관 같다며 혼자 쓴웃음을 지었다……"}}}