{"script":"205402","fragments":{"16:0":{"lh":"7f9e582f","m":0,"g":"4d185093db2cdc5c8363d8ddc590f48ab43c3fe476e30b4c9c9aed7bdb12cd5f","t":"우왓!? 뭐, 어, 어디야, 여긴……"},"18:0":{"lh":"60eda7f7","m":0,"g":"1e5f4395a698512ba862158f55ee73133a2f98267b4ce4cc72448c2c3b2427ab","t":"화면을 건드린 뒤 이곳에 온 모양이다. 전이된 듯하지만, 전이되는 순간의 기억은 없다. 루미나와 코하루도 그 자리에 우두커니 서 있다."},"20:0":{"lh":"4c94f2e8","m":0,"g":"253fe245155f6c75a86e2dd56cb5aa4a92b3c39a683d01ffb22d67da447116f6","t":"어라, 시즈쿠는 없는 건가……?"},"22:1":{"lh":"47881272","m":0,"g":"33a7e40ed46c5431be7e6a6bb32f17b546d8a1068ef4b180fc818ed154aae520","t":"……저쪽."},"24:0":{"lh":"ff736af0","m":0,"g":"456606bc36f0f121434360d940e4faa6a53c2617998e6e8d3668ee245607bfbd","t":"코하루가 가리킨 쪽에는 탁 트인 곳이 있는 듯했다."},"26:0":{"lh":"d78cbe08","m":0,"g":"966dc35ea644b9a101f8221c9e57da2745f3ce797a0a3a66177350dbe965cfae","t":"그래, 저쪽에 건물도 보이니까…… 가 볼까?"},"34:0":{"lh":"8635752b","m":0,"g":"433e1d5e7f58eb66e7ee54e55943e6d7d8f8dee7fdf3325feda958fd0e13b308","t":"아, 야, 루미나! 혼자 가지 마, 위험해!"},"36:0":{"lh":"3396ceb9","m":0,"g":"84509f7237dc37c85448cf5cd71075042dce1b3d06d0c47c2d9175c4f12b3111","t":"(둘 다, 뭔가 이상한데……?)"},"39:0":{"lh":"783864ac","m":1,"g":"4691aa68e97bb7da6e899c99ebe0596c04c5ee053bb98e641ed15a16f893a9dc","t":"루미나와 코하루의 상태가 이상한 데다 시즈쿠도 보이지 않는 등 당황스러운 일이 많았지만, {PLAYER_NAME}은 길을 따라가 보기로 했다."},"40:0":{"lh":"fa0bfd4","m":0,"g":"024538cf82e9dd54bef7228b40d5ad8203feb7bf9d70240fe736052e52ddb6f8","t":"깊은 숲이 아닌 데다 햇빛도 비쳐 어딘가 상쾌한 느낌이 드는 것이 그나마 다행이었다."},"55:0":{"lh":"28e0c2e9","m":0,"g":"cd2879345a2da5a3ddf8b0499c6e61a5225af2bc376b0294e6a08464ab29023d","t":"조금 나아가자, 맞은편에서 사람 그림자가 달려오는 게 보인다."},"57:0":{"lh":"918f66b0","m":0,"g":"ca20b903bb8423a044fd125687ad25976a480fe3f702e34a6de93d10f597e3ac","t":"(작은 여자아이……?)"},"62:1":{"lh":"fa0ef554","m":0,"g":"dc99237c2a9cde577abb0f576d261ae87190b2532a9ae85693404380cb555532","t":"우와아! 대단해, 진짜 여기까지 와 버렸어! 친구다!"},"64:0":{"lh":"30015eb","m":0,"g":"49956bb5f7e79457daed8d7917bbc7110992d84804df54ab41c347afd76e310d","t":"저기…… 처음 보네. 넌……?"},"66:1":{"lh":"e248536b","m":1,"g":"3830ab4ff8deba60a2e674f07696f98994a534707c6c9f5a57f9528fb9e1020e","t":"나는 니나야. 오빠가 {PLAYER_NAME} 맞지?"},"68:1":{"lh":"2fb3075e","m":0,"g":"a112374d4243fe9b41e9f77e2c439620a86f908f37e2138cd970d44252e16f75","t":"그리고 그쪽이 루미나랑 코하루구나."},"72:0":{"lh":"fdd15708","m":0,"g":"f70f48b6db48e1ad1f74d251b63ff9b991de91adaaa3266ce22d39dd15ce47c7","t":"비단 같은 금발에 인형처럼 아름다운 소녀 니나는 커다란 눈을 어리둥절한 듯 깜빡인다."},"74:1":{"lh":"80c92e10","m":0,"g":"8e72c249dee9b64c6e006ceef88028f58e025b2c04625ce4f5c78fa7a9d84b41","t":"응? 아, 시즈쿠는 안 왔어."},"76:0":{"lh":"6df4b85c","m":0,"g":"c5f9085f695df6858723b2d37f8e85d0da78bf5515536672ebb5d1d021d1ade7","t":"그렇구나……? 저기……"},"78:0":{"lh":"748f3c3","m":0,"g":"fb88f17e818146009606d20bb974c504aaa1a8478353756fb523cceead41edc7","t":"(나, 기절이라도 했던 건가? 어떻게 우리를 알고 있는 거지……)"},"80:1":{"lh":"8f8c40dd","m":0,"g":"dc7c23d229cceda4f88f799665ac0388f1c0aac3f5e5aef45cd1ffcff2ebb456","t":"학교 건물 쪽에 다들 벌써 모여 있어. 새 친구 환영회를 하고 있거든!"},"82:1":{"lh":"fa2de917","m":0,"g":"9817433d111772b702e81c2bd733496b5840ee93a04f5e98c75015524a57bd29","t":"자, 이쪽이야, 이쪽!"},"84:0":{"lh":"3568234c","m":0,"g":"b92368958525909daa3eb23e7c7689f0681d80c34cffd8c431ac021171dbfbfc","t":"야, 잠깐! 기다려!"},"89:0":{"lh":"d9561f94","m":0,"g":"26d2291ae8086200769d919ef8c996e60653e6ad424a19e7e200a16fc17871ea","t":"니나는 루미나와 코하루의 손을 잡고 즐겁게 달려가기 시작한다."},"90:0":{"lh":"608ddbd","m":0,"g":"935e066899afbd24e51d525b247585ce976a8889c117de4c99795d84d7c53909","t":"황급히 뒤쫓아 숲속에서 탁 트인 곳으로 나오자 눈부심에 눈을 가늘게 떴다. 그 앞에는 낡은 건물 한 채가 덩그러니 서 있었다."},"104:0":{"lh":"f946028","m":0,"g":"628f7ea0042559e9dbe0a8107a397184cf7ad483a8003c0a3645bed04bbf3010","t":"건물에 들어선 순간 세 사람을 완전히 놓치고 말았다."},"106:0":{"lh":"4350b11c","m":0,"g":"b7b5709527c438aed0b8baec99968499f19257783fca043f93b9cd38d466d19e","t":"루미나? 코하루? 니나?"},"108:0":{"lh":"39aefe69","m":0,"g":"7833abb525d5fdcb6ff1d0cb84083456b18c276780d2fa969eed8f1f5201b669","t":"여자아이들은 한 명도 보이지 않았다. 어른의 달리기 속도로도 따라잡지 못한 게 이상했지만, 숨이 차 머리에 산소가 돌지 않았다."},"109:0":{"lh":"c773e244","m":0,"g":"14f52d4d2703f5839a18448dec80afb9d843f330c7831e8df429fe3326c8bfb3","t":"학교 건물 안을 둘러보니 외관에서 받은 인상 그대로 낡아 있었다. 천장은 군데군데 벗겨져 무너져 있었고, 평범하게 사용 중인 건물로는 보이지 않았다."},"111:0":{"lh":"cae9c5c1","m":0,"g":"1b031d54fa8ef0a8d871723c2d47411240d03c05b20f6e0d8de89c3f8570e9b3","t":"(풍경은 아름답지만, 여자아이들끼리만 있으면 위험하지 않을까…… 리리안은 아닌 것 같고……)"},"113:0":{"lh":"faa2c172","m":0,"g":"8adca1709d1b172e5bcaa7fd97473d4eb02404d6d4e586e19254aa9862cb6590","t":"하지만…… 왠지…… 그리운 느낌이 들어……"},"115:0":{"lh":"8c02e936","m":0,"g":"fade926c2e75d7ab25c0919b6bad393bc4588c6ea4bef594d355e722e61fcb4b","t":"빛이 비치고 아름다운 초목이 자생하는 그 폐허는 무척 아름답게 느껴졌다. 어린 시절 초원에서 발견한 유적과 분위기가 비슷하다."},"117:0":{"lh":"17952be1","m":0,"g":"71a390ccd521be03ab3473091e358efa758b2e17614d85fd8ffaf75f813b0d36","t":"이 건물, 학교인 거지…… 전에 봤던 것과 비슷하니까."},"119:0":{"lh":"2dbb99d7","m":0,"g":"d1c0361c6eca5a95ce6ec653d20300a586b7e788d281651ebfe3d9095a34aa8e","t":"멀리서 키득키득 웃는 소리가 들린 듯해, 발걸음은 자연스레 학교 안쪽으로 향한다."},"133:0":{"lh":"1295fdd2","m":0,"g":"98fc871c084c2079c256ea90a25ea702acf065992733de30c7bbb929ae0590f3","t":"어이! 루미나―! 코하루―!"},"135:0":{"lh":"2d931302","m":0,"g":"f07ec311c2eb89726cda4f84c85845193735d90671c3763dc85e632600debd66","t":"두 사람을 불러 보지만 대답은 없다."},"137:0":{"lh":"268e15ab","m":0,"g":"af2661227602ae08c59a65d178ae122f9284d4f2ec9784160811ae50be68985e","t":"어디로 가 버린 거야……?"},"139:0":{"lh":"544698d1","m":0,"g":"3a3ab195a5726b334245801228d67fbb6da7733aabcb8e4836e9eed42a1ce35e","t":"무슨 소리가 들려 복도에서 교실 안을 들여다보았다. 숨바꼭질이라도 하나 싶었지만, 현실은 전혀 달랐다."},"140:0":{"lh":"f2c6ddf","m":0,"g":"1bc4aeca5c30829b5284a03afa939876049ee77cef147ba954eaa87135768c4a","t":"눈가리개와 재갈을 찬 남자 위에 소녀들이 올라타 얼굴을 발로 짓밟고 있었다. 남자는 필사적으로 발바닥을 핥으면서 소녀들의 혀에 몇 번이고 농락당해 사정하고 있다."},"142:0":{"lh":"7d79ed91","m":0,"g":"85c2df9866c3b06f727631d0d0d23147debc4c0e64dd0d62a6b24acadd312338","t":"하……, 하아……?"},"144:0":{"lh":"21507f06","m":0,"g":"81236f6c3bf203c9660096a3334007802a64e5465e0a78e168f41a29b0aacb50","t":"놀라서 한 걸음 물러섰다. 그러자 폭, 하고 작은 무언가――아마도 소녀와 부딪친 감촉이 느껴졌다."},"146:0":{"lh":"ffb25bab","m":0,"g":"ae56f546946e63bff57cc576bf118d432fb09a3aa3bb2ac3a411292a265abfe6","t":"코, 코하루야?"},"151:1":{"lh":"8c61d3c2","m":0,"g":"7698c92f449c17afadc5c6936b10f5017919c615d380b172ad0507e2a040690a","t":"어이쿠. 오빠, 괜찮아?"},"153:1":{"lh":"c52f22b1","m":0,"g":"daba0d29ed03338a549d519c8bf69fff5b859d266fa80273155ad54df2d33c9c","t":"코하루가 아니라서 미안해―. 유우야―!"},"155:0":{"lh":"327d08fc","m":0,"g":"08b7f60395522926cd83d97c226b3274ec87a2cbae4fb67accf7ff7dfe4da35c","t":"아, 미안……"},"157:1":{"lh":"dc51cb","m":0,"g":"2f271f716c3dc57ccf8c614bcac4186a74681e9f3b00682759baf5dc66cfea9f","t":"오빠, 무슨 일 있어? 유우가 해 줄 수 있는 거, 뭐 없을까―?"},"159:0":{"lh":"d0dbbf93","m":1,"g":"dcd5c7a4aa06cc3b58401fbc8925e5355c723aa1c7bfd2d0d97687f1cba7edba","t":"또다시 불쑥 나타난 신비한 소녀는 그렇게 말하며 {PLAYER_NAME}의 앞으로 빙 돌아와 손을 꼭 잡아 주었다."}}}