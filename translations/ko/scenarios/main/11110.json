50de25c67d2ac346b5866e73856d00115bbe3d503f1a3e3e79a55fa5bd","t":"그래, 그렇지. ……정말, 시즈쿠 일행도 안내해 주면 좋을 텐데……"},"238:1":{"lh":"aa307051","m":0,"g":"add289cffb5deb47cfda097d365b920101082c9dc13aa931609ff41629db66ee","t":"대관식이라 경호하느라 바쁜 거겠지……"},"240:0":{"lh":"4d2e4c","m":0,"g":"e8fee53e1d13cdfdec2e061e13d02d1b3e4fcf319813b7aaa2ed0caeceebd822","t":"아, 그런가. 그러네……"},"242:1":{"lh":"c0938595","m":0,"g":"01afe4d0c320ab8da992ab0ebd67ceb78086cdcfb8b45962ac0a43e0ee8b144b","t":"놓치겠다, 서두르자!"},"257:1":{"lh":"3fb72a6f","m":0,"g":"472f7abc6f59745973a72a1fc3194ba50606a556b59892b952726cad0e85e24e","t":"……이 별의 여왕이 된 뒤, 많은 세월이 흘렀습니다"},"259:1":{"lh":"7b793d4a","m":0,"g":"c0652b65eb529e903dfb82b8705b14d9a28b69eb76599989cbae2c3215c51da3","t":"여왕 후보는 세 명입니다. 세 공주에게는 저마다 장점이 있고 단점도 있습니다. 불안이나 불만을 품으신 국민 여러분도 적지 않으리라 생각합니다"},"261:1":{"lh":"c0e50313","m":0,"g":"f802308cbc40ec1a019ce910bb6bff2bcf7ca67a4113e2303c7a21f38904daa1","t":"이에 새로운 제도인 \"삼왕제\"를 제정할 것을 선언합니다"},"265:0":{"lh":"57fc9f34","m":1,"g":"c12d80468e1039c533d8abf231312c4b0f8c20064bc7eb9eda9c087a94bb4a55","t":"귀가 아플 정도로 커다란 박수가 장내를 가득 메웠다. 관객들이 차례차례 일어섰고, {PLAYER_NAME}과 코하루도 그들을 따라 일어났다."},"271:1":{"lh":"77abf62b","m":0,"g":"652fc964d57e02dc6f225b7053202b73ef13a4abe7f7146e8e17d3f71320a78b","t":"그러면 삼왕 중 제1여왕, 루미나께서 말씀하시겠습니다♪"},"273:1":{"lh":"932a4872","m":0,"g":"85e3a6f71a5ca7ef2fddde74300c067d43ea7de629b59e100997e86119514878","t":"（그림……평소의 가벼운 말투가 아직 다 빠지지 않았습니다）"},"277:1":{"lh":"9c5a63c","m":0,"g":"d1b129d71728c7f9c5e1ac528e6f4b59a957842640c8ee458cce057a3423bb4a","t":"……크흠"},"279:1":{"lh":"e35fdf0e","m":0,"g":"89389f435bff3813a7288a3af14139493c775f03162655184719fc0dd761e2da","t":"이번 대관식에 참석해 주셔서 감사합니다"},"281:1":{"lh":"a53dd3b0","m":0,"g":"f520fa899741d57566242d0c63abb478ff3202f669d7fd3a72259058aba04bd4","t":"왕성에서 일어난 사고로 개최가 연기되어…… 죄송합니다"},"283:0":{"lh":"cae0852e","m":0,"g":"333babbf4217f1e58089e32e1b38c1e6c275ea7c66488685dd62acd950dab548","t":"끝과 시작의 별의 여왕, 나아가 별 전체가 수수께끼의 기계에 조종당했다는 사실은 혼란을 초래할 수 있다는 이유로 국민들에게 숨겨져 있었다."},"285:0":{"lh":"eba98491","m":0,"g":"0df5dff602df198bc52eb6bc4419e4919ff25ee31a3b597acd9374a7012741e0","t":"불성실하다고도 할 수 있지만…… 발표했을 때 예상되는 참사를 피하기 위해서는 어쩔 수 없다. 조사한 뒤 필요한 조치와 배상을 차차 진행할 모양이다."},"287:1":{"lh":"d4851b01","m":0,"g":"66b3dfb91218f85233ba75a607b0f64412a096198e96abedb8f8f0d095476790","t":"아시는 분도 계실지 모르지만, 저는 얼마 전까지 다른 별에…… 여러 문화와 통치를 배우기 위해 시찰을 다녀왔습니다"},"289:1":{"lh":"b3cebaf7","m":0,"g":"e83968cfdb159d3fa0e0ea58f327dcca871765415c3f19a8d4faadb4af950cda","t":"길게도…… 짧게도 느껴진 여행이었습니다. 세상 물정 모르던 제가 배운 것은 이 자리에서 다 말할 수 없을 만큼 많습니다"},"291:1":{"lh":"936d609e","m":0,"g":"83e18716bcd517104fa73fc8ac58167cc2941f8288ff1a3d370d7146a3b82d61","t":"하지만 그중에서도 가장 많이, 또 가장 중요하게 배운 것은…… \"서로 돕는 것\"입니다"},"293:1":{"lh":"a42860e8","m":0,"g":"e22171aa2ca71be2b18e1c3416dd2bb42bff1f33a718a4cea774c8dfd7716a69","t":"인간은 실수하는 생물이라는 말을 자주 들어 보셨을 겁니다. 하지만 AI를 비롯해, 생물이란 모두 실수하는 존재입니다"},"295:1":{"lh":"95bcacd","m":0,"g":"2c2cca8defd54852133c03631649f367a342c747f9a9e45b48662acbc59003ef","t":"한 인물, 하나의 지식이나 경험, 하나의 기계에 의존하지 않는다. 모든 관점과 모든 수단을 강구하려면 한 사람으로는 부족합니다"},"297:1":{"lh":"88e12621","m":0,"g":"832b897f5df07c05261a9f3c46b5fe2b1b56cfccc2f1281f368f491c32562162","t":"그 경험을 바탕으로 이번 삼왕제를 진언드렸습니다. 전임 여왕께서 받아들여 주시고, 국민 여러분께서도 수용해 주신 데 감사드립니다"},"299:1":{"lh":"89f261dc","m":0,"g":"5ad158145d459e8e8ca9803fb13dbc71320f8f9f3dc974b128a54c8f3c529d50","t":"제가 부족한 부분은 그레아와 그림이. 그림에게 부족한 부분은 저와 그레아가. 그레아에게 부족한 부분은 저와 그림이……"},"301:1":{"lh":"f61271aa","m":0,"g":"feff7a3fd8c0c11175aecd041da41bee1db89bc12f91f855802faf735cf53847","t":"그리고 저희 셋 모두에게 부족한 부분에는 전임 여왕과 여러분께서 힘을 보태 주시기를 바랍니다"},"303:1":{"lh":"624b8653","m":0,"g":"a9b84269687ae700355930a650b31e390127b40309ce7b0eac9645a20885a02d","t":"미숙한 저희지만, 좋은 별을 만들어 가기 위해 끊임없이 노력하겠습니다. 잘 부탁드립니다"},"307:0":{"lh":"27056d2c","m":0,"g":"4a55472937b2a886f5cd9c6fb94e8ec954d11d1abd0069f0bf02ef3abb0490a6","t":"여왕이라고는 믿기 어려울 정도로 겸손한 연설이 끝나자, 루미나는 깊이 고개를 숙였다."},"309:0":{"lh":"23e548bb","m":0,"g":"ec22f6be59903bd68f322e62b2db28a08736318749eef6ad94a58488657c88fd","t":"그와 동시에 다시 귀가 아플 만큼 큰 박수가 터져 나왔다. ……그중에서도 유난히 지나치게 큰 박수는 보지 않아도 누가 치는지 알 수 있었다."},"311:0":{"lh":"9f82f49c","m":0,"g":"9a1d535e912522ca0a8e7d9f64699f903e2fe08edbec55569f8ebc84df12dc51","t":"（분명 루미나라면…… 지금까지의 노력도, 앞으로의 노력도. 믿기 어려울 만큼 커다란 결실을 맺겠지）"},"313:0":{"lh":"cf91864a","m":0,"g":"4620853cf0a7e395db26a9b19a62e1d3332a84b6fc498cae28eadcdbe516892d","t":"（……오래도록, 다 같이 지켜보고 싶다）"},"315:0":{"lh":"53cd06bd","m":0,"g":"ffe44085de79ec350b26de7fe5d489183664e55bc980b6510f50819fe06fb4ed","t":"그 결실을 가까이에서, 함께, 앞으로도."},"328:0":{"lh":"497c75c4","m":0,"g":"7249f0e00cf2b7f049e59fc5b71671e8e0aacfab207501309b8039c90bf7d2d8","t":"가깝지는 않지만, 그렇다고 그리 멀지도 않은 미래……"},"342:0":{"lh":"db76f9ef","m":0,"g":"ceee49b5160d380a59ba58cd0abd5e4fb46ee98546948207f22d3eb1521204eb","t":"올해도 이로이치고가 잔뜩 열렸네……"},"344:0":{"lh":"ad2daf","m":0,"g":"04aa3801635b42bce2321f00a07c4051436c861d1688826f766be39d4a11667b","t":"……오, 드디어 왔구나! 코하루—! 필요한 물건은 다 챙겼어—!?"},"351:1":{"lh":"e3570648","m":0,"g":"3daf70a17a447496dedc2e1ab7dd106f67b6e4ea4dc6e9179e719276150376ab","t":"완—벽해! 포션도 샀고, 네가 만든 랜턴도 가져왔어!"},"353:0":{"lh":"ad4a13b2","m":0,"g":"06fd9b53b5b1deece0135fd4c2a44bfae3e57d3d64bd430dfd84a9693c7cbc91","t":"고맙다! 어디 보자…… 그 녀석들은?"},"355:1":{"lh":"179a1dd","m":0,"g":"7e11b3f50113f1a759299268afbef8c940f4cc3f633d04e6945eeba1304529d8","t":"귀찮으니까 쉴래~ 하는 녀석도 있고, 위태위태해서 애초에 못 부른 녀석도 있고. 늘 그렇지 뭐"},"357:0":{"lh":"8d7e3e50","m":0,"g":"d72094048f1f26ea81f8725fc45c85c4c3169e60ce967513c11f4806bcaf7079","t":"그렇지…… 루미나와 시즈쿠는?"},"359:1":{"lh":"42dec17e","m":0,"g":"089f16551e8a0194ad8c83f078f13bc8cd00b6d471335900ea4c7d5be20ad10f","t":"지금 이쪽으로 오는 중이야! 아폴로가 던전용으로 의체를 조정하느니 어쩌느니 하면서 막판까지 매달려 있었거든……"},"361:0":{"lh":"df7c3ae0","m":0,"g":"b86b038842d6c549956d531cec7c6f0469124406872dadee776339b44f11e446","t":"하하……여전해서 안심이네"},"363:1":{"lh":"9e732894","m":0,"g":"4b6c3f18c8a1fc6aaa6f325ff84732d4c3cffdc2d569b97fa1dcdcb48d2456ca","t":"……그나저나, 우리 용케도 여기까지 왔네"},"365:0":{"lh":"c3217115","m":0,"g":"69bdee6a8cbe357e29dd1e20439cdb57e7fdc5e11f3e513799dd42aeb1f324f0","t":"응? 무슨 뜻이야?"},"367:1":{"lh":"301632a4","m":0,"g":"e2778997773ea15433633316cfa4bb0978731ce2baaba2d1ed8c2fd4926812cc","t":"그러니까, 다 같이 이 별을 모험한다니— 그런 걸 할 수 있을 줄은 몰랐으니까! 꿈꾸던 일이긴 했지만. 무슨 일이 생길지는 모르는 거네"},"369:0":{"lh":"e8242ddf","m":0,"g":"f7e16ee4e63fa463f1b1d5c7e92398f8427e0f39e5694b5e12182fd1a833b4cc","t":"음—……뭐……"},"371:0":{"lh":"3c2c358b","m":0,"g":"64a904dc51a5816477c3ecc8f9fe240633b9da353a3ef3f06b5693db0bb57ebb","t":"지금까지의 노력이 헛되지 않았다는 거 아니야?"},"373:1":{"lh":"785025b3","m":0,"g":"25e42729bcfe5212f1162533a25cc93f3b2ca0ce6d026a708e9db78e9fc1e32b","t":"……그러네!"},"375:0":{"lh":"c4b8d3ba","m":0,"g":"16b825cc1b208114356fd1780c7c6804780979c32c6c05114d2e10db7c52a430","t":"그럼 루미나 일행이 오면……"},"386:0":{"lh":"11bd7a74","m":0,"g":"371d38c7244a1bcfa78a8a903dfe9754fa2b2660e49d2c05879d5ac7c5ba033f","t":"다시, 모험의 시작이네"},"390:0":{"lh":"9a0a1f19","m":0,"g":"418d448ff411b84eb95a1cfbfbabbf5e5e33a4d4c00a0b605f1a2f5ab9e9e32b","t":"To be continued……"}}}