2174c446d9201bdb9aa0f45a22527f5c54d4e5bf78e","t":"그러나 그와 동시에 시즈쿠는 기계의 파괴를 끝냈다. 시즈쿠의 손에서 기계 파편이 우수수 떨어졌다."},"175:1":{"lh":"7708c014","m":0,"g":"eeba71e193aba755c3de47e5d1d3f0577886835b4900d2f4d6c49939f72a4c49","t":"어…… 어……"},"178:1":{"lh":"da54d023","m":0,"g":"64b3690547a369e78348718873712397427781cde03047dcfbe3e179bfe409cd","t":"무슨 짓을……!"},"180:1":{"lh":"c3a2871a","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"182:0":{"lh":"6ba7bfba","m":0,"g":"9308286fc2624ecc0e0bcfd9f6f82f5dfd51973b2bf2b4a4fc58ada3084ab078","t":"땅바닥에 무너져 내리는 나하트. 숙였던 고개를 곧바로 들고, 온몸으로 시즈쿠를 향한 적의를 드러내며 외쳤다."},"184:1":{"lh":"201f21dc","m":0,"g":"d52bfb3f742253b97fea41752cad5f2f72439d5b04935c55058bdd16d24c6f48","t":"당신이 무슨 짓을 했는지 아십니까!? ……이 별의 모든 인간을!"},"187:1":{"lh":"18317034","m":0,"g":"74dc3e6fd9fd701ba42ab0c03a878abf15f4490cd1eaf7d02cf30275f42eaea9","t":"당신이! 죽이는 겁니다! ……지금부터!"},"189:1":{"lh":"a627dc0d","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"192:1":{"lh":"225edb7","m":0,"g":"b1397e6c7b2c3852ab029dbb23857a60368c3647dddc23d9e6fd69549a48d490","t":"그 일에 관해서입니다만. ……진정하고, 들어 주시겠습니까?"},"194:1":{"lh":"e4d69832","m":0,"g":"a9031a9cfab465b5b29748e865ab4ce4229b2705275c7937b07b6f3a8853d205","t":"……네……?"},"205:1":{"lh":"5bc58bdd","m":0,"g":"c26c66330e3e62e51e0acb53938e6d60ff1ef3b06c4309a462ec8527b5e66dc6","t":"……제가 방금 이 별에 착륙할 때, 관측 정보와 계산 사이에 오차가 있음을 확인했습니다."},"207:0":{"lh":"4666f522","m":0,"g":"5f1f2bd766f73083af51950bdb8e260b538247fb91cf40e02b0cbbc6d6353a1d","t":"계산의…… 오차? 그게 무슨 뜻이야?"},"209:1":{"lh":"ddf30836","m":0,"g":"df56c2d5be047a509ec5555f738293ad38b9ee32aaee65a851e658d44736abe4","t":"주로 지면까지의 거리와 착륙까지 걸리는 시간의 오차입니다. 쉽게 말씀드리자면…… 착륙까지 10초 남았다고 생각했는데 이미 착륙이 끝나 있었던 것 같은 느낌이지요."},"211:1":{"lh":"c5d8e313","m":0,"g":"52f7ce7b38d63408f60e580f09250cc5e05dca22067c758d6a5b4747675fcc97","t":"가설입니다만. 대상으로 삼은 물체의 부피나 면적이 클수록, 시간을 되감는 효과가 더 크게 작용하는 것 아닐까요?"},"213:0":{"lh":"f4a1d333","m":0,"g":"4df29f0fe361c7e41a1766844135dd4291fef74cbb80277209e31bab06eab6b8","t":"……어, 그러니까?"},"215:1":{"lh":"671005f3","m":0,"g":"86a500cf00615b1daa4dba9827361c5f636d5005f6e918f771c0c9e0b0c8889d","t":"인체는 정확히 반나절 정도 시간이 되감긴 듯합니다만, 저는 그보다 더 많이 되감겼다는 뜻입니다."},"217:1":{"lh":"15deb512","m":0,"g":"778d9fe8832f9d124c0a08c97ce0d9261cb2c0685b2016dd23c5631209c85074","t":"다만, 존재하는 좌표와 그 내용물…… 마스터 여러분의 경우라면 기억일까요. 그것들이 실제로는 서로 다른 조건으로 되감기고 있다는 이야기도 됩니다만……"},"219:0":{"lh":"f80eceed","m":0,"g":"e8f931f6cec7dc2c504adf782114936788acfa6f883e4eb5fd29a2e9cc1224ff","t":"도통 모르겠군! 요컨대?"},"236:1":{"lh":"68844646","m":0,"g":"5c4abbfe44ec2b6f211cd450badb6c5f4ed043cfed8755f398c3bc76fcc0296b","t":"별의 수명이라는 것은 그 부피에 비례해 시간이 더 많이 되감긴 게 아닐까. 기계를 멈춰도 수명이 다할 때는 아직 먼 훗날이 아닐까. ……이것이 아폴로의 가설입니다."},"238:1":{"lh":"b49de0d7","m":0,"g":"0f9764b2077ac67cc4cece3b9c3bc7b20c1bf12b358bbce09aa0d5158c7d48b6","t":"그래서 아폴로가…… 별의 상태를 확인해 봤는데…… 가스가 분출할 기미는 없대……"},"240:1":{"lh":"bcc728f2","m":0,"g":"1c7d734882ba6ab477f3d400f8e0687e6b639fef00fcff83f1e346302dfbf1fe","t":"……수명이 다한다고 해도, 수백 년은 더 뒤일 거라고……"},"242:1":{"lh":"3bf5c14d","m":0,"g":"431175b54e7b3c18d75e6ec1c92e3db27beaf3c692e4be1f4c4bcee11317eae2","t":"……그런, 일이……? 있을 수, 있는 겁니까……?"},"244:1":{"lh":"d0e5a399","m":0,"g":"a5b1598edc3ee2f6142c566a5c69537f461eee5a80e5c4138ebf52fa743cf17c","t":"어쩌면 한 번의 루프에서 생기는 시간 차이는 며칠, 몇 시간일지도 모릅니다. ……하지만 미세한 차이라 해도 수만 번 반복되면 큰 차이가 됩니다."},"246:1":{"lh":"26977034","m":0,"g":"d3c99491f43c5a175bb58c2f7da0ad4ab34b3d9976528030d2559614a040d7f2","t":"그 결과 이 별은……잠시 동안이기는 하나, 위기에서 벗어났다고 할 수 있지 않겠습니까. ……언젠가는 이주해야 하겠지만요."},"250:1":{"lh":"1f1db5d8","m":0,"g":"72c04b7160fa70ebad3b7a34cfe8fc18d3971589b34761825ee84ad606ef2049","t":"…………뭐라고, 말씀드려야 할지……말이, 떠오르지 않습니다……"},"252:0":{"lh":"6eb76b9d","m":0,"g":"a48ce2e00aa194789ed5dac4ffbeba7d70cf7d5e6a23fbab6cb8776a014bd8ac","t":"넋이 나간 듯 주저앉은 채 움직이지 않는 나하트. 가볍게 헛기침을 한 뒤, 쉰 목소리를 쥐어짜 냈다."},"254:1":{"lh":"7ade0490","m":0,"g":"1a676c6c284c54996dccf8839f41f1d8dae857e04756be2e81858a308084b305","t":"……보기 흉한 모습을 보여 드리고, 거듭 실례를 범해……정말 죄송했습니다."},"258:1":{"lh":"bd530b66","m":0,"g":"8fc2266a41993385753d9a829bbcc9c45776b9e54652c8740ca78b834b5e9402","t":"이 나라를……해방해 주셔서, 여러분……감사합니다……그리고, 죄송합니다……"},"260:1":{"lh":"67da5c08","m":0,"g":"dfce245ff70adef828752b6cc205a96b75ada05febdc3f6518a7fcc0e76de37e","t":"나도……언젠가 여왕이 될지도 모르는 사람이니까……나하트 씨의 마음도, 알아……"},"262:1":{"lh":"2302ba35","m":0,"g":"1f1b21324ca295376b87db6fb76a0495b1d32c87edd2fba743121624c69364fd","t":"……여러 일이 있었지만……모두, 무사해서……다행이네……"},"264:1":{"lh":"575f96cf","m":0,"g":"c4e20bd27189607ccf5ff39af6300a9823042b88bdaf76235b2f610a485d8a47","t":"언젠가……반드시 사죄드리고……그리고, 그 은혜에 보답하겠습니다……!"},"279:1":{"lh":"837b2e8f","m":0,"g":"e836db5c2e60d6cf8fc4f89815652a0e815de46338dfb8ccb99dbedc117c251b","t":"에너지 충전은 무사히 끝났습니다. 따라서 당분간은 이대로 항행하겠습니다."},"281:0":{"lh":"f00b5c01","m":0,"g":"06c3d18eb70e673acd8ac2450f1908ddcd60f6864b91725863274f3806096bcb","t":"하아……! 정말 어떻게든 해결돼서 다행이다……!"},"283:1":{"lh":"296f90d1","m":0,"g":"341ecd64ddd4fc64a49a42fec5d7101497e18c6f62ee2c5a3f117a80dab19c81","t":"저에게는 하루밖에 지나지 않았지만요."},"288:1":{"lh":"8dec9af9","m":0,"g":"cb25dbc346ba6ec24375af0660199b558091866e1a7af5f49aaa8fb8de6396a4","t":"………………"},"290:1":{"lh":"e9ae1e62","m":0,"g":"2638e12ed4b4348e93ddf2330be23224219d6ec2f15ef3eae8e1d188966dce3d","t":"그래도……시즈쿠, 그 기계를 용케도 부쉈네? 난 당연히 절대 부서지지 않는 물건인 줄 알았어."},"292:1":{"lh":"17ea3218","m":0,"g":"bd4c5e32535eb1c8700cd241d4450a384174d1d561ead61be5b8143c1002c157","t":"비정상적으로 단단했습니다. 리리안의 능력으로 신체를 강화하고서야 간신히 해냈죠."},"294:0":{"lh":"3d2f37a8","m":0,"g":"50c591740ccc5691879e5185e800a7dddffcf8c38acc158ebb570304dd97c5d8","t":"둘이 사라졌을 때는 간이 서늘했어……"},"296:1":{"lh":"93a2824a","m":0,"g":"7ced0647fd41ce637c011889a27a7a0b7dd4c704809bd7d310237aae31f51bce","t":"나도 마찬가지였거든! ……전보다 더 엉망진창인 별이었네……"},"298:1":{"lh":"54003fcf","m":0,"g":"06599f7bdaf4ed0b1a1dea95b028bfc0180de3bb9f60dcdb4a1d6374274e642f","t":"……앗! 세일! 깜빡했어!"},"300:0":{"lh":"f0db8d9c","m":0,"g":"29ad8b65f5bcf49a6299d1da693b70d91eb42ba1f7a505b45c32b8d82dcfb24e","t":"너 말이야……"},"302:0":{"lh":"8d46d34c","m":0,"g":"28d28e5e9e24e49eaa149e7dfc425303dc72007b858e2bf7ab1bb76c77368cdb","t":"결국 국민들의 기억……시간이 반복되던 동안의 기억은, 기계를 잃었기 때문에 되돌릴 수 없게 되었다."},"304:0":{"lh":"99883125","m":0,"g":"9ac2ccc17c3f4ce39e28b62cada17bb42c64e3a33a0da9da0f24d15951921adb","t":"로사나와 서로 모르는 사이가 된 건 조금 아쉽지만……다음에 또 만나면 이야기를 나눠 보는 것도 좋을지 모른다. 믿어 줄지는 모르겠지만……"},"306:1":{"lh":"29c16c43","m":0,"g":"65f7333e2bf9deb9d5b131383e8dddb8d914eee7e1e4a66ffa1852ebb66a3130","t":"아, 그래도 정말 피곤하네. 몸 상태는 돌아온 것 같지만……아니, 겉만 그런 건가? 몸 안쪽은 시간이 제대로 흐르고 있는 거였지?"},"308:1":{"lh":"9f8d7afa","m":0,"g":"3fc1706de0cbdc9a1d0fd35cba9900514ada3682294276702574f72fbd126e6c","t":"겉만 되돌아간 것이었다면 인간들도 수명이 다해 죽었겠죠. 유지되고 있던 것은 기억뿐입니다."},"310:1":{"lh":"3e8de7af","m":0,"g":"ad4274ead1dcbb3523aa69703fbdee57b623d7ed914ffd45450b08b7b523a642","t":"……잠깐? 그러니까 영혼만은 시간이 되감기지 않았다는 거야?"},"312:1":{"lh":"7fba6f4b","m":0,"g":"632437e871f2612b1c625457c8a15c30b4b1cf4c81ecb4d018f1f8878500bf2f","t":"여, 영혼……아니, 실제로 어떤지는 모르겠습니다만. 물질만 시간이 되감겼다는 뜻일까요?"},"314:1":{"lh":"1f7a33e1","m":0,"g":"c61df92de671b4553dc61a0c1997065a88c136f5bf5588cfc29650844eb036ba","t":"그렇다면 아폴로가 말한 시간 차이?라는 걸 설명할 수 없지 않아?"},"316:1":{"lh":"94f4fa0a","m":0,"g":"41af966270d62617a5d02071ef4ac4917f432625306345cc2fea66f68133636a","t":"……머리 아파지기 시작했어. 세세한 건 됐고, 목욕하고 자야겠다."},"323:1":{"lh":"a53d5b44","m":0,"g":"0764d36e306df9ffdbc1e04f0b5fd5f2d5543ee44ad4d924ab0e3ffedf827860","t":"확실히, 이미 끝난 일이고 부숴 버린 기계 이야기입니다. ……가져오지 못한 건 아쉽지만, 잊는 편이 현명하겠군요."},"325:1":{"lh":"2e5bd664","m":0,"g":"e3b44298f40c1a88e857a731ae1606e80ad43fbb595b0f7d22ba2d826b536367","t":"그럼, 루미나 님♥ 정말 수고 많으셨습니다. 오늘은 푹 쉬시기 바랍니다♪"},"332:0":{"lh":"2e97cf8","m":0,"g":"bf844405a7fb928f5ceb1a23eac3532010cb80e158882bcd782e3079c80e4e83","t":"난 무시하냐! ……루미나, 왠지 조용하네. 무슨 일 있어?"},"337:1":{"lh":"f0a7f92c","m":0,"g":"f05215ea782b261899deda20b1f671d576afff38288b86ff4ff2c8a074eedb31","t":"……계속, 생각하고 있었어."},"339:0":{"lh":"c996d82b","m":0,"g":"039e9eacfdff07c29e50d1ca99b268be0b7c794db6439c98a575b2e1a30ad43b","t":"뭘?"},"341:1":{"lh":"80e75350","m":0,"g":"984ff5de63b9954d2c2a77474a6d183a49367461d478a656dbfde4f4fcb29970","t":"……내가 나하트 씨와 같은 상황에 처하면 어떻게 할까……하고."},"343:1":{"lh":"cadc1a5a","m":0,"g":"4a4dc2aced174bde35e4419cbf36ac4ef11b232c51a989dfd4a8a8aeecf52151","t":"별이 멸망하는 게 정해져 있고. 나만이 모두를 구할 수 있지만, 그 대신 모두가 계속 괴로워해야 해……"},"345:1":{"lh":"b737836d","m":0,"g":"8a0dbee9776f11d5c9164e2e4c125a51dfdeb68a948db40e0b0f55b96f399f52","t":"그럴 때, 나는 어떻게 할까. 괴로워하면서라도 살아가게 할지, 행복을 바라며 멸망을 받아들일지, 다른 방법을 찾을 수 있을까……하고, 생각했어……"},"347:0":{"lh":"3a859ea1","m":0,"g":"86d634ca0e54ee9d04af9679b41da9c5a5a24227146cbce5d2cea70ad43fa3ce","t":"루미나……"},"349:0":{"lh":"150e87d9","m":0,"g":"de65ae33e07265e9c298432169104a61a2de2b0a774214a7de69c60d55b7b569","t":"……뭐, 루미나라면 어떻게든 되겠지."},"351:1":{"lh":"dc50effc","m":0,"g":"2f92ffc017466e717fea3dad1e2a25aaede136ac00d4de2a063782521b96e28e","t":"……그럴, 까. 하지만……"},"353:0":{"lh":"8fbfcead","m":0,"g":"0291e48e2082196e6c8d59ae361d59a82a7c533b7197c5ccbf2ad22c322e9946","t":"근거도 있다니까."},"355:1":{"lh":"5e29fdae","m":0,"g":"58b0e970a7154805b730c7b8b8c1de11e8ba344e7e958f428d8b770162b6c66a","t":"어?"},"357:0":{"lh":"608c24be","m":0,"g":"57a89b381b6ad7582745b1adc0df3f04b077dab5d5c8b6d94cd8feba0f03642a","t":"왜냐하면 루미나한테는 시즈쿠도, 아폴로도, 나랑 코하루도 곁에 있잖아. 지금까지도 다 같이 어떻게든 해냈잖아?"},"359:1":{"lh":"75e951bc","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"361:0":{"lh":"985f327d","m":0,"g":"64b59830f32078e917405796155f21a9a646f109c1e9c7fbdbf5d2888419371e","t":"……썰렁했나?"},"363:1":{"lh":"3a0148a8","m":0,"g":"9ecd27a3abf614d8ba788171b100fa060c2cebc1837767bdbc20d4e97656a27c","t":"후훗……아니. 그렇네……다들 있으면 어떻게든 되겠지."},"365:0":{"lh":"16745a37","m":0,"g":"3104b46396d65f32fd7350cbfeb81000ccc0c479be41ef9dbaff5d313d89c4b2","t":"게다가 아직 닥치지도 않은 일을 생각해 봤자 소용없어, 소용없어! 그런 때가 오면 온 힘을 다해 생각할 수밖에 없다니까!"},"367:1":{"lh":"40342837","m":0,"g":"612b1a1fa63b170cc7f256b0cb246a2ca5cc2827cf61ca12b37df17a8d48a1fe","t":"……그러게. 응……고마워."},"369:0":{"lh":"211849aa","m":0,"g":"be3d5447549148912b9e833805c42d9b7a44ab10525f5d365586161e552f0748","t":"그럼 나도 방으로 돌아갈게. 루