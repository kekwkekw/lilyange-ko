2eed7375d3ed89ab7dc28f60328fa3ac","t":"（큭…… 『독안개를 만들어 내는』 능력이라면, 안개 자체에는 마력이 없으니 코하루 님도 감지할 수 없어…… 그걸 잊고 있었다……!）"},"100:1":{"lh":"800977bb","m":0,"g":"64c4eb75822ddb6c1c7b2fd23655a608855d7199e7316ef6201bc1e60836d012","t":"바인은 보호해 둔 리리안들이 있는 곳으로 가세요. 불안해하고 있을 테니 안심시켜 주도록 하세요."},"102:1":{"lh":"8cd63b97","m":0,"g":"da65e1638edf1b7ba64bd26fae42b830e8f34849ad0f68dabacbee6da1a03e72","t":"……알겠습니다."},"108:1":{"lh":"5b2267c9","m":0,"g":"3fbe8881eb2f9453afa11f57324aec94f5513237ff5701539239ddf142529d27","t":"그럼……"},"125:1":{"lh":"45c05c11","m":0,"g":"c2b71f769b7ef8b9b4f7e7e7183fb7cd1d2778d83845f45befbcb89f72cce00b","t":"조금쯤 사고가 생기리라는 각오는 했지만, 설마 외지인이라니. ……우리 사정은 알고 계신가요?"},"127:1":{"lh":"de9f56db","m":0,"g":"78c92ef27c2b65e99e33af842f4be6afb8e8039a4ed5ae5c4d1c31a4b7d90e7b","t":"거의 초면인 사람을 이런 꼴로 만드실 만한 사정이라니, 몹시 궁금하군요. 알려 주시겠습니까?"},"129:1":{"lh":"45c44d43","m":0,"g":"cc4728810d622b634bfec810e81e4ce25ad7478ffe018dccc91b92061576e8af","t":"여유가 있으신 모양이라 이쪽도 안심했어요. ……리리안이 차별받고 있어 저희가 보호하고 있다는 건 알고 계신가요?"},"132:0":{"lh":"e384755d","m":0,"g":"e3e6bd14ef2205829831158c12fdbe6fcb1dc5f7d863d3840a674a76c7042033","t":"시즈쿠는 처음 듣는 이야기라는 듯한 표정을 잠깐 지었지만, 곧 무표정으로 돌아왔다."},"134:1":{"lh":"7adc19d5","m":0,"g":"052b9cc12d9de2cc778aa8700e645d76aaf274b9180c40804247c5a8c35759ba","t":"그대들이 있던 곳에서는 어땠는지 모르겠지만, 이 마을에서 리리안이 받던 취급은 실로 끔찍했어요……"},"136:1":{"lh":"bf4292ff","m":0,"g":"754b8c133dcdcc20dbb60427f0244139f0f6b811ff068a69f71bda46b1ede8d7","t":"그야말로 제가 독안개로 억누르지 않았더라면, 지금쯤 리리안은 한 명도 남지 않았을지도……"},"138:1":{"lh":"e98ad929","m":0,"g":"d7fbd561aac2d6a6f5d2e245b1b5c3ddacd41d70888886a8eef141702b97905b","t":"독안개……이 별을 이 꼴로 만든 것도 당신의 짓입니까?"},"140:1":{"lh":"8303e7f3","m":0,"g":"5c0bd4b0cb89db92408c54adbc8e3fcdd27fd1852f86c9533691171fc7be4cd0","t":"그건 아니에요. 원래 이곳은 독늪투성이인 불모지였어요. 그저 밖으로 나가기 조금 어렵게 만들어 줬을 뿐이에요."},"142:1":{"lh":"80d9dc32","m":0,"g":"9b78cf0b9a92b97e9ef22c1654e6a8de3e434ac57864ccc4ebbb911e482c7cfa","t":"보호구를 나눠 주고, 위험에 처한 리리안을 ‘기둥’이라는 명목 아래 조금씩 보호하며……저는 조금씩 지금의 지위를 쌓아 올렸어요."},"144:0":{"lh":"74f96ec7","m":0,"g":"311382c0a08cfb511a208bc69aecaa3e3f8bbdc582003167a78565d470f53164","t":"그대로 다른 곳에서 살면 안 되는 건가……?"},"146:1":{"lh":"c337e273","m":0,"g":"54b5a737b03442161a72b40f7eaa9c1554e451a35021efebc1c193f1d72ebcd3","t":"갈 곳도 없고, 그곳에도 사람들이 찾아올지 몰라요. 불안은 늘 따라다니겠죠."},"148:1":{"lh":"5bcf0af0","m":0,"g":"6e5e55c694afea777b1c1139929bb15c1b2910a47ec7117f1b95e61c0d79392c","t":"우리가 바라는 건 그저 안심하고 사는 것."},"152:1":{"lh":"71b854fa","m":0,"g":"e96cc031ccb45ea82d848c72588a8448a3243ce189c686ad487d97933255dee8","t":"그러기 위해서는 마을 사람들을 전부 죽이고 리리안만의 마을로 만들어야 해요."},"155:0":{"lh":"16e488e8","m":0,"g":"78b46e2341b9105cf478409d37d3eb60432f3ea3df72ceb5c47f262f0082829e","t":"주……죽인다고……?"},"162:1":{"lh":"a0be6ab8","m":0,"g":"79c012e0db7af1fc86f8fd26040c4ce287e65cb25691a6049c033ea1f7ef1675","t":"아까 바인한테 들은 얘기랑 다르잖아! 세뇌가 어쩌고 한 건 어떻게 된 거야!"},"164:1":{"lh":"7137e1e0","m":0,"g":"c8014a384a22ba6d1d2fbd5d4e985370a29e15a6510d5b8839622160aba78d41","t":"그건……"},"166:0":{"lh":"643d871a","m":0,"g":"c309bd2adcaebd44f5674742a299fb58193574f93b10474daac0562f97db3f16","t":"후우리!"},"168:1":{"lh":"f53a1fc8","m":0,"g":"d64750afa02d0aee0c7fde54ec82f7cc58f2222149350ed569cb5299cfaf92e8","t":"…………바인. 돌아와 있었나요."},"176:1":{"lh":"a5dd7470","m":0,"g":"059335e99fb4cc3dd81b2156d84a9e6d7bbd00e6eb13a9f143e40e4baa5d87c0","t":"계……계획과 다르지 않습니까! 비보를 이용해 제 능력만 쓰기로 한 것 아니었습니까!?"},"178:1":{"lh":"f70e0a7c","m":0,"g":"a7e6a2d3bbc6b88913e3ee935a574f9e2c1c2d91792d63a4b61762cd1cd99a6b","t":"이렇게라도 하지 않으면 진정한 평화는 오지 않아. 지금 계획으로는 무엇을 계기로 무너질지……"},"180:1":{"lh":"54e099ad","m":0,"g":"546b5e290e2a96e083cc0a9e0960c8755709d2bbf7bbaa4c1f4ffea3ca4db393","t":"그런 건 알고 있습니다! 그래도 넘어서는 안 될 선이 있다는 걸……!"},"184:1":{"lh":"a24ebe3a","m":0,"g":"4fa476c682a5b06f4e5113167a37095bd240daca66acb0e1eda08d772a65d3b6","t":"바인……당신까지 희생될 필요는 없어요. 저 하나면 충분해요."},"188:1":{"lh":"d903ac28","m":0,"g":"a9746d7e2fd4480e1b37f4f41ab6f935ca3c44bad98db70f122063b1b9df4ce5","t":"수단을 가리지 않아 비난받아도 좋다고 말하긴 했지만, 그래도 이끌어 갈 누군가는 필요해. 그리고 그 사람은 신뢰를 얻고 있어야 해."},"190:1":{"lh":"304a4d3e","m":0,"g":"4634151b0bdea80db4ff9e85aba5bc05e3b6fa35195384cfc2b559cef31f055e","t":"고아원을 줄곧 지탱해 온 바인이 가장 적임자야."},"192:1":{"lh":"a87bffae","m":0,"g":"a82b90321652ed77abe05e43f4dc03304a1a229aeead7def4cce51d17c0f373d","t":"잠…………!"},"198:0":{"lh":"37cc922","m":0,"g":"3a9cd5bbee3e28699ba467749616b74b5c501434c6e4053d707a0fa4e1716faa","t":"제단 안쪽의 기계가 빛을 내뿜는다. 습한 공기가 걸쭉하게 탁해지는 듯한 불쾌한 감촉이 피부를 덮쳤다."},"201:1":{"lh":"a0dba4f8","m":0,"g":"45d67097cc6c1a53ba1fc0e4de88b0f1bda6923a78a6a0d981b4e7a26b14d815","t":"여기서 전부 끝내겠어……! 독이여, 리리안 외의 모든 인간을 녹여 버려!"},"203:0":{"lh":"c0f767f9","m":0,"g":"5ebe28bf0476b6194db0eb6f103006efddc3c8cfdec5ea9bf073d95c131233c2","t":"그, 그만…………!"},"210:1":{"lh":"c6ff626f","m":0,"g":"1b0e89421d393ca2c3a40874818458f5cac27c37eec5598f4ce4977921202b56","t":"크윽!?"},"218:0":{"lh":"b2293be2","m":0,"g":"3857248cefa7f993b1dd807a9cbade125d628075a3c258e5ea29d8b7c650acaa","t":"누군가가 후우리를 날려 버린다. 기계의 빛은 잦아들고, 독안개도 걷힌 듯하다."},"224:1":{"lh":"e6a2f12c","m":0,"g":"85144a4d377750ffcf7f45972d57c65b5ecda4cfd0d5d076e11a8459071b70fb","t":"아, 으으으윽……!"},"226:1":{"lh":"1432594d","m":0,"g":"1f04af85e129abfb9be21600533c8d5dbf29cd6af475d4662b2fcb5d6d417208","t":"아, 에에엣!"},"228:0":{"lh":"ad6d10ac","m":0,"g":"7e55f84e24e3e07c9fa2a00f9f9ef61e7791871183b34ba9b3261b8193bed808","t":"카, 카시미아……!?"},"234:1":{"lh":"2cc9dcf6","m":0,"g":"d90a1e31df83df8258da7d14657158311cdb4c17005eceb8eb37d2394c80b69b","t":"괜찮아요……!? 잠깐만 기다려 주세요……!"},"236:0":{"lh":"5f468a97","m":0,"g":"587aea763567148b26b23e165ef06a021ac42e0cb9bc966ff7b27979b3b09194","t":"히나타도! 어째서 여기에……?"},"238:1":{"lh":"ddad0198","m":0,"g":"eb8ad7a7a12118adb7df32e9f3f91ac8b13ce94ccb9edd68201367cd8ebe3b80","t":"이 안쪽에 있었는데, 바인 님이 사색이 되어 이쪽으로 오셨길래……어, 이 느낌은 마비독이지……"},"245:1":{"lh":"db973934","m":0,"g":"0b23ce0016a07ec0077f4853ef16871018381d6c77376a22668bc3652fa1d1ee","t":"이걸로, 어떠려나……!?"},"247:0":{"lh":"8df05419","m":0,"g":"544936d05d6eba91554534cc0c26415dcce4d6c227403d7a15b2fc8a16975d0c","t":"히나타의 주위에서 하얀 꽃잎이 흩날린다. 잠시 시선을 빼앗기지만, 꽃잎은 이내 사라져 버렸다."},"249:0":{"lh":"98