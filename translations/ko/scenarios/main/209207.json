{"script":"209207","fragments":{"14:1":{"lh":"50caa57a","m":0,"g":"731a3921a3da0cf530700eb7a4908386b9da2b3c9f7ec6fc64a729c4bde1853b","t":"관리인과 그 딸……이라는 건, 즉 안네 님과……"},"18:0":{"lh":"b930575b","m":0,"g":"05cbc8764dec4595cee954fa29b406858f4d2be84514537901f6df25325f5141","t":"(『농담이다』라며 부정해 줄…… 터, 였지……? 그 말이 없어……?)"},"20:0":{"lh":"c0925c0d","m":0,"g":"d6e8fd3dd154d4ae9ac9cd2d743b74b02a04c5d4aebd6d03313eba21a03c2cd6","t":"(그렇다는 건, 정말로……?)"},"22:1":{"lh":"29abd60e","m":0,"g":"31b5a5267501b916c83510ba98ec2205c726e29f9561812228b75bb4643aa125","t":"어째서, 그 사실을 제게 알려 주시는 겁니까"},"24:1":{"lh":"c8517457","m":0,"g":"297154501db34000433b0168351707c6629b18ba61143c8d2294adaa90e8704d","t":"그대 또한 암살은 오랜만일 테지. 양보해 주마"},"26:1":{"lh":"db1394de","m":0,"g":"19cd675804fbf49c4682e94b4884d58224d233cd85dc32f889d84284e2c134c8","t":"우츠로로서, 칼날이 마르지 않도록 해 주려는 게지. 어버이 마음이다"},"38:1":{"lh":"9e747768","m":0,"g":"7cf7f1f66325a0b618e6526e0a9aaf0d72a149a1d4c6b13e5a637f19ca16f8b5","t":"관리자가 되면 우선, 모두가 갖고 싶어 하는 건물을 알아볼 거예요오! 아직 개발이 덜 된 지방을 충실하게 만들 거예요!"},"40:1":{"lh":"dc77240e","m":0,"g":"468aac91046073279c0e542410e74aab8c2c537bcfb16678b8b5115ffb47b01f","t":"지방 사람들에게 눈을 돌리는 건……기특하네……"},"42:1":{"lh":"35853e09","m":0,"g":"259ec89aae7c48a83abeae8bd6eb871ca8aadcfa1c71b695382b721744be8a23","t":"루미나 님은, 여왕님이 되시면 하고 싶은 일이나 포부 같은 게 있으신가요옷?"},"44:1":{"lh":"1585b96","m":0,"g":"856e3b546cca04a465e8c154fafcf1da9a8babc295474d72323834bc7240af07","t":"어, 그러게……역시, 불만이나 불안이 적도록……신뢰를 얻을 수 있는 여왕이 되고 싶으려나……"},"46:1":{"lh":"625e40aa","m":0,"g":"dae8582e8aaa29cfb99b6512b4d4b73e2cc864cec74f2868bb473cc1767d1cd5","t":"신뢰! 아버님께서도 늘 중요하다고 말씀하셨어요!"},"48:1":{"lh":"d59ec77b","m":0,"g":"be36d13bc48306c3ce9ed6c484d984e11a898065dcd2ceb6821c336ba7fefb73","t":"후후……좋은 아버지시구나……"},"62:0":{"lh":"eff14346","m":0,"g":"3735e8d978285fc50af4854e4350f71474c6214a7fb98e130c6d621dc0b7f683","t":"자……잠깐만 기다려 주시겠어요?"},"64:1":{"lh":"ca75df05","m":0,"g":"13373135614db4f745985149a726165e91475a76a422ca41e68366133ace1570","t":"남자…………"},"68:0":{"lh":"910f58bb","m":0,"g":"5847452eb138f0a78ada23ac2edf835718de9075fa0634975f7e6cff1ae804e6","t":"이 콜로니가 어떤 상황인지는 모르겠지만……아무리 끔찍한 상태라 해도, 적어도……그래, 아직 관리자가 되지도 않은 저 아이에게는 죄가 없는 게……"},"70:0":{"lh":"9847c7c9","m":0,"g":"d403d9932ea0626e665d238311a7c7ab4ee89313b43de7b9d5b0d6e434a77c9d","t":"게다가 굳이 죽이지 않더라도, 다른 방법이……"},"72:1":{"lh":"4b4fc5a9","m":0,"g":"ca91ee950b68fe69fa52f7b78ef0e4e7494d30b97c539f77dd967b7c78ef257a","t":"삼가라. 무지는 용서하나, 오만은 용서하지 않는다"},"76:1":{"lh":"5560752d","m":0,"g":"254566ee06303da83ac6d9727745e312f203ae6497a7cdc8fc3eb0aadb982c13","t":"……의뢰의, 상세한 내용을 여쭤봐도 되겠습니까"},"78:1":{"lh":"a32bb0cc","m":0,"g":"20be320efc44f79a12a3549f6e5a4bec30a0bf27a8b1c4b013584899a2176a7f","t":"이곳 주민으로부터 암살 의뢰가 들어왔다. 이르길, 관리자는 제 배만 불릴 뿐 백성을 생각하지 않는 우매한 자라더군"},"80:1":{"lh":"67bf5450","m":0,"g":"5d9b84d83b9e516ad9af8cba7e899d39391c52e656df6b8abcc96b98f4b3109e","t":"다른 이에게 관리자 자리를 넘기지도 않고, 상속을 거듭하는 탓에 관리권을 빼앗을 수도 없다더군"},"82:1":{"lh":"6fb12ceb","m":0,"g":"f6a384f623a0594155e7921603e8ecd92be6d6d17efa5338edd1e80ebe56fac0","t":"전체를 위해 헌신하는 자를 지키고, 하나에 집착하는 자를 솎아 낸다. 명심하고 있을 터"},"86:1":{"lh":"2f7fedc1","m":0,"g":"0e26bf99f08adeefd6750ae783715a718c8f23a59b7492a6688aec6442987932","t":"본래 이런 의뢰는 나 혼자면 족하다. 어찌하여 이런 말을 나누고 있는지 알겠느냐?"},"88:1":{"lh":"8838ab54","m":0,"g":"0bca3a5b8865bd9fadd96b5f1b8263dc2fe964c232a52133b1f1bbb931a27e2c","t":"의아하게 여기고 있는 것이다, 시즈쿠"},"90:1":{"lh":"10c866b2","m":0,"g":"cfdaf8a4aacbf52ea1aa1e1fd6b459f98df42d1a7592ded985579807654cb1f2","t":"의아……하게 여기신다는 건"},"92:1":{"lh":"a35c5eb4","m":0,"g":"a23cfa3b6fa4c85ac083d479925e7bd9747cf55d2a068be0308228bf1f9d3096","t":"시즈쿠. 그대는 아직 우츠로일 자격을 지니고 있는가?"},"98:0":{"lh":"948344f","m":0,"g":"990839d24192164205d43c54e7ed57b8e5d19763d063cc4d8a4393a7246a9e5f","t":"(뭔가……쓸 수 있는 방도는……)"}}}