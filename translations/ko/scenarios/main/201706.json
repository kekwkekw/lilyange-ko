09f077cda67f663b","t":"……………。"},"119:1":{"lh":"ccf37c57","m":0,"g":"0807f2b76f1dc5f1ee28dcd0e4f2f050cdb0245f0bfbcb9874640737a3a71453","t":"작은 새야. 여기는 내 이야기 속이야. 네 둥지가 아니란다."},"121:0":{"lh":"1d5e3056","m":0,"g":"69187e5f43186e451ed392f17024452467eea28d4a7204a51dd6887db8df45c9","t":"둥지……? 무, 무슨 뜻이야?"},"123:1":{"lh":"e060e7af","m":0,"g":"a0d2ffa8c7bc1d0fc3adf62f8f07889af93a90f845a1c86479858ba94c45d87d","t":"이거야."},"125:0":{"lh":"aec9f206","m":0,"g":"c4c25d8d99b6dbb710252cdf5c0041ad482efdbcbca8a519c4922f6058227a96","t":"……책?"},"127:0":{"lh":"6713a080","m":0,"g":"6cb02ec2a6a547d043905bd45f95b3ff9d43bfb0320c7d52b6f6ce43a11740e9","t":"리델이 테이블 위에 책 몇 권을 올려놓는다. 호화로운 장정이라 값비싼 마법서나 그림책처럼 보이지만……"},"129:1":{"lh":"b7abc0f4","m":0,"g":"6667eafbe3fca6360202641bf0ccb7a4d25e820fca7c12c2f8ec6ffbf3eb4a59","t":"이게 너희가 조금 전까지 있던 세계야. 등장인물인 너희만 잠시 다른 이야기로 옮겨 둔 거야."},"131:1":{"lh":"5b8c2d83","m":0,"g":"1f5c5065c4cdd52a9e594d449c6fc8dff5b4a1cc80a54da0d48b8276a946bef9","t":"『운석군』 장면은 이미 묘사되어 버렸어. 지울 수는 없어. 그래서 다른 이야기에서 다 읽어 낸 다음, 너희를 원래 책으로 돌려보내는 게 좋겠다고 생각했어."},"133:0":{"lh":"de2b719d","m":0,"g":"b3c6c9dc4eade5ba196fc59063180e644ade230a838d0bcab7a22c47b24a5f97","t":"리델이 하는 말은 대부분 이해할 수 없었다. 하지만 운석의 위협에서 우리를 지켜 줬다는 것만은 이해할 수 있었다."},"135:0":{"lh":"4b854a90","m":0,"g":"4b11802808de66a028f83c5ecb027c710509dab01f79d6d748a083af7854ce26","t":"음……그러니까, 어떻게든 해결해 준 거지? 고마워……!"},"137:1":{"lh":"32fbfc9","m":0,"g":"445d37644227a4592be4516cd034007e0dbf67d9252f99b0205ddebdd3a559f2","t":"……그렇게 쉽게 믿어도 괜찮아?"},"139:0":{"lh":"59a27a66","m":0,"g":"cf60e61f489b37dd95f7f9751d8ac6a8e25672f18cae07033104270129e2354e","t":"어……?"},"141:1":{"lh":"c62d2b3","m":0,"g":"cab91851fe39c318d4c8305fb79d9efe69ab2e3ee4dfbbec89b4e95179b58c91","t":"나라면 운석을 등장시키는 것쯤은 간단해. 토끼 씨들을 여기로 불러오는 것도 간단하고."},"143:0":{"lh":"a2b28761","m":0,"g":"cb25dbc346ba6ec24375af0660199b558091866e1a7af5f49aaa8fb8de6396a4","t":"………………"},"145:0":{"lh":"43d4d1f6","m":0,"g":"692cf87f271ae39fa0ad35c00dbf860a889ce40805d60954cce060b96c106447","t":"리델이 곧은 눈빛으로 이쪽을 바라본다. 갑자기 지금껏 느껴지던 위화감……말을 나누면서도 이쪽이 아니라 어딘가 먼 곳을 바라보는 듯했던 위화감이 사라져, 잠시 말문이 막혔다."},"147:0":{"lh":"4dc9008a","m":0,"g":"9e9deada74d1736b1f41e79dd5bc1e521bb376404804418afe38c87f05083686","t":"……즐거운 이야기를 좋아하는 거지?"},"149:1":{"lh":"3cef956d","m":0,"g":"cb25dbc346ba6ec24375af0660199b558091866e1a7af5f49aaa8fb8de6396a4","t":"………………"},"151:0":{"lh":"c9aa6381","m":0,"g":"40f071363b4e34c66bc04e1d7d3024a73c479dd3983a8b149d0cd0e7726047d5","t":"뭐, 운석이 부딪쳐서 우리 모두 죽어 버리는……그런 이야기가 즐겁게 느껴진다면 모르겠지만……얘기해 본 느낌으로는 그런 녀석 같지 않았어. 우리 안색도 살폈고 말이야."},"155:1":{"lh":"56150e37","m":0,"g":"2120947dd9955a90fe33ffe41becf34a62692ae87b85ef40c52316cdc0cdea33","t":"……후훗."},"161:1":{"lh":"50f8ccf1","m":0,"g":"a2c21c3ff7c9a9796fee1ff9052a4d51ef723b3a0cfea605814a7ea8eb23f8cf","t":"……그래. 그래, 맞아. 난 배드 엔딩이 싫어. 아무리 힘든 일이 닥쳐도, 마지막에는 집에 돌아가 밥을 먹고 침대에서 잠들어야 해."},"163:0":{"lh":"dfff4b14","m":0,"g":"eae3b28bb16eab1ad4e780805063b876e37f9ca6740bf6b537c94f97d61ff68c","t":"오늘 아침에 읽은 편지는……리델이 보낸 거야?"},"165:1":{"lh":"2f0ef48b","m":0,"g":"a56a087e327de1d4b8e245bef07d95d6fe314ffc5fe81c05446010be7e780214","t":"맞아. ……사실은 있지, 좀 힘든 페이지가 많을 것 같아서 다른 책 속에 넣어 주려고 했어. 너희 모두를."},"167:1":{"lh":"572b33c4","m":0,"g":"de01115ab09dc3395636f8ca94d10c0ea01e32587466d6db1c9b1386708bafee","t":"하지만 너만 왜인지 원래 책 속에 남겨져 있었어. 다른 토끼 씨들은 쉽게 잡혔는데, 너만 꼭 새처럼 팔랑팔랑 달아나는 거야."},"169:0":{"lh":"59a27a66","m":0,"g":"cf60e61f489b37dd95f7f9751d8ac6a8e25672f18cae07033104270129e2354e","t":"어……?"},"171:1":{"lh":"1a591c4","m":0,"g":"d0c682ce810cc32bebd79b668a3f92e8a3864ac72cf0f82308c164a050b4223e","t":"조금 요령만 익히면 어떻게든 될 것 같지만……지금도 이렇게 너만 남아 버렸잖아. 너, 뭐라도 하고 있는 거야?"},"173:0":{"lh":"67991be0","m":0,"g":"2f8ce73ad81ac8fd96e0ac56ba08fc8caae765d0978090cef16baa65168820d6","t":"어어……? 아, 아니……잘 모르겠는데……"},"175:1":{"lh":"782320ae","m":0,"g":"b2127427ccf68f0b2b87c1757a0518defd0a74416d99d6577dc20e07358186f9","t":"그래. 뭐, 됐어. 전부 생각대로 되어 버리는 것보다는 조금쯤 까다로운 부분이 있는 편이 더 귀여운 법이잖아."},"177:1":{"lh":"48363305","m":0,"g":"aeb88b1a91ac0a987be9480ecfc1dd75bdd213338c60f6aeccf233871857a22c","t":"……지금 운석 장면이 끝났어. 슬슬 돌려보낼 건데, 뭔가 남은 일은 없어?"},"179:0":{"lh":"4445c9a9","m":0,"g":"28a00041f89ea7ea625ee2ff22e3ff960ef1f53122b2e26cfecc4966d9a1c8c5","t":"남은 일? ……설마, 작별이라는 거야?"},"181:1":{"lh":"542629a3","m":0,"g":"db1428b5fe222712e6ef814e7e8eb0e5582f9c527a9fca3eea5379720bb29b18","t":"내가 읽고 싶은 부분도 이제 곧 끝나거든. 이야기의 마지막에도, 책을 다 읽은 뒤에도, 할 일을 끝내고 침대에서 잠들어야 해."},"183:0":{"lh":"e1d4d39a","m":0,"g":"decc6da539dde7bcf8858dba2e704aa95c34b7143290ecc6ac2c6deffd33dfee","t":"하지만 네가 좋아하던 홍차도 느긋하게 마시지 못했는데……"},"185:1":{"lh":"dfa12ff5","m":0,"g":"f0d775aebb5f0c3b98020737d0c63b1ea74a698af80aad4ccd2dc278f1163340","t":"그렇다면 다음에 다시 천천히 읽을게."},"187:1":{"lh":"57f39937","m":0,"g":"0562ed5415ca3d20addb3d27dc4c1e3b35e9d615a8cd228615ac90517e4b1623","t":"……아주 특별하고 맛있는 홍차를 우려 주는 장면, 기대하고 있을게?"},"208:1":{"lh":"63863ca7","m":0,"g":"0f551bfb7e1b7d8b2b3e1905c0bbafeb8c37f74fc188fae3728fabc488c78d2e","t":"후아암……요즘은 별일이 없네. 벌써 열흘쯤 내내 우주를 날아가기만 하고……"},"210:0":{"lh":"da8a0bfb","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"212:0":{"lh":"74c72771","m":0,"g":"2259cc087958c6815b2b0559dfac2973bcf420d3869b0f6b881552e5301f6f6d","t":"리델과 만난 다음 날 아침. 그 후 원래 우주선으로 돌아왔지만, 리델도 유스도 자취를 감췄고 어째서인지 코하루 일행은 리델을 기억하지 못했다."},"214:0":{"lh":"8ea7b602","m":0,"g":"2593880f94d48fb72de48c3d3a411db939b31924d4fa84da2c87d95e9c450fa8","t":"리델의 말을 빌리자면……『다른 책으로 가 버렸다』는 뜻일지도 모른다. 왜 나만 기억하고 있는지는 모르겠지만……"},"216:1":{"lh":"cf685402","m":0,"g":"11f4052cd576c9f32110a95a84c986e7ab98829a2fac79efaba516da966bdd8e","t":"저기―, 듣고 있어? 모험하고 싶다～는 생각 안 들어?"},"218:0":{"lh":"8f2ff4db","m":0,"g":"5f84a042367da9774438c2e120cdbc5096685a1e479e62e3b4405229616fdcc6","t":"뭐…… 아무 일도 없는 일상도 나쁘진 않잖아? 매일 그러기만 하면 질릴지도 모르지만."},"220:1":{"lh":"17123968","m":0,"g":"d9dd1dbba283e85f459b9aff73a136e51a32346b93f50dbaf98961a56abf7775","t":"으음, 그렇네. 어차피 또 엄청 이상한 별 같은 데 내려가게 될 테니, 지금 쉬어 두는 게 나으려나."},"225:1":{"lh":"a64ac426","m":0,"g":"c0abf3b09b0b346c42bef5af2a84da8f3f70c0326dd983b242ed5d8d879bc542","t":"기다리게 해서 죄송합니다. 아침 식사입니다."},"227:1":{"lh":"b7c5573a","m":0,"g":"f571416a0365199d6af8a5b83d217cf3b2c7a1ec575b0f838d3f313756bfef7d","t":"와, 맛있겠다! 오늘은 평소와 다른 향이 나네!"},"229:0":{"lh":"da8a0bfb","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"231:0":{"lh":"b6c1cafe","m":0,"g":"330d3553a95b2d08e35831ab46d12fed5400bd4fb8c36b9ba6736be6f0d63a8f","t":"아폴로가 가져온 아침 식사에는 평소보다 식기가 하나 더……찻잔이 놓여 있었다. 코하루는 가장 먼저 그 잔을 집어 코 가까이 가져가 향을 즐기고 있다."},"233:0":{"lh":"ddee5153","m":0,"g":"ae47d8a2b2adb2ff3bc67852c57250e04408433df3b0ebd738dd4b9f8ad448b7","t":"이건……?"},"235:1":{"lh":"23f9e06b","m":0,"g":"798f0772a22ae1459b35aa36c07b851bcbfcd26d84d85f85d965c6dc79961c97","t":"……? 무슨 문제라도 있으십니까?"},"237:0":{"lh":"c2df0252","m":0,"g":"110eaea6236068baaa4e73e26a2d52839a8b39af70ac88a452fe1b2bb84f26a4","t":"아니, 보통 음료와는 따로 준비돼 있길래……뭔가 싶어서."},"239:1":{"lh":"e1773727","m":0,"g":"103ccc6a6f1dd981f79c91682baf5156fe3565de5cea971a365f4c599c1561c1","t":"잊었어? 7일에 한 번 아폴로가 오리지널 홍차를 만드는 규칙이잖아. 예전부터 계속 마셔 왔는데……"},"241:1":{"lh":"181e19f9","m":0,"g":"c53611ce8c4655cdea765bade95c9f788e99ec2f7ad099c361c2f813dce51958","t":"이제는 50종이 넘는 플레이버가 준비되어 있습니다. 슬슬 로테이션을 짜고 싶습니다만……"},"243:1":{"lh":"58d9662f","m":0,"g":"c5c6f2477ca301c6f956eadf1aefcfddb7d5b48b7736912c39ab8e65e1eed535","t":"안 돼, 규칙이잖아! 매번 독창적인 걸 만들어야지!"},"245:0":{"lh":"ccd8b368","m":0,"g":"24d814d999a260ae74be19102ab5c4adf5e87d9c659916aea0ea41140c8a3fdd","t":"……………"},"247:0":{"lh":"33bd4310","m":0,"g":"5b10e90cf1d5d65032ec798bd180c534b2e44a049a39e5a768a77aac1d66cbca","t":"리델은 자기 취향에 맞는 설정을 덧붙이고 간 모양이다."},"249:0":{"lh":"b4299ebc","m":0,"g":"fa21dc72fc158fa215d02f760a1094741fa7d72e2708b7733b0292b0dcf8eade","t":"다음에 만날 때 리델은 과연 몇 종류의 홍차를 마시게 될까……그런 생각을 하며 나는 홍차를 홀짝였다."}}}