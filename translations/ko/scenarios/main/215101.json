"m":0,"g":"897d52773315784d8977f82330dcc37753ad8023412f84f6ef40cb5f7077c319","t":"그렇구나……? 루미나 일행은 아직 요양 중이라 못 왔는데, 괜찮을까?"},"46:1":{"lh":"7e6b8e4f","m":0,"g":"c05c3ef985c6ae8ca99b6d567ef0a2e511f5c64f36513f7c40e6bde38c106bc5","t":"엄청 센 몬스터가 나타난 건 아니니까 괜찮을 거야~! 원인을 모른다는 것뿐이니까!"},"48:1":{"lh":"27e086c","m":0,"g":"c7009897d420f841498c0fad4300290398c7e0e15dc65c9a56bb1cddd6318038","t":"그래. 마법으로는 잘 안 돼서, 어떻게든 해낼 만한 리리안이 없을까 하는 얘기가 나왔는데……"},"54:1":{"lh":"189be0ec","m":0,"g":"7527ecf651a92d2239d1b8830ebb5d6326bbf0883658a62a2563ec15806e04fb","t":"그래서 케트가 불려 온 거야~!"},"57:0":{"lh":"4cc4835e","m":0,"g":"9874ad28eee3e0fa9f5073abde8af8b1555b9688eb1b2b11db337d685c263a70","t":"케트. 초록과 짐승의 별에 사는 리리안. 천진난만한 야생아로, 동물과 대화하는 능력이 있다. 이번에는 포니 일행의 부름을 받아, 소형 우주선으로 케트도 데려왔다."},"60:0":{"lh":"ae3949bb","m":0,"g":"e571e5dab02386c9d82bc9fb7a9cdecf286561647a3f396e3759fb0cec0c66bc","t":"그렇구나……"},"62:0":{"lh":"49fa2a62","m":0,"g":"504ddcca5c35b36dc7ed6a2794a2b93e14128154edd4004d1f19c9107f93b871","t":"케트는 동물의 말을 알아듣는다. 동물들을 불러 모아 탐문하면 마법보다 효율적으로 정보를 모을 수 있고, 그 하얀 그림자라는 게 나타나는 장소도 알아낼 수 있을 것이다."},"64:1":{"lh":"ea3cfae","m":0,"g":"aa54d2d0c1ddf05012601677d31f2f0f8469f799073754c1b1468f4ecc3d7228","t":"……언니들이 하는 말은 거의 못 알아들었지만! 하얀 걸 봤는지 동물 친구들한테 물어보면 되는 거지!"},"66:1":{"lh":"ba8f7611","m":0,"g":"46148c66c3152f1cfa64e4bbd6b5edd77e33e8a90c1a94e4ee56d90b4b00f715","t":"바로 그거야! 부탁해도 될까?"},"69:1":{"lh":"b1a21ac5","m":0,"g":"69efc8914678e66f238eab2720ded8983245607b54ad7ecc8077e6801f3aa613","t":"물론이지~!"},"72:1":{"lh":"7fd250ce","m":0,"g":"b947474fdd70011585f3959c16a06d2012fb414a27e017d22a5fba7566f406da","t":"고마워어~!"},"74:0":{"lh":"62b44aad","m":0,"g":"80dd6bb93909b2762af4894e5e2d13158e993acdea54bdddd4970f023700bf66","t":"（이 둘, 죽이 잘 맞겠는데……텐션이 비슷해……）"},"76:1":{"lh":"653a2fc9","m":0,"g":"4d42276229714fad2ad950429e792ef4b0a8212378a54cdea4a29f082372afcd","t":"그럼, 번거롭게 해서 미안하지만……부탁할게."},"78:0":{"lh":"dcd72239","m":0,"g":"34814012b5549f941340cec417ff453aaf29854dafb6459aa453b85564a994df","t":"아니, 나야말로 늘 신세 지고 있으니까."},"80: