:"6cd7c307699f595d1710861749b9538c203f903e02e930fa503cb15b86725ddc","t":"그럼 혹시 여왕 같은 사람들도 기계의 영향을 받고 있는 거 아냐……!"},"269:1":{"lh":"a93f7f8c","m":0,"g":"dc38a2b7dad6c7f2049d8c06839121c6aa9d850829b53ba4a80f0318f0b5b70c","t":"……그렇다 해도, 지금까지처럼 성간 범죄로 처벌할 수 있는 사태라고 하기는 어려울지도 모르겠군요."},"271:1":{"lh":"c701f477","m":0,"g":"f8ecfb6a3abb9a05c82672125b2ac2f7101a5c27ba48caa66c274b361b620c92","t":"어, 왜? 불법 기계인 거 아니야……"},"273:1":{"lh":"7f919905","m":0,"g":"942fd910ad702799c16e8da5182812d2cc6b1cfaa9b815a8664cc4b8493ea3d8","t":"사태의 자세한 내막을 알게 된다면 이야기는 달라지겠지만요. ……비정상적인 사태도 오래 이어지면 정상이 됩니다. 비정상적인 상태에서 만들어진 법이라면 불법에 해당하지 않을 수도……"},"275:1":{"lh":"ef5c9a80","m":0,"g":"4ad73eb006c61bd07a97c53d93eabde8eefa40b85e0d9099c72e6a13c971ef8e","t":"아닙니다. ……어쨌든 어떤 영향이 나타나고 있는지도 모르는 현 상황에서는 기계를 정지시키려 해도 의미가 없습니다."},"277:1":{"lh":"a6bf68e2","m":0,"g":"02e1e60fda4c00694619bfd6a5eaa1301edfefc34e2dea3cb12cd00bcf177ac2","t":"이제 와 성간 범죄를 아무리 막아 루미나 님의 실적으로 삼는다 해도 사태는 조금도 나아지지 않을 테니까요……"},"279:1":{"lh":"1860a82e","m":0,"g":"6c2f42b4a55753e9e62dd02f65b6356658d6cbe6e721c2568cbf980c1112bb7f","t":"그럴 수가……"},"281:0":{"lh":"da8a0bfb","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"283:1":{"lh":"b997cd83","m":0,"g":"17b71f9bbe52c977056a7cea400f390f88de7eddae43dccb7490f88878363d27","t":"당신들 입장에서 보면, 이대로 아무것도 하지 않고 루나 링을 꺼내 고향으로 돌아가는 것이 당연한 판단이겠지요."},"285:0":{"lh":"bd2c46be","m":0,"g":"5a31aa4b8f01b61db02432b9ad88af11127d8ae4650dda7a5f68eaf875f09bd6","t":"뭐라고!? 루미나가 조종당하고 있는데……"},"287:1":{"lh":"57520c98","m":0,"g":"5e699638731aaaec4fd714322010bf225f046e4de815bea7f334c386e4ef33f9","t":"조종당하고 있었다 해도, 당신들…… 우리에 대한 집착을 버린 것처럼만 보였습니다. 애초에 제 목적은 루미나 님께서 마음 편히 여왕이 되시는 것입니다."},"289:1":{"lh":"349de799","m":0,"g":"cd9151d76d867a8fc1238b59f9231bd05c0876dab7e117ee8f6e21845bf5561d","t":"큰 문제는…… 없다고도 할 수 있습니다. 물론 관점에 따라 다르지만요……"},"291:1":{"lh":"6a7edb4d","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"293:1":{"lh":"504995c8","m":0,"g":"7b03d21b5aee5097ee617ed9e3df90a5e5e7b7d0dc08729185177c77e01cce8e","t":"저는 앞으로 어찌할지 잠시 생각해 보겠습니다. 당신들도 조금 생각해 보는 편이 좋겠군요."},"295:1":{"lh":"7ce7dfcd","m":0,"g":"9f2edd576e16f79736441cc6693bc3ae9ffc07d49304fc454b303f4d5e2c5245","t":"아폴로가 아닌 우주선을 타게 될 가능성도 있습니다. 짐을 정리해 두시기를 권합니다."},"302:1":{"lh":"76bdd568","m":1,"g":"3ebfa9ffdb2272751c932a06cf503dc4f9a90f937ce8b84c058e8bd841686492","t":"{PLAYER_NAME}……어떻게, 할 거야?"},"304:0":{"lh":"d95c1029","m":0,"g":"5adce34289890dad9cf4090e0a516f814a5968ebf5dd339783c1e1a17f0111b2","t":"……우선은, 들은 대로 하면서 생각해 보자."},"320:0":{"lh":"da8a0bfb","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"322:0":{"lh":"883d4a54","m":0,"g":"6b7734f2816934d910119b4a68add991d69b5ba87638cf137e71aad11b02b970","t":"말해 준 대로 짐을 한데 모아 둔다. 만든 기계, 받은 물건, 산 물건……"},"324:0":{"lh":"3db925a","m":0,"g":"b88ac84053daa0465f6a1f75ccffad272ccdc7b8080bc0b0743915cb74421e2e","t":"짐은 그리 많지 않았다. 큰 물건은 늘리지 않도록 무의식중에 조심했던 걸까……"},"326:0":{"lh":"f953e0c5","m":0,"g":"51928ec4a02308f35600fb87be2d8669a02fc047303590ff2869828b49191444","t":"…………그러고 보니. 루미나도 여기로 돌아오지 못하게 될지도 모르잖아? ……짐, 정리해 두는 게 좋지 않을까……"},"339:0":{"lh":"d034e334","m":0,"g":"791c2f4c777a778d123686b350f27cfc6ed9fe973b7b112125e71775e9d00afb","t":"실례합니다……"},"341:0":{"lh":"771ee97d","m":0,"g":"76dc55ae569479fd5573b1ce042fcf7d764a0b4ef31f2b854cdde1589d214cca","t":"문이 잠겨 있지 않았던 건지, 아폴로가 배려해 준 건지. 어렵지 않게 루미나의 방에 들어갈 수 있었다."},"343:0":{"lh":"de38b00","m":0,"g":"61d8cf6cbb3da93cbe068051bd5d1bdb06b3543141fdff2cbab4ff8b10e00a0d","t":"（쇼콜라 데이 이후로 처음인가, 여기에 들어오는 건……）"},"345:0":{"lh":"2d85e5b4","m":0,"g":"920d14176c5a0a46ef83eb5f8f47eb91b4559179e069ae833f5ec338ee02433d","t":"주인이 사라진 루미나의 방을 둘러본다. 정돈된 분위기의 귀여운 방이지만, 자세히 보니……"},"347:0":{"lh":"8cb7ebb8","m":0,"g":"33cd9a05804f81f36e8df595b95ffdfcd0133deb17ed4408834efa028d6d9b35","t":"이거, 마력 훈련 기구였던가?"},"349:0":{"lh":"39a65cd","m":0,"g":"c32f787bd2b26aa3d50255eb369c562090c6db59c0798510f952f1131fa648b4","t":"몇 번인가 보여 줬던, 리리안의 마력을 강화하기 위한 기구를 들어 올린다. 하지만 마력에 관해서는 나도 잘 모르고, 효과도 미심쩍은 모양이다."},"351:0":{"lh":"2de21149","m":0,"g":"3ac1055fc75428e543ca0ac353e671890a62da3551eaa1096a09b0b3e18e7098","t":"확실한 것은 마력을 한계까지 쓰기 위한 기구로, 이걸 사용하면 몹시 피곤해진다……고 했었다."},"353:0":{"lh":"d28bd7c7","m":0,"g":"9aa221a8c23c26968f0797d6c1d8d0ff4f78ef07fa697e899ce1db96b0beccfe","t":"침대 가까이에 이런 걸…… 평소에도 썼던 거겠지."},"355:0":{"lh":"aecca20b","m":0,"g":"7a1d7dc904e6646de4d6d784f8748106dd22ef32745dd9656b40627b9da34842","t":"루미나가 가장 바랐던 건 결국 무엇이었을까. 시즈쿠의 목적은 루미나를 여왕으로 만드는 것이다. 하지만 루미나는……"},"357:0":{"lh":"a73ec1c0","m":0,"g":"3ad6408d94ddf903ffd278c725f5cb66e137f498e1a059bcd3aef0ccf5a8db32","t":"……나와 결혼하는 것이라고 생각하는 건, 나도 참 오만한가."},"359:0":{"lh":"6b640227","m":0,"g":"4ce88d145e614a3c3bf089e054b47d37eeb781389a949d9d55a9c96484de86e5","t":"\"그렇게\" 되는 건 분명 루미나에게 이상적이었을지도 모르지만, 지금까지 루미나가 해 온 행동을 보면 최종 목표가 결혼이었다고는 도저히 생각할 수 없다."},"361:0":{"lh":"cb5af69c","m":0,"g":"9ac75f4fe478f16fb9cdfc9fb76c9813a93f47dfb797a2fc09d04b94585d02bf","t":"……의외로 시즈쿠의 말대로, 문제라고 생각하는 건 우리뿐이고 지금이 루미나에게 이상적인 상황이었을지도……"},"363:0":{"lh":"17afaee2","m":0,"g":"bb3118ba5109087b471b3d4f4d26471c4577ad873e751102368900806ad28b46","t":"책상 위에 훈련 기구를 놓는다. 루미나의 자잘한 소지품은 여기에 모아 두기로 했다."},"365:0":{"lh":"6e081b85","m":0,"g":"8e3d8c27b09dc38e19f31d42c708b468c22a0646cda2afcac77b16f10dd21b02","t":"음, 다음은……응? 이건……"},"378:0":{"lh":"c3a4bb12","m":0,"g":"b6ac35cd01a5cc23dbf4ef8179056c363f30312689da55785da2cf1d3313f022","t":"어, 그러니까……그럼 이쪽 선반에 있는 이건……"},"380:1":{"lh":"c9060b75","m":0,"g":"9abd63f2c357833c449679e29237f2a2993f03e8f465dc9b7a78e876a9b50d83","t":"기억 보조 장치입니다. 사용자의 기억을 자동으로 읽어 들여, 떠올리기 쉽도록 문장으로 만들어 저장할 수 있습니다"},"392:0":{"lh":"1200a07a","m":0,"g":"bde593dffacc9e688425b1db3f3634164fc8125910f35b3c40772c9dde082626","t":"맞아, 기억 보조 장치…… 결국 난 한 번도 써 본 적 없었지. 이것도 모아 둘까."},"401:0":{"lh":"6fc20269","m":0,"g":"8721f010818de405b44ecebd1a8390da9fbbb28d51b5cfde3ca2e77a8d5a7fca","t":"어? 아……"},"403:0":{"lh":"168be843","m":0,"g":"a41cbb196509325cde58400469f8c6634fa9c3fe18c19aa2fefbeb6f1160c416","t":"무언가 조작 버튼을 눌러 버린 건지, 수많은 문장을 띄운 모