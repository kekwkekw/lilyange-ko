3fd86188610617a2708a11636f11a146e9f1fc","t":"어느새 알프가 뒤쪽 바위 그늘에서 이쪽으로 다가오고 있었다. ……아무래도 이야기를 듣고 있었던 모양이다."},"216:1":{"lh":"f4a46a6a","m":0,"g":"726ec2733bcce70355b697a0c2bfe029f204e06c770d9abbf2ca2a7bfc297410","t":"확실히 난 위험한 걸 정말 좋아해. 스릴이 없으면 예술이 아니지. 그러기 위해서라면 희생도 각오하고 있어."},"218:1":{"lh":"69be786b","m":0,"g":"afbe5690bc030299e5e68b5a9e65cec9706bbb1192a9810525fb84b8d8c3df0b","t":"……하지만 희생되는 건 퍼포머뿐이야. 관객이나 상관없는 사람을 휘말리게 해선 안 돼. 법으로도 그렇게 정해져 있잖아?"},"220:1":{"lh":"f6189e14","m":0,"g":"af80778e7eadb2f30a704feb55e32ca1daf7bdeb2699247420ab92e1dbc96196","t":"…………읏"},"224:1":{"lh":"1cddb74","m":0,"g":"f103b6a44416e6e26b5dd9b14f84ccbe9a237df9915ce8d2bf200b782b7afb10","t":"……하지만…… 하지만! 이 별에 있는 사람들은 모두 퍼포머잖아요! 다들 폭탄을 만들고, 저보다 훨씬 아름다운 폭발로 사람들을 즐겁게 해 주고 있어요!"},"226:1":{"lh":"fc695505","m":0,"g":"8d6fd05ab1d9d28f9a9ad7f944c419f0b05184eda589fde9d67c7c2d7682407d","t":"이제야 빛날 수 있어요! ……지금껏 단 한 번도 사람을 즐겁게 해 주지 못했던 제가, 드디어 예술을 만들어 낼 수 있는 거예요!"},"230:1":{"lh":"a8108b0e","m":0,"g":"18b84d14811307a0a74cf4a07d503f02f92687e3db39f06b9e2b3aa0e7794182","t":"딱하다고는 생각해. 하지만 별을 부순다는 건 아무리 생각해도 너무 지나치잖아? 어디까지가 진짜고, 얼마나 진심인지는 모르겠지만……"},"232:1":{"lh":"852a59e0","m":0,"g":"bbd312bb26a6038766e07a4332577f222632686435d02bb63acc308b7c607fae","t":"……읏!"},"239:0":{"lh":"dabf0270","m":0,"g":"5f5ce6eda04711e01fb1670e76cff92c3d31989a9fa6a06d68609c71e81d2241","t":"엇…… 야, 아코!"},"241:1":{"lh":"9da93234","m":0,"g":"eaa9905d7466da3c9c51af531813010198214d574fe3384d1c2fd46ac2fb9bb3","t":"도망쳤어……? 그렇다는 건, 설마 진심인 거야……?"},"245:1":{"lh":"4622522d","m":0,"g":"4407c092c0e0c54d54c48cf4f9fa85784884d93666ef35c8d27af49dda185057","t":"그래…… 진짜라면 내버려 둘 수 없으니까. 쫓아가자!"}}}