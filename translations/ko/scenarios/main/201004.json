","m":0,"g":"6f986fc63203934d7ea94ac1d485b9fde092fd1711ced952cd7ba13d993b4770","t":"……금방 돌아올 줄 알았더니, 의외로 괜찮아 보이네."},"214:0":{"lh":"eaad0962","m":1,"g":"87c185687f315bda3097488be71860ad99e81bc76bdd2150755ab3c46a9c77d4","t":"근처에 있던 예쁜 유목에 앉아 {PLAYER_NAME} 일행 쪽을 바라본다."},"216:0":{"lh":"9670cc24","m":1,"g":"e62dc0840f688e93a0eb1e2f464eb2982c7e7148dfd45ca926d963aaa1c18a14","t":"반짝이는 바다의 빛 속에서, {PLAYER_NAME}와 블로어는 즐거운 듯 일렁이고 있었다."},"230:0":{"lh":"292bef25","m":0,"g":"477b3f8f1fba73b2b8b9e76b37b5a2574fa66e4f046db2caa213bf24e3e7a794","t":"여, 여기, 발이 안 닿아……!"},"232:1":{"lh":"dcc32fc0","m":0,"g":"39c3a804fbaa499b9bac7bda080c77974970ce969f9ab090e2f1af1b42418be2","t":"하하! 형씨, 선헤엄이야. 나 하는 대로 따라 해 봐?"},"234:0":{"lh":"5813a6da","m":0,"g":"973ccf205270f3bcf9aff8c5ea6a12b519ad810cbb16cdd0496d108594c4ff7f","t":"발은 바닷속이라 안 보이는데……! 이, 이렇게?"},"236:1":{"lh":"d55ee4b0","m":0,"g":"7281bd90990eb8bbeac4b5af0276f2365c5bcec90ed9ef133af03d717981c8b6","t":"오, 잘한다 잘해! 제법인데!"},"238:0":{"lh":"75973947","m":0,"g":"67295ed948af90f6b03ec33a57dbd7cfd73d059a39e8de3dd3c977141cee2d80","t":"블로어, 키를 생각하면 계속 선헤엄을 치고 있는 거잖아? 안 힘들어?"},"240:1":{"lh":"50fd7285","m":0,"g":"6feab933b8eafaf9da19b235eeef345450c608b4c71f9dfef63c4bff50fa1ea3","t":"이 물에 뜨는 장난감이 있어서 의외로 괜찮아! 형씨도 하나 받지 그랬어!"},"242:0":{"lh":"fd89c2c2","m":0,"g":"194b1bea78e3d35695855f72deb30be851ae575f1a35f48a47f1624f04dacda8","t":"내가 가지고 있긴 좀 그렇지…… 그건 나한테 너무 작기도 하고……"},"251:1":{"lh":"b8bef401","m":0,"g":"87bb74aad5e501e60c36f92ba0ac9fec145539f4cbe619fe29cf1a595ecb118c","t":"아~ 진짜 재밌어 보이네. 수영복을 양보한 건 실수였나?"},"253:0":{"lh":"5566ca06","m":0,"g":"c02e0488fce05700b5871633dab0f07400c561c67273df50aa9384ddae22e6fe","t":"바다가 무서워서 헤엄치기 싫다는 건 거짓말이 아니지만, 저렇게 재미있어하면 나도 헤엄쳐 보고 싶어진다."},"255:1":{"lh":"2eb9a8bd","m":0,"g":"d749f2e35cb849c987817d1327a60263baf6e99deec352d9189743e661a9de7e","t":"……뭐, “수영복 갖고 싶어~!” 하고 떼쓰는 건 절대 싫지만."},"257:1":{"lh":"920b819e","m":0,"g":"914357289ca03fef69f63f9e9d8203cbe5044672d3e90fd9013cb5bd31afd01e","t":"하아~ 그래도 진짜 덥네……"},"259:0":{"lh":"9a0a6423","m":0,"g":"063ca54061098c95e715ca5ff23c62c53cfd80b7b4857b5b8ae1a6c8353f0aa9","t":"따갑게 내리쬐는 태양이 눈부셔서, 눈이 타지 않도록 손으로 가린 채 하늘을 올려다본다."},"261:0":{"lh":"4d30e9e3","m":0,"g":"1fab1e51c84b634d1e3a0774631854d3e01a92f9eb35db8c92d2ad7a473be642","t":"바다 너머로, 무럭무럭 영양분을 먹고 자란 듯 부풀어 오른 구름이 보였다. 선명하게 하얗고, 바다와 하늘의 대비가 돋보여 마치 새 물감으로 그린 듯한 하늘 풍경!"},"263:1":{"lh":"d271610a","m":0,"g":"115c4a16219527adcb67638956d1406cf48e865e90420dd6a1f0fa6247634087","t":"……분명 더우면 저런 구름이 생기기 쉽다고 했던가. 아이였을 때, 다른 곳에서 온 사냥꾼한테 들은 이야기라 어디까지가 진짜인지는 모르겠지만……"},"265:0":{"lh":"36b3acf2","m":0,"g":"114ddb2dbbdaf64a586c68683be7d5d3128999fa090530c8e31a11f83b18b408","t":"이마에서 땀이 흘러내려 속눈썹 위에 맺힌 걸 깨닫는다. 반사적으로 손가락으로 문질러 버렸는데, 눈이 조금 따갑고 욱신거렸다."},"267:1":{"lh":"fcaf0343","m":0,"g":"003524f31eefd538a5d4f2bd3672f6e9754690e3b02b2a66f529cedd1ba2110d","t":"땀의 염분…… 시즈쿠가 그랬었지, 바닷물은 마시면 안 된다고. 얼마나 희석하면 마셔도 괜찮을……"},"270:1":{"lh":"3c3ee7a4","m":0,"g":"73082be88f80ee26b15520bd21ec537770fc2d95f7e2d4d6787883f852cf799a","t":"……까?"},"275:0":{"lh":"90dcf78d","m":0,"g":"6308c1dc8326f11aa507aa819a584380d3ef6ad8fca70c14608883715bc9304b","t":"유목을 짚고 있던 손이 미끄러져 내려가, 몸의 균형을 잃는다. 마른 나무껍질에 팔을 살짝 긁히고 말았다. 아프다."},"277:1":{"lh":"648922e8","m":0,"g":"00c0995a4b636a892b1ddb09854fd494f1c0fe6ec7da7d0c74e236963d523364","t":"아야야, 나도 참 뭘 하는……"},"282:1":{"lh":"535a0a60","m":0,"g":"9059f2529827a4bd01b73f613f90470bbca6e294b1d7b5c26900f86374146f13","t":"……어, 어라?"},"284:0":{"lh":"267dfb69","m":0,"g":"150cc2cf8b8f3738455a9dd7463ef5a585ab75c49989cd0735eb7976795192a1","t":"몸을 일으키려 하지만 허리와 팔에 힘이 들어가지 않는다. 힘을 주려고 해도, 마치 팔만 잠든 것처럼 팔꿈치가 기분 나쁘게 저릴 뿐이다."},"288:0":{"lh":"5fb6379","m":0,"g":"8dfc8ee9a7208a2935ccbf069a5ad23b824b68230caa7a62e0c0a895ac2b154c","t":"뺨이 갑자기 뜨겁다. 시야가 빙글빙글 흐려져서 몰랐지만, 지금 얼굴을 모래사장에 누르고 있는 거구나."},"293:1":{"lh":"ad4ea9b4","m":0,"g":"008ef35ac96d775a7a2532ddc2a55165b9f9135e0ceb74b5c87a1931594d8bf1","t":"（쓰러진, 거야? 이건…… 혹시, 더위 때문에……?）"},"295:0":{"lh":"9a122b1a","m":0,"g":"bdfa008195022bd261b4d32d7db996bb55801599a4874f3617b32bf6abe07804","t":"그러고 보니, 마지막으로 물을 마신 게 언제였지. 수박은…… 조금밖에 안 먹었고, 그 뒤에 나온 수박 주스도 사양해 버렸어."},"297:0":{"lh":"19bd83fa","m":0,"g":"7e253ef0bd07e5fa20ce7763c2b6faff2a137bb35f43fd5bc65b42eff6879b5c","t":"몸을 움직이지 않았으니 괜찮다고, 지레 믿었던 걸지도 몰라. 주변 사람들에게 물을 마시라고 권하긴 했지만, 정작 내가 마시는 건 잊고 있었어."},"299:1":{"lh":"7730ddf1","m":1,"g":"837ecf4d934171797615e9ea25e4b88c1f248598ee1292271329099622edd6fc","t":"({PLAYER_NAME}……)"},"301:0":{"lh":"86e8c610","m":1,"g":"a0e20c5acb234c6eea5db64e0982ee91a3c6e6f2fcba08c0d7fb5bf53fe3abb7","t":"파도 소리를 타고 블로워와 {PLAYER_NAME}의 즐거운 웃음소리가 들려온다. 목소리를 내려고 해도, 살짝 벌어진 입술에 모래가 달라붙었을 뿐이었다."},"303:1":{"lh":"78a7d7d","m":0,"g":"d8bfbfd5f90028b9b1b75c0172b3e9dd3e95e99ee29e6252019423351214deb8","t":"（리리안은, 몸이 튼튼한 거, 아니었어?）"},"305:1":{"lh":"96a2f1b","m":0,"g":"16ce1e91091a3a7f80db3df2524339b93402549d0adf98aba0caeb6350525e4c","t":"(이거…… 만약 한동안 아무도 날 발견해 주지 못하면…… 나, 죽어?)"},"307:0":{"lh":"f0e00ca5","m":0,"g":"4d83fe97f1711ba7349bdc50b084f47d618dd918c77d45836d2006dcf843f792","t":"죽나, 하는 의문이 머리를 스친 순간, 자신이 죽을 때는 어떤 식으로 죽게 될지 생각했던 기억이 되살아난다."},"309:0":{"lh":"29ffdcc5","m":1,"g":"6b2140eba2e777087dbd27b9e2e5e3d6983174221fcdb8730f7e3123f3ab5221","t":"{PLAYER_NAME}을 감싸고 멋지게 죽는다. 우주선이 폭발해, {PLAYER_NAME}와 서로 끌어안은 채 죽는다. 어딘가의 던전에서 「아직 더 모험하고 싶었는데」라며 눈물을 흘리면서 죽는다."},"311:0":{"lh":"16a09509","m":0,"g":"2fb2fc53886a5e84dd390fe106c8e722c24049e46e126a02ae7767096ca4b829","t":"그런데 고작 모래사장에 앉아 있다가, 더워서 죽어 버린다니."},"313:1":{"lh":"611840a5","m":0,"g":"68b3cb1ac4ca54c9d884cc3b7a74afb268beda8b9989ed17db2c801fcb6b0db1","t":"(……거짓말이지?)"}}}