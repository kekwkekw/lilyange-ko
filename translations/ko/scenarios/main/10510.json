h":"7fe45249","m":0,"g":"3e407630e9b37f82aff0e8d597f3f21f802870ea4d5621519f43d6993ada411e","t":"나는 왕녀로서 이번에야말로 아버지를 막고 싶어! 나 역시 이 이상 죄 없는 백성들의 피가 흐르는 건 용납할 수 없어!"},"104:1":{"lh":"49285a60","m":0,"g":"88fefeabf755f3217b5f9a92715f7dfd72e0176967478cbe06848a8c5ba8ade3","t":"그러니까…… 이 오아시스를 아버지를 설득할 카드로 쓸 거야. 그래도 안 된다면…… 나도, 목숨을 걸고 막을 생각이야."},"106:1":{"lh":"bb802269","m":0,"g":"2a87b2b356d0547217b1b40b254310925742c7f823281d353e5809f06a9a40d5","t":"……말로야 무슨 말인들 못 하겠나! 그런 말을, 쉬이 믿을 수는……"},"108:1":{"lh":"4dd8920d","m":0,"g":"9c2dae548f7f9cb8b1ea94cfcb3142b1405fe2f85ca3b3e2323e84bc108b987d","t":"그걸 믿을 수 없다면, 당신들도 따라오면 돼!"},"123:1":{"lh":"e5d9e7e1","m":0,"g":"4ad0118dd267832da3049aaba3daf95389ab3cfeef4d46c332e401a39f0e0ec4","t":"(믿을 수 없다면……인가)"},"125:1":{"lh":"a54222ce","m":0,"g":"01643992fe106ded4d1082f3b89bdd89c70d529540d7fcb0733c72b1d2f03c80","t":"믿은 거다, 공주님."},"139:0":{"lh":"2cfabb3c","m":0,"g":"bfc75c0679fff1cb287dc64440a52687c588e2153430f34a5dd336cbf82aff92","t":"그럼 다음 군사 작전에 관해 최종 확인을……"},"152:1":{"lh":"dcafe1b2","m":0,"g":"c97b0983456a3901d3f98e1b14650fe13aa1c3f46f74ef45c5e6b45ccf23249c","t":"아버님!"},"154:0":{"lh":"507a68ad","m":0,"g":"8f4993706bc01a247bfa67617afcc4f08d5cafe24e8363f83773644669d688f5","t":"(어떻게든 도착했어……!)"},"161:0":{"lh":"7c97516","m":0,"g":"3eb3a1f00c4a098518ddcc3f84cefa3d68d3700ac7a838296f7d70a2ae711b56","t":"왕 곁에 있던 위병들이 방패가 되듯 무기를 들고 경계 태세를 취했다. 그러나 습격해 온 병사들과 달리, 라일라에게 적의를 품은 기색은 없었다."},"163:0":{"lh":"480202f9","m":0,"g":"350ef1dced2ecdd2785f21591deaf469708606eedf46fb568d0efaa9451359f2","t":"되었다. ……라일라인가. 왕녀로서의 예절을 조금은 갖추거라. 지금은……"},"165:1":{"lh":"fd179b0e","m":0,"g":"aec4e2a89cef59edc9dd984f3da52381a4bc20547753a5e9a7107b949551470d","t":"송구합니다. 화급한 용무가 있어, 무례인 줄은 아오나 알현을 허락해 주십시오."},"167:0":{"lh":"9dea72a6","m":0,"g":"ae34adf61d8460c7a514c5534548884529bc86667376340a68f7fbb8ef9bcc6d","t":"……후우, 미안하오. 말을 안 듣는 딸이라……"},"169:0":{"lh":"58b8207e","m":0,"g":"3f00c529594bef98846387f1153209e61e01aa7a773bca444740c7e40b1cd357","t":"신하는 쓴웃음을 지으며 고개를 숙이고 라일라에게 길을 터 주었다. 라일라는 깊이 숨을 들이쉬고 왕에게 한 걸음 다가갔다."},"171:1":{"lh":"3a25e23f","m":0,"g":"a2191fbdad766d05db405e8fa6bf85a9bf6617b8dba65810a011c3f86b73e251","t":"……이번에 고서에 기록이 남아 있던 초대형 오아시스를 수색해 발견했습니다. 기존 오아시스의 몇 배……아니, 조사가 진행되면 수십 배 규모에 달할 것으로 보입니다."},"173:0":{"lh":"d78d919e","m":0,"g":"16dd71bf1bce4b3d1d94e9c5dc3959e212ac251e857b8d4a92465afd223f7861","t":"신하와 위병들이 조금 동요하는 기색을 보였다. 반신반의하는 작은 목소리가 궁전의 넓은 공간에 희미하게 울렸다."},"175:1":{"lh":"60786810","m":0,"g":"76faf4d59265006bfc23f5ecfcf8c44ad5a2024ab858d899928800605d6335ac","t":"그동안 전쟁이 일어난 건……백성이 불안 없이 살아갈 수 있도록 수원을 확보하기 위해서였을 터입니다."},"177:1":{"lh":"4b39cc41","m":0,"g":"8854cc0ce74ff430d8f607081c430d4482879579946d683a75ccf8c151e13f86","t":"이 오아시스가 있다면 전쟁을 벌일 필요가 없습니다. 우리나라뿐 아니라 모든 나라의 수원 역할을 할 수 있을 터입니다."},"179:0":{"lh":"a1fa5da5","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"181:0":{"lh":"56bde069","m":0,"g":"34745c3802b853eb6b8fb1343883e044eef016b03ff334f2cb0128435404088d","t":"왕은 입을 다문 채 눈을 감고 있다. 라일라의 말에 귀를 기울이는 듯 보이지만, 기가 막혀 하는 듯도 보인다."},"183:1":{"lh":"bf8bc9ac","m":0,"g":"cfc8c12ac8b264fafb9ef6d6e20cf0f92b7c423d4e60ba03a980f103fc5b4eb6","t":"더는 무고한 백성의 피를 흘리게 해서는 안 됩니다! ……즉각 모든 전쟁의 휴전을 요청합니다!"},"185:0":{"lh":"a1fa5da5","m":0,"g":"b5999fb8c439aedc310fc22e9b23faada72dc7422a48e55a6526491f7b19cc31","t":"…………"},"191:0":{"lh":"33808974","m":0,"g":"9cc02f354e57151d49d49a2665f84c70bda2bfc6a74ae46b89acdc8db18b72d4","t":"……헛소리는 거기까지냐."},"193:1":{"lh":"269d31cb","m":0,"g":"35e55e31db194b135bc7e736544d49ddbb7420c2f787c7915e50adc1485f4728","t":"네……?"},"199:0":{"lh":"b8a0caf2","m":0,"g":"464e5c4556f00beea567985712da8935233f5a3dd407f2a3578e3454a3e65fe4","t":"다음 전쟁은 사흘 뒤에 시작된다. 준비는 만전이다. 이제 와서 취소할 수도 없지."},"201:1":{"lh":"d9807eca","m":0,"g":"8027da5fb5c64efedc698455e2e86320891b077fb937257a93e4b0a1ed329d42","t":"하……하지만!"},"203:0":{"lh":"573894d1","m":0,"g":"f548d57ab67a19fa919c8b799968d60ef3f4bf49ae2250ea7149ad401f1fa78c","t":"확실히 그 오아시스의 존재와 규모가 사실이라면 백성과 다른 나라들도 휴전을 받아들일…… 가능성은 있다만."},"205:0":{"lh